  });
  Object.assign(STR.en, {
    'e.crossPipe': 'Pipe crossing is not a junction', 'x.crossPipe': 'Pipe crossing is not a junction: end the pipe ON the existing one to make a T-junction, or change its path',
    'e.ambiguous': 'The pipe end touches two networks at once', 'x.ambiguous': 'Move the pipe end so it touches only one network (or end it on the pipe you want)',
    'pv.tiles': '{n} segments', 'pv.t': 'New T-junction', 'pv.x': '4-way junction', 'pv.more': 'Extra branch', 'pv.toTank': 'to tank', 'pv.toWell': 'from well', 'pv.toPump': 'to pump', 'pv.toPipe': 'joins a pipe', 'pv.free': 'free end',
    'p.removeBranch': 'Remove branch', 'p.removeBranchN': 'Remove branch ({n} segments)', 'p.node': 'Node', 'nd.junction': 'Junction · {n} branches', 'nd.end': 'Pipe end', 'nd.seg': 'Pipe section · {n} segments', 'nd.seg0': 'Pipe section',
    'e.noRoute': 'No valid route found', 'x.noRoute': 'No valid route found: change the destination or remove what blocks the way', 'e.pumpSide': 'Cannot connect to this side of the pump', 'x.pumpSide': 'A pump connects only at its back and front (the two glowing spots)',
    'pv.turns': '{n} corners', 'pv.detour': 'detour around an obstacle',
    'e.junction': 'This is a junction: remove the branches around it', 't.removedBranch': 'Branch removed · {n} segments · +{refund}', 't.simplified': 'The junction became a plain pipe', 'log.removedBranch': 'Removed pipe branch ({n} segments)'
  });
  // t('key', {values}): translated text. In Arabic, numbers and prices are isolated so they never get reordered.
  function t(key, vars) {
    let s = STR[prefs.lang][key]; if (s == null) s = STR.en[key]; if (s == null) return key;
    if (vars) s = s.replace(/\{(\w+)\}/g, (m, k) => {
      if (vars[k] == null) return m;
      const v = String(vars[k]);
      return prefs.lang === 'ar' && /[\d$]/.test(v) ? '⁦' + v + '⁩' : v;
    });
    return s;
  }
  const err = code => t('e.' + code);
  const help = code => { const k = 'x.' + code, v = t(k); return v === k ? err(code) : v; };   // says what to DO, not just what failed
  // toolbar / HUD icons: the supplied pictures replace the line icons (a symbol can hold an <image>)
  function applyArt() {
    if (!window.ART || !ART.spr) return;
    const map = { 'i-cash': 'i_coin', 'i-drop': 'i_oil', 'i-build': 'i_wrench', 'i-search': 'i_lens', 'i-well': 'wellS2', 'i-tank': 'tank1', 'i-pipe': 'pipeX' };
    for (const id in map) {
      const sy = document.getElementById(id), a = ART.spr[map[id]]; if (!sy || !a) continue;
      sy.innerHTML = '<image href="' + a.src + '" x="0" y="0" width="24" height="24" preserveAspectRatio="xMidYMid meet"/>';
      sy.dataset.art = '1';
    }
    if (ART.pump) { const sy = document.getElementById('i-pump'); if (sy) { sy.innerHTML = '<image href="' + ART.pump.x + '" x="0" y="0" width="24" height="24" preserveAspectRatio="xMidYMid meet"/>'; sy.dataset.art = '1'; } }
  }
  function applyI18n() {
    document.documentElement.lang = prefs.lang;
    $('#app').classList.toggle('rtl', prefs.lang === 'ar');
    $$('[data-i18n]').forEach(el => { el.textContent = t(el.dataset.i18n); });
    $$('[data-i18n-label]').forEach(el => { el.setAttribute('aria-label', t(el.dataset.i18nLabel)); });
    $$('[data-cost]').forEach(el => { const k = el.dataset.cost; el.textContent = k === 'explore' ? t('from', { c: money(CFG.REGIONS[0].explore) }) : k === 'well' ? t('from', { c: money(CFG.WELL_KINDS.small.cost) }) : money(CFG.COST[k]) + (k === 'pipe' ? ' ' + t('perTile') : ''); });
    $$('#kinds button').forEach(el => { const k = el.dataset.k; el.innerHTML = t('k.' + k) + '<small>' + money(CFG.WELL_KINDS[k].cost) + '</small>'; });
    const pb = $('[data-tool="pump"]'); if (pb) pb.title = t('n.pump') + ' · ' + t('d.pump');
    $('#st-reset-note').textContent = t('s.resetNote', { cash: money(CFG.START_CASH) });
  }

  const game = new Game();
  const ui = { tab: 'trade', wellKind: 'small', menu: false, tool: 'select', hover: null, pipeStart: null, pending: null, flip: false, sel: null, speed: 1, ptype: 'mouse', erase: null, removeArm: 0, reset: 0 };
  /* The one camera. x/y = the world point at the centre of the canvas, z = zoom (screen px per world px). Limits are configured here only:
     MIN_Z / MAX_Z bound the zoom, EDGE is how far past the world's outline the view may poke (a sliver of sea, never a screenful). */
  const CAM = { MIN_Z: 0.28, MAX_Z: 2, EDGE: 48, START_Z: [0.6, 1.15] };
  const cam = { x: 0, y: 0, z: 0.8, minZoom: CAM.MIN_Z, maxZoom: CAM.MAX_Z };

  /* ================= Save / load ================= */
  function save() {
    try { localStorage.setItem(SAVE_KEY, JSON.stringify({ game: game.serialize(), cam, speed: ui.speed })); } catch (e) { /* storage may be unavailable */ }
  }
  let loaded = false;
  try {
    const raw = localStorage.getItem(SAVE_KEY);
    if (raw) {
      const d = JSON.parse(raw);
      game.load(d.game);
      if (d.cam) { const legacy = !d.game || d.game.w !== 2; cam.x = d.cam.x + (legacy ? (CFG.WORLD.OX - CFG.WORLD.OY) * 32 : 0); cam.y = d.cam.y + (legacy ? (CFG.WORLD.OX + CFG.WORLD.OY) * 16 : 0); cam.z = d.cam.z; }
      if (typeof d.speed === 'number') ui.speed = d.speed;
      loaded = true;
    }
  } catch (e) { game.reset(); }

  /* ================= Terrain (pre-rendered once) ================= */
  function hash(x, y) {
    let h = Math.imul(x, 374761393) ^ Math.imul(y, 668265263) ^ 0x5bd1e995;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  }
  function vnoise(x, y) {
    const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
    const s = t => t * t * (3 - 2 * t);
    const a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
    return a + (b - a) * s(xf) + (c - a) * s(yf) + (a - b - c + d) * s(xf) * s(yf);
  }
  const mix = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
  const rgb = c => 'rgb(' + (c[0] | 0) + ',' + (c[1] | 0) + ',' + (c[2] | 0) + ')';

  /* The ground is drawn in chunks of CH x CH tiles, created only when they come into view and kept in a small cache
     (the world is 10x bigger: one huge pre-rendered image would not fit in phone memory). A tiny overview image of the whole world is the minimap
     and the placeholder shown for a chunk that has not been drawn yet. */
  const CH = 16, CWN = Math.ceil(W / CH), CHN = Math.ceil(H / CH);
  const OXY = CFG.WORLD, LX = x => x - OXY.OX, LY = y => y - OXY.OY;      // noise is sampled in old-map coordinates so the old ground looks exactly as before
  const TERR = { minX: -H * 32 - 40, minY: -12, w: (W + H) * 32 + 80, h: (W + H) * 16 + 64, mini: null, miniRes: 1 / 16, cache: new Map(), bytes: 0, budget: 56e6 };
  const SAND_A = [236, 200, 134], SAND_B = [208, 160, 86], ROCKY = [186, 140, 96], BEACH = [243, 223, 170];
  function groundColor(x, y, detail) {
    const k = idx(x, y), lx = LX(x), ly = LY(y), co = game.map.coast[k];
    if (game.map.water[k]) {
      const depth = clamp(co / 3, 0, 1);
      return mix(mix([60, 190, 205], [22, 112, 160], depth), [30, 130, 175], detail ? vnoise(lx * .5, ly * .5) * .5 : .25);
    }
    const n = detail ? vnoise(lx * .1, ly * .1) * .65 + vnoise(lx * .45, ly * .45) * .25 + hash(lx, ly) * .1 : vnoise(lx * .1, ly * .1);
    let col = mix(SAND_A, SAND_B, n);
    if (co > -1.6) col = mix(col, BEACH, .7);
    const r = OliCore.rockyAt(x, y); if (r > 0) col = mix(col, ROCKY, r);
    return col;
  }
  function buildMini() {
    const res = TERR.miniRes, cv = document.createElement('canvas');
    cv.width = Math.ceil(TERR.w * res); cv.height = Math.ceil(TERR.h * res);
    const g = cv.getContext('2d'); g.scale(res, res); g.translate(-TERR.minX, -TERR.minY);
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
      const cx = (x - y) * 32, top = (x + y) * 16;
      g.fillStyle = rgb(groundColor(x, y, false));
      g.beginPath(); g.moveTo(cx, top); g.lineTo(cx + 33, top + 16); g.lineTo(cx, top + 33); g.lineTo(cx - 33, top + 16); g.closePath(); g.fill();
    }
    TERR.mini = cv;
  }
  function chunkBox(cx, cy) {
    const x0 = cx * CH, y0 = cy * CH, x1 = Math.min(W, x0 + CH) - 1, y1 = Math.min(H, y0 + CH) - 1;
    const minX = (x0 - y1) * 32 - 34, maxX = (x1 - y0) * 32 + 34, minY = (x0 + y0) * 16 - 2, maxY = (x1 + y1) * 16 + 32 + 22;
    return { x0, y0, x1, y1, minX, minY, w: maxX - minX, h: maxY - minY };
  }
  function buildChunk(cx, cy, res) {
    const B = chunkBox(cx, cy), cv = document.createElement('canvas');
    cv.width = Math.ceil(B.w * res); cv.height = Math.ceil(B.h * res);
    const g = cv.getContext('2d'); g.scale(res, res); g.translate(-B.minX, -B.minY);
    const path = (x, y) => { const px = (x - y) * 32, top = (x + y) * 16; g.beginPath(); g.moveTo(px, top); g.lineTo(px + 32, top + 16); g.lineTo(px, top + 32); g.lineTo(px - 32, top + 16); g.closePath(); };
    const fine = res >= .9, sandI = sprImg('sand'), shoreI = sprImg('shore'), tex = !!(sandI && shoreI) && fine;
    const tile = (g, im, px, top, fx, fy) => {          // one tile-sized picture, optionally mirrored (the 4 mirrors give the 4 shoreline directions)
      g.drawImage(im, fx ? px + 32.5 : px - 32.5, fy ? top + 32.5 : top - .5, fx ? -65 : 65, fy ? -33 : 33);      // a negative size mirrors the picture
    };
    cv.tex = tex;
    for (let s = B.x0 + B.y0; s <= B.x1 + B.y1; s++) {
      for (let y = B.y0; y <= B.y1; y++) {
        const x = s - y; if (x < B.x0 || x > B.x1) continue;
        const k = idx(x, y), water = game.map.water[k], lx = LX(x), ly = LY(y);
        path(x, y); g.fillStyle = rgb(groundColor(x, y, true)); g.fill();
        if (!fine) continue;
        if (tex) {                                     // supplied art: sand grain on land, a foaming shoreline where water meets land
          const px0 = (x - y) * 32, top0 = (x + y) * 16, hv = hash(lx * 3 + 1, ly * 5 + 2);
          if (!water) { g.globalAlpha = .5; tile(g, sandI, px0, top0, hv > .5, hv * 7 % 1 > .5); g.globalAlpha = 1; }
          else {
            const lands = [[-1, 0], [0, -1], [0, 1], [1, 0]].filter(d => inb(x + d[0], y + d[1]) && !game.map.water[idx(x + d[0], y + d[1])]);
            if (lands.length === 1) { const d = lands[0]; tile(g, shoreI, px0, top0, d[0] === 0 ? d[1] < 0 : d[0] > 0, d[1] > 0 || d[0] > 0); }
          }
        }
        g.strokeStyle = water ? 'rgba(255,255,255,.06)' : 'rgba(120,80,30,.045)'; g.lineWidth = 1; g.stroke();
        const px = (x - y) * 32, py = (x + y) * 16 + 16;
        if (water) {
          g.strokeStyle = 'rgba(255,255,255,.22)'; g.lineWidth = 1.2;
          if (hash(lx, ly) > .55) { const ox = (hash(ly, lx) - .5) * 24; g.beginPath(); g.moveTo(px + ox - 8, py); g.quadraticCurveTo(px + ox, py - 3, px + ox + 8, py); g.stroke(); }
        } else {
          for (let i = 0; i < 3; i++) {
            const qx = px + (hash(lx * 7 + i, ly * 3) - .5) * 40, qy = py + (hash(lx * 3, ly * 7 + i) - .5) * 18;
            g.fillStyle = hash(lx + i, ly * 5) > .5 ? 'rgba(255,240,200,.35)' : 'rgba(150,100,40,.25)';
            g.fillRect(qx, qy, 2, 1.4);
          }
        }
      }
    }
    if (B.y1 === H - 1) for (let x = B.x0; x <= B.x1; x++) {        // front-left cliff of the world edge
      const y = H - 1, px = (x - y) * 32, top = (x + y) * 16;
      g.fillStyle = game.map.water[idx(x, y)] ? '#0b6a8f' : '#a8743c';
      g.beginPath(); g.moveTo(px - 32, top + 16); g.lineTo(px, top + 32); g.lineTo(px, top + 48); g.lineTo(px - 32, top + 32); g.closePath(); g.fill();
    }
    if (B.x1 === W - 1) for (let y = B.y0; y <= B.y1; y++) {        // front-right cliff
      const x = W - 1, px = (x - y) * 32, top = (x + y) * 16;
      g.fillStyle = '#8a5a2c';
      g.beginPath(); g.moveTo(px, top + 32); g.lineTo(px + 32, top + 16); g.lineTo(px + 32, top + 32); g.lineTo(px, top + 48); g.closePath(); g.fill();
    }
    return { cv, B, res, tex, bytes: cv.width * cv.height * 4 };
  }
  // Draws the ground inside the current view. At most `maxBuild` new chunks are drawn per frame, the rest show the overview until ready.
  function drawGround(x0, y0, x1, y1, tier, maxBuild) {
    const res = tier ? .5 : TERR_RES, todo = [], missing = [];
    for (let cy = 0; cy < CHN; cy++) for (let cx = 0; cx < CWN; cx++) {
      const B = chunkBox(cx, cy);
      if (B.minX > x1 || B.minX + B.w < x0 || B.minY > y1 || B.minY + B.h < y0) continue;
      const key = cx + ',' + cy + ',' + tier; let c = TERR.cache.get(key);
      if (c && !c.tex && !tier && sprImg('sand') && sprImg('shore') && c.res >= .9) { TERR.bytes -= c.bytes; TERR.cache.delete(key); c = null; }   // built before the art was ready
      if (c) { TERR.cache.delete(key); TERR.cache.set(key, c); todo.push(c); continue; }
      if (todo.length + missing.length >= 40) continue;
      missing.push([cx, cy, key, B]);
    }
    let built = 0;
    for (const m of missing) {                      // a few new chunks per frame; the overview shows through until they exist
      if (built >= maxBuild) break;
      const c = buildChunk(m[0], m[1], res); built++; TERR.cache.set(m[2], c); TERR.bytes += c.bytes; todo.push(c);
      while (TERR.bytes > TERR.budget && TERR.cache.size > 1) { const k0 = TERR.cache.keys().next().value; if (k0 === m[2]) break; TERR.bytes -= TERR.cache.get(k0).bytes; TERR.cache.delete(k0); }
    }
    ctx.imageSmoothingQuality = 'low';
    if (missing.length > built) ctx.drawImage(TERR.mini, TERR.minX, TERR.minY, TERR.w, TERR.h);      // only while some chunk is still missing
    for (const c of todo) ctx.drawImage(c.cv, c.B.minX, c.B.minY, c.B.w, c.B.h);
    ctx.imageSmoothingQuality = 'high';
    return built;
  }
  let TERR_RES = 1;
  function buildTerrain() { TERR_RES = Math.min(innerWidth, innerHeight) < 600 ? 1 : 1.5; buildMini(); }

  /* ================= Canvas / camera ================= */
  const cv = $('#view'), ctx = cv.getContext('2d');
  const mini = $('#mini'), mctx = mini.getContext('2d');
  let vw = 0, vh = 0, dpr = 1, dprCap = 2, bgGrad = null;   // dprCap drops automatically on slow devices
  function resize() {
    dpr = Math.min(dprCap, window.devicePixelRatio || 1);
    const r = cv.getBoundingClientRect(); vw = r.width; vh = r.height;
    cv.width = Math.round(vw * dpr); cv.height = Math.round(vh * dpr);
    bgGrad = ctx.createLinearGradient(0, 0, 0, cv.height);
    bgGrad.addColorStop(0, '#12749a'); bgGrad.addColorStop(1, '#093756');
    const mr = mini.getBoundingClientRect();
    mini.width = Math.round(mr.width * dpr); mini.height = Math.round(mr.height * dpr);
    drawChart();
  }
  /* Bounds are computed from world size + viewport size + zoom, never hard-coded for one zoom level.
     The world is a diamond in screen space; its bounding box is BOX. The view centre stays inside the diamond, and the whole view stays
     inside BOX (+EDGE): when the view is bigger than the box on an axis it is centred on that axis instead. */
  const BOX = { minX: -H * 32, maxX: W * 32, minY: 0, maxY: (W + H) * 16 };
  function zoomLimits() {
    const fit = Math.max(vw / (BOX.maxX - BOX.minX + 2 * CAM.EDGE), vh / (BOX.maxY - BOX.minY + 2 * CAM.EDGE));   // never zoom out past the point where the world no longer fills the view
    return [Math.min(Math.max(CAM.MIN_Z, fit), CAM.MAX_Z), CAM.MAX_Z];
  }
  function fitView(x, y, z) {                                     // pure: the nearest legal camera for (x, y, z)
    const [zmin, zmax] = zoomLimits(); z = clamp(z, zmin, zmax);
    const u = clamp((x / 32 + y / 16) / 2, 0, W), v = clamp((y / 16 - x / 32) / 2, 0, H); x = (u - v) * 32; y = (u + v) * 16;
    const hw = vw / 2 / z, hh = vh / 2 / z, lx = BOX.minX + hw - CAM.EDGE, hx = BOX.maxX - hw + CAM.EDGE, ly = BOX.minY + hh - CAM.EDGE, hy = BOX.maxY - hh + CAM.EDGE;
    x = lx > hx ? (BOX.minX + BOX.maxX) / 2 : clamp(x, lx, hx); y = ly > hy ? (BOX.minY + BOX.maxY) / 2 : clamp(y, ly, hy);
    return { x, y, z };
  }
  function clampCam() {
    if (!vw || !vh) return;
    const f = fitView(cam.x, cam.y, cam.z); cam.x = f.x; cam.y = f.y; cam.z = f.z;
    const zl = zoomLimits(); cam.minZoom = zl[0]; cam.maxZoom = zl[1];
  }
  /* THE grid <-> world mapping (buildings, preview, terrain, pipes, picking, camera and touch all go through it).
     Grid corner coordinates (u, v): cell (x, y) spans u in [x, x+1] and v in [y, y+1]; world = ((u - v) * HW, (u + v) * HH). */
  const GRID = { HW: 32, HH: 16 };
  const gridToWorld = (u, v) => [(u - v) * GRID.HW, (u + v) * GRID.HH];
  const worldToGrid = (wx, wy) => [(wx / GRID.HW + wy / GRID.HH) / 2, (wy / GRID.HH - wx / GRID.HW) / 2];
  const s2w = (sx, sy) => ({ x: (sx - vw / 2) / cam.z + cam.x, y: (sy - vh / 2) / cam.z + cam.y });
  const w2s = (wx, wy) => ({ x: (wx - cam.x) * cam.z + vw / 2, y: (wy - cam.y) * cam.z + vh / 2 });
  function cellAt(sx, sy) {
    const w = s2w(sx, sy), g = worldToGrid(w.x, w.y);
    return { x: Math.floor(g[0]), y: Math.floor(g[1]) };
  }
  const inb = (x, y) => x >= 0 && y >= 0 && x < W && y < H;
  const cc = (x, y) => gridToWorld(x + .5, y + .5);          // world centre of tile (x, y)
  const footprintCenter = (type, x, y) => { const f = game.footprintOf(type); return gridToWorld(x + f[0] / 2, y + f[1] / 2); };   // world centre of a building's whole footprint

  /* ================= Drawing helpers ================= */
  const DIRS = [[1, 0, 32, 16], [-1, 0, -32, -16], [0, 1, -32, 16], [0, -1, 32, -16]]; // dx, dy, screen vector
  function diamond(g, cx, cy, rx, ry) { g.beginPath(); g.moveTo(cx, cy - ry); g.lineTo(cx + rx, cy); g.lineTo(cx, cy + ry); g.lineTo(cx - rx, cy); g.closePath(); }
  function shade(g, cx, cy, rx, ry, a) { g.fillStyle = 'rgba(60,30,0,' + a + ')'; g.beginPath(); g.ellipse(cx + 6, cy + 3, rx, ry, 0, 0, 6.2832); g.fill(); }

  /* ---- Supplied sprites (art.js): decoded once; every draw falls back to the old vector art until the image is ready ---- */
  const SPR = {};
  function sprImg(k) { let i = SPR[k]; if (!i && window.ART && ART.spr && ART.spr[k]) { i = SPR[k] = new Image(); i.src = ART.spr[k].src; } return i && i.complete && i.naturalWidth ? i : null; }
  if (window.ART && ART.spr) for (const k in ART.spr) sprImg(k);
  // draws sprite k with width dw; (ax, ay) is the point of the sprite (as a fraction of its size) that lands on (cx, cy)
  function sprite(g, k, cx, cy, dw, ax, ay, flip) {
    const i = sprImg(k); if (!i) return false;
    const dh = dw * i.naturalHeight / i.naturalWidth;
    if (flip) { g.save(); g.translate(cx, cy); g.scale(-1, 1); g.drawImage(i, -ax * dw, -ay * dh, dw, dh); g.restore(); }
    else g.drawImage(i, cx - ax * dw, cy - ay * dh, dw, dh);
    return true;
  }
  function drawPalm(g, cx, cy, v, t) {
    const sway = Math.sin(t * 1.3 + v * 20) * .018;
    g.save(); g.translate(cx, cy + 6); g.transform(1, 0, sway, 1, 0, 0);
    const ok = sprite(g, 'palm', 0, 0, 78 + v * 12, .5, .86, v > .5);
    g.restore();
    if (ok) return;
    shade(g, cx, cy, 16, 7, .18);
    const lean = (v - .5) * 16, sw = sway * 120;
    const tx = cx + lean + sw * .3, ty = cy - 38;
    g.strokeStyle = '#7b5632'; g.lineWidth = 4.2; g.lineCap = 'round';
    g.beginPath(); g.moveTo(cx, cy); g.quadraticCurveTo(cx + lean * .2, cy - 20, tx, ty); g.stroke();
    for (let i = 0; i < 7; i++) {
      const a = i / 7 * 6.2832 + v * 3, lx = Math.cos(a) * 24, ly = Math.sin(a) * 9;
      g.fillStyle = i % 2 ? '#2d8a4b' : '#3ea25d';
      g.beginPath(); g.moveTo(tx, ty);
      g.quadraticCurveTo(tx + lx * .55 + sw, ty - 13 + ly * .3, tx + lx + sw, ty + 7 + ly * .7);
      g.quadraticCurveTo(tx + lx * .5, ty - 3 + ly * .2, tx, ty); g.fill();
    }
    g.fillStyle = '#6b4a2a'; g.beginPath(); g.arc(tx - 2, ty + 2, 2.4, 0, 6.2832); g.arc(tx + 3, ty + 3, 2.4, 0, 6.2832); g.fill();
  }
  function drawRock(g, cx, cy, s, v) {
    if (sprite(g, 'rocks', cx, cy + 4, s * 3.9, .5, .72, v > .5)) return;
    shade(g, cx, cy, s * 1.1, s * .5, .2);
    const p = [[-.95, 0], [-.75, -.7], [-.2, -1.1], [.5, -.95], [.95, -.2], [.7, .1], [-.3, .25]].map(q => [cx + q[0] * s * (0.9 + v * .25), cy + q[1] * s * .9]);
    const gr = g.createLinearGradient(cx - s, cy - s, cx + s, cy);
    gr.addColorStop(0, '#c9a47a'); gr.addColorStop(1, '#8e6a48');
    g.fillStyle = gr; g.beginPath(); p.forEach((q, i) => i ? g.lineTo(q[0], q[1]) : g.moveTo(q[0], q[1])); g.closePath(); g.fill();
    g.fillStyle = 'rgba(70,40,15,.28)'; g.beginPath(); g.moveTo(p[2][0], p[2][1]); g.lineTo(p[3][0], p[3][1]); g.lineTo(p[4][0], p[4][1]); g.lineTo(p[5][0], p[5][1]); g.lineTo(p[6][0], p[6][1]); g.closePath(); g.fill();
    g.strokeStyle = 'rgba(60,35,15,.35)'; g.lineWidth = 1; g.stroke();
  }
  function drawShrub(g, cx, cy, v) {
    g.fillStyle = '#7f9a4a';
    for (let i = 0; i < 4; i++) { g.beginPath(); g.ellipse(cx + (i - 1.5) * 4, cy - 3 - (i % 2) * 2, 5, 4, 0, 0, 6.2832); g.fill(); }
    g.fillStyle = '#a3b866'; g.beginPath(); g.ellipse(cx - 2, cy - 6, 3, 2, 0, 0, 6.2832); g.fill();
  }


  /* ================= Animation state =================
     Everything that moves is driven by the real simulation: pump speed by a well's output, pipe flow by the
     network's output, tank level by the stored oil. Nothing here changes the game rules. */
  const anim = { wells: new Map(), tanks: new Map(), born: new Map(), cons: new Map(), dust: new Map(), fx: [], seenPipe: new Uint8Array(W * H), pr: new Float32Array(W * H), pph: new Float32Array(W * H), seenB: new Set(), primed: false };
  const BUILD_T = .55;                                         // seconds a new object takes to appear
  const easeBack = p => { const c1 = 1.9; return 1 + (c1 + 1) * Math.pow(p - 1, 3) + c1 * Math.pow(p - 1, 2); };
  function wellAnim(b) { let a = anim.wells.get(b.id); if (!a) { a = { ph: b.id * 1.7, spd: 0, amp: 0 }; anim.wells.set(b.id, a); } return a; }
  function tankAnim(b) { let a = anim.tanks.get(b.id); if (!a) { a = { f: clamp(b.amt / game.tankCap(b), 0, 1), w: b.id * 2.3, full: 0, t: 0, was: false }; anim.tanks.set(b.id, a); } return a; }
  function spawnFx(x, y, kind, delay) { anim.fx.push({ x, y, kind, t0: tNow + (delay || 0) }); if (anim.fx.length > 40) anim.fx.shift(); }

  // Called once per frame. real = wall-clock seconds, ad = animation seconds (0 while the game is paused).
  function updateAnim(real, ad) {
    // new objects -> construction animation (the first call only records what already exists, e.g. after loading a save)
    let n = 0;
    for (let k = 0; k < game.pipe.length; k++) {
      const has = game.pipe[k];
      if (has && !anim.seenPipe[k]) {
        anim.seenPipe[k] = 1;
        if (anim.primed) { const d = Math.max(0, (game.pipeReady[k] - game.s.time) / Math.max(.5, ui.speed)); anim.born.set('p' + k, tNow + d); spawnFx(k % W, (k / W) | 0, 'pipe', d); n++; }
      } else if (!has && anim.seenPipe[k]) { anim.seenPipe[k] = 0; anim.born.delete('p' + k); anim.pr[k] = 0; }
      // oil particles: speed and density follow the REAL flow in this tile (flow / capacity), smoothed; the simulation decides, the animation only shows it
      if (has) {
        const lvl = Math.max(1, game.pipeLvl[k]), target = game.net.live[k] === 1 ? clamp((game.net.flowK[k] || 0) / (CFG.PIPE.CAP[lvl - 1] * (game.valve[k] ? Math.max(.05, game.valvePos[k]) : 1)), 0, 1) : 0;
        let r = anim.pr[k]; r += (target - r) * Math.min(1, real * 3); if (r < .004 && target === 0) r = 0; anim.pr[k] = r;
        if (r > 0) anim.pph[k] = (anim.pph[k] + (.22 + 1.05 * r) * CFG.PIPE.SPEED[lvl - 1] * ad) % 1;
      }
    }
    const live = new Set();
    for (const b of game.buildings) {
      live.add(b.id);
      const building = b.ready > game.s.time;
      if (!anim.seenB.has(b.id)) { anim.seenB.add(b.id); if (building) anim.cons.set(b.id, tNow); if (anim.primed) { if (!building) anim.born.set('b' + b.id, tNow); spawnFx(b.x, b.y, b.type); } }
      else if (building) { anim.cons.set(b.id, anim.cons.get(b.id) || tNow); const last = anim.dust.get(b.id) || 0; if (tNow - last > .9) { anim.dust.set(b.id, tNow); spawnFx(b.x, b.y, 'pipe'); } }
      else if (anim.cons.has(b.id)) { anim.cons.delete(b.id); anim.dust.delete(b.id); anim.born.set('b' + b.id, tNow); spawnFx(b.x, b.y, b.type === 'tank' ? 'sale' : 'repair'); }
    }
    for (const id of anim.seenB) if (!live.has(id)) { anim.seenB.delete(id); anim.born.delete('b' + id); anim.wells.delete(id); anim.tanks.delete(id); anim.cons.delete(id); anim.dust.delete(id); }
    anim.primed = true;
    for (const [key, t0] of anim.born) if (tNow - t0 > BUILD_T + .1) anim.born.delete(key);   // never keep entries for objects that were off screen
    for (let i = anim.fx.length - 1; i >= 0; i--) if (tNow - anim.fx[i].t0 > .95) anim.fx.splice(i, 1);

    // pump jacks: speed follows the well's real output (bbl/min); smooth start and stop
    for (const b of game.buildings) {
      if (b.type === 'well') {
        const a = wellAnim(b), out = b.out || 0;
        const target = out > .01 ? 1.5 + 2.1 * clamp(out / 40, 0, 1) : 0;          // rad/s
        a.spd += (target - a.spd) * Math.min(1, real * 2.5);
        if (a.spd < .01 && target === 0) a.spd = 0;
        a.ph += a.spd * ad;
        a.amp = clamp(a.spd / 1.5, 0, 1);
      } else if (b.type === 'tank') {
        const a = tankAnim(b), f = clamp(b.amt / game.tankCap(b), 0, 1);
        a.f += (f - a.f) * Math.min(1, real * 3);                                    // level eases to the real inventory
        if (Math.abs(f - a.f) < .0006) a.f = f;
        a.w += ad * 2.4; a.t += real;
        a.full += ((f >= .985 ? 1 : 0) - a.full) * Math.min(1, real * 6);
        if (f >= .995 && !a.was) { a.was = true; if (anim.primed) toast(t('t.tankFull'), 'info'); }
        else if (f < .9) a.was = false;
      }
    }
    // pipe networks: particle speed follows the oil actually produced into that network
    for (const comp of game.net.comps) {
      let rate = 0; for (const w of comp.wells) rate += w.out || 0;
      const target = comp.flow > 0 && rate > 0 ? (.35 + .9 * Math.min(1, rate / Math.max(1, comp.cap))) * (comp.speed || 1) * (1 - .3 * Math.min(1, comp.leaks || 0)) : 0;
      comp.spd = (comp.spd || 0) + (target - (comp.spd || 0)) * Math.min(1, real * 3);
      if (comp.spd < .01 && target === 0) comp.spd = 0;
      comp.ph = (comp.ph || 0) + comp.spd * ad;
    }
  }

  // A building that is still being built: rises out of the ground with a growing opacity and a real progress bar (game.buildProgress).
  function underConstruction(b, cx, cy, fn) {
    return g => {
      const p = game.buildProgress(b), e = easeBack(Math.min(1, p));
      g.save(); g.translate(cx, cy); g.scale(.86 + .14 * Math.min(1, e), Math.max(.2, .35 + .65 * p)); g.translate(-cx, -cy); g.globalAlpha = .38 + .5 * p; fn(g); g.restore();
      const big = b.type === 'tank', bx = cx, by = cy - (big ? 70 : 78);
      g.fillStyle = 'rgba(10,20,32,.85)'; g.beginPath(); g.roundRect(bx - 28, by - 5, 56, 10, 5); g.fill();
      g.fillStyle = '#ffb41f'; g.beginPath(); g.roundRect(bx - 26, by - 3, 52 * p, 6, 3); g.fill();
      g.strokeStyle = 'rgba(255,180,31,.8)'; g.setLineDash([6, 5]); g.lineWidth = 2; g.beginPath(); g.ellipse(cx, cy + 4, big ? 60 : 36, big ? 30 : 17, 0, 0, 6.2832); g.stroke(); g.setLineDash([]);
    };
  }

  // Construction pop-in. Returns false (draw normally), 'hide' (waiting its turn) or true (a save() was pushed).
  function popBegin(g, key, cx, cy) {
    const t0 = anim.born.get(key); if (t0 === undefined) return false;
    const age = tNow - t0;
    if (age < 0) return 'hide';
    if (age >= BUILD_T) { anim.born.delete(key); return false; }
    const p = age / BUILD_T, e = easeBack(p);
    g.save(); g.translate(cx, cy); g.scale(.78 + .22 * e, Math.max(.03, e)); g.translate(-cx, -cy); g.globalAlpha = Math.min(1, p * 2.6);
    return true;
  }
  const popped = (key, cx, cy, fn) => g => { const s = popBegin(g, key, cx, cy); if (s === 'hide') return; fn(g); if (s) g.restore(); };

  // Dust ring + puffs where something was just built.
  function drawFx() {
    for (const f of anim.fx) {
      const age = tNow - f.t0; if (age < 0) continue;
      const disc = f.kind === 'discover', good = f.kind === 'repair' || f.kind === 'sale';
      const p = clamp(age / (disc ? 1.3 : .85), 0, 1), big = f.kind === 'tank' || f.kind === 'sale', pipe = f.kind === 'pipe' || f.kind === 'repair';
      const cx = (f.x - f.y) * 32, cy = big ? (f.x + f.y + 2) * 16 : (f.x + f.y) * 16 + 16;
      const rx = (disc ? 96 : big ? 62 : pipe ? 24 : 34) * (.35 + .65 * p), ry = rx / 2, rgb = disc ? '255,214,90' : good ? '70,220,130' : '255,196,60';
      if (disc || good) {                                        // sparks rising: a discovery / a sale / a repair should feel rewarding
        for (let i = 0; i < (disc ? 10 : 6); i++) {
          const a = i * 2.4 + f.x, rr = (disc ? 70 : 34) * Math.min(1, p * 1.4) * (.5 + (i % 3) * .25);
          ctx.fillStyle = 'rgba(' + rgb + ',' + (.9 * (1 - p)).toFixed(3) + ')'; ctx.beginPath(); ctx.arc(cx + Math.cos(a) * rr, cy - p * (disc ? 70 : 46) * (.6 + (i % 4) * .15) + Math.sin(a) * rr * .3, 3.2 * (1 - p * .6), 0, 6.2832); ctx.fill();
        }
      }
      ctx.strokeStyle = 'rgba(' + rgb + ',' + (.85 * (1 - p)).toFixed(3) + ')'; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.ellipse(cx, cy + 4, rx, ry, 0, 0, 6.2832); ctx.stroke();
      const n = disc || good ? 0 : pipe ? 4 : 8;
      for (let i = 0; i < n; i++) {
        const a = i / n * 6.2832 + .4, d = (big ? 52 : pipe ? 18 : 30) * Math.min(1, p * 1.6);
        ctx.fillStyle = 'rgba(214,178,122,' + (.5 * (1 - p)).toFixed(3) + ')';
        ctx.beginPath(); ctx.arc(cx + Math.cos(a) * d, cy + 4 + Math.sin(a) * d * .5 - p * 12, (pipe ? 3 : 5) + p * (pipe ? 4 : 8), 0, 6.2832); ctx.fill();
      }
    }
  }

  function drawPipe(g, x, y, k, t) {
    const [cx, cy0] = cc(x, y), cy = cy0 - 5, net = game.net, type = net.type;
    const nx = net.fnext[k], fk = net.flowK[k] || 0, ratio = anim.pr[k];
    const flowing = ratio > .015 && nx >= 0 && fk > .02, ga = flowing ? clamp(.35 + ratio * 1.2, .35, 1) : 0;
    const conn = [], vm = game.visualMask(k);                           // the SAME link rule the network graph and the solver use (core.visualMask)
    for (let d = 0; d < 4; d++) if ((vm >> d) & 1) conn.push(DIRS[d]);
    // supplied art: straight runs, the +x/+y elbow and valves are sprites; the other junctions keep the drawn pipe (same colours)
    const vs = game.valve[k], isX = conn.length === 2 && conn[0][1] === 0 && conn[1][1] === 0, isY = conn.length === 2 && conn[0][0] === 0 && conn[1][0] === 0;
    const isEl = conn.length === 2 && !isX && !isY && conn.some(d => d[0] === 1) && conn.some(d => d[1] === 1);
    let art = false;
    if (isX || isY) art = vs ? sprite(g, 'pipeTee', cx, cy0 + 8, 62, .5, .72, isY) : sprite(g, isX ? 'pipeX' : 'pipeY', cx, cy0 + 8, 60, .5, .64);
    else if (isEl) art = sprite(g, 'pipeElbow', cx, cy0 + 8, 62, .5, .62);
    if (art) {
      if (vs) { const c = vs === 1 ? '#2fd27a' : vs === 2 ? '#ffb41f' : '#ff5a4f'; g.fillStyle = c; g.strokeStyle = 'rgba(10,20,32,.9)'; g.lineWidth = 1.2; g.beginPath(); g.arc(cx + (isY ? 10 : -10), cy0 - 26, 3.4, 0, 6.2832); g.fill(); g.stroke(); }
    } else {
    g.fillStyle = 'rgba(60,30,0,.16)'; g.beginPath(); g.ellipse(cx + 3, cy0 + 1, 15, 7, 0, 0, 6.2832); g.fill();
    const seg = (w, col, oy) => {
      g.strokeStyle = col; g.lineWidth = w; g.lineCap = 'butt'; g.beginPath();
      for (const d of conn) { g.moveTo(cx, cy + oy); g.lineTo(cx + d[2] / 2, cy + d[3] / 2 + oy); }
      g.stroke();
    };
    seg(15, '#23282e', 0); seg(11, '#4b535c', 0);
    if (ga > 0) seg(6, 'rgba(255,160,20,' + (.5 * ga).toFixed(3) + ')', 0);   // oil visible inside a working pipe
    seg(3.2, '#8e98a3', -3.2);
    g.fillStyle = '#23282e'; g.beginPath(); g.arc(cx, cy, 8.4, 0, 6.2832); g.fill();
    g.fillStyle = '#5a636d'; g.beginPath(); g.arc(cx, cy, 6.2, 0, 6.2832); g.fill();
    g.fillStyle = '#9aa4ae'; g.beginPath(); g.arc(cx - 1.6, cy - 2, 2.2, 0, 6.2832); g.fill();
    g.strokeStyle = '#f5a30c'; g.lineWidth = 2.4; g.beginPath(); g.arc(cx, cy, 8.6, 0, 6.2832); g.stroke();
    if (conn.length >= 3) {                                               // a real junction node: a small red hand-wheel on the hub (same look as the supplied junction art)
      g.fillStyle = '#4b535c'; g.fillRect(cx - 1.2, cy - 11, 2.4, 8);
      g.strokeStyle = '#d6291d'; g.lineWidth = 2.6; g.beginPath(); g.ellipse(cx, cy - 11.5, 7.6, 3.5, 0, 0, 6.2832); g.stroke();
      g.strokeStyle = '#ff7e6e'; g.lineWidth = 1; g.beginPath(); g.ellipse(cx, cy - 12.2, 7.6, 3.5, 0, 3.5, 5.9); g.stroke();
      g.strokeStyle = '#a81d14'; g.lineWidth = 1.5; g.beginPath(); g.moveTo(cx - 7, cy - 11.5); g.lineTo(cx + 7, cy - 11.5); g.moveTo(cx, cy - 15); g.lineTo(cx, cy - 8); g.stroke();
      g.fillStyle = '#c8cfd6'; g.beginPath(); g.arc(cx, cy - 11.5, 1.6, 0, 6.2832); g.fill();
    }
    }
    // flow
    if (flowing) {
      const nxx = nx % W, nyy = (nx / W) | 0;
      const dn = DIRS.find(d => d[0] === nxx - x && d[1] === nyy - y);
      if (!dn) return;
      let sx = -dn[2] / 2, sy = -dn[3] / 2;
      for (const d of DIRS) {
        const px = x + d[0], py = y + d[1];
        if (inb(px, py) && (type[idx(px, py)] === 1 || type[idx(px, py)] === 4) && net.fnext[idx(px, py)] === k) { sx = d[2] / 2; sy = d[3] / 2; break; }
        if (inb(px, py) && type[idx(px, py)] === 2) { sx = d[2] / 2; sy = d[3] / 2; }
      }
      const np = ratio > .66 ? 3 : ratio > .3 ? 2 : 1;                  // denser oil when the pipe is fuller
      g.globalAlpha = ga;
      for (let j = 0; j < np; j++) {
        const f = (anim.pph[k] + j / np) % 1;
        let px, py;
        if (f < .5) { const u = f * 2; px = cx + sx * (1 - u); py = cy + sy * (1 - u); }
        else { const u = (f - .5) * 2; px = cx + dn[2] / 2 * u; py = cy + dn[3] / 2 * u; }
        g.fillStyle = 'rgba(255,170,30,.35)'; g.beginPath(); g.arc(px, py, 6.5, 0, 6.2832); g.fill();
        g.fillStyle = '#ffb41f'; g.beginPath(); g.arc(px, py, 4, 0, 6.2832); g.fill();
        g.fillStyle = '#fff1c4'; g.beginPath(); g.arc(px - .7, py - .8, 1, 0, 6.2832); g.fill();
      }
      g.globalAlpha = 1;
    }
  }


  /* ---- Pump station: the supplied artwork (drawn on the pipe line), a lamp for its state and an arrow for its direction ---- */
  const pumpImgs = {};
  function pumpImg(key) { if (!pumpImgs[key] && window.ART && ART.pump) { const i = new Image(); i.src = ART.pump[key]; pumpImgs[key] = i; } return pumpImgs[key]; }
  const LAMP = { running: '#2fd27a', maxed: '#ffb41f', standby: '#9fb3c8', idle: '#9fb3c8', offline: '#7a8794', noInput: '#ff5a4f', noOutput: '#ff5a4f', building: '#ffb41f' };
  function drawPump(g, b, t, ghost) {
    const [cx, cy] = cc(b.x, b.y), d = DIRS[b.dir || 0], A = window.ART && ART.pump, img = pumpImg((b.dir || 0) < 2 ? 'x' : 'y');
    g.fillStyle = 'rgba(60,30,0,.2)'; g.beginPath(); g.ellipse(cx + 2, cy + 3, 34, 15, 0, 0, 6.2832); g.fill();
    if (img && img.complete && img.naturalWidth && A) { const w = 112, h = w * A.h / A.w; g.drawImage(img, cx - w / 2, cy - h + 26, w, h); }
    else { g.fillStyle = '#7e8a97'; g.beginPath(); g.roundRect(cx - 22, cy - 26, 44, 34, 6); g.fill(); g.fillStyle = '#d9c9a0'; g.fillRect(cx - 30, cy - 6, 60, 8); }
    const st = ghost ? 'idle' : game.pumpNet(b).status, run = !ghost && b.spin > .05;
    // direction chevron on the ground in front of the pump (the oil leaves there)
    const fx = cx + d[2] * .72, fy = cy - 2 + d[3] * .72, ang = Math.atan2(d[3], d[2]), pulse = run ? .65 + .35 * Math.sin(t * 7) : .55;
    g.save(); g.translate(fx, fy); g.rotate(ang); g.globalAlpha = pulse * (ghost ? 1 : .95);
    g.fillStyle = run ? '#ffb41f' : '#cfd8e0'; g.strokeStyle = 'rgba(20,30,40,.9)'; g.lineWidth = 1.6;
    g.beginPath(); g.moveTo(8, 0); g.lineTo(-3, -6); g.lineTo(-1, 0); g.lineTo(-3, 6); g.closePath(); g.fill(); g.stroke(); g.restore();
    // status lamp
    if (!ghost) { g.fillStyle = 'rgba(10,20,32,.85)'; g.beginPath(); g.arc(cx + 18, cy - 40, 5.2, 0, 6.2832); g.fill(); g.fillStyle = LAMP[st] || '#9fb3c8'; g.beginPath(); g.arc(cx + 18, cy - 40, 3.4, 0, 6.2832); g.fill(); }
  }

  const WELL_SPR = { small: ['wellS', 96], medium: ['wellM', 108], large: ['wellL', 118] };
  function drawWell(g, b, t) {
    const sp = WELL_SPR[b.kind] || WELL_SPR.small, key = b.kind === 'small' && (b.id & 1) ? 'wellS2' : sp[0];
    if (sprImg(key)) {
      const [cx, cy] = cc(b.x, b.y), wa = wellAnim(b), dw = sp[1], im = sprImg(key), dh = dw * im.naturalHeight / im.naturalWidth;
      const gy = cy + 6;                                                 // ground centre of the platform
      shade(g, cx + 2, gy, dw * .4, dw * .18, .12);
      g.save(); g.translate(cx, gy);
      if (b.kind !== 'large' && wa.amp > .02) g.scale(1 + Math.sin(wa.ph) * .016 * wa.amp, 1 - Math.sin(wa.ph) * .014 * wa.amp);   // the pump-jack rocks with the real stroke
      g.drawImage(im, -dw / 2, -dh + dw * .2, dw, dh);
      g.restore();
      if (wa.amp > .05) {                                                // working glow at the platform edge
        const gl = .5 + .5 * Math.sin(wa.ph + 1.2);
        g.fillStyle = 'rgba(255,180,31,' + (.28 * gl * wa.amp).toFixed(3) + ')'; g.beginPath(); g.ellipse(cx + dw * .32, gy + 2, 10 + 4 * gl, 5 + 2 * gl, 0, 0, 6.2832); g.fill();
      }
      for (let i = 0; i < b.level; i++) { g.fillStyle = '#ffb41f'; g.fillRect(cx - 10 + i * 7, gy + dw * .2 + 2, 5, 4); g.strokeStyle = 'rgba(20,30,40,.7)'; g.lineWidth = .8; g.strokeRect(cx - 10 + i * 7, gy + dw * .2 + 2, 5, 4); }
      const led = wa.amp > .3 ? '#2fd27a' : b.status === 'full' ? '#ff5a4f' : '#ffb41f', lx = cx - dw * .34, ly = gy - dh * .42;
      g.fillStyle = 'rgba(10,20,32,.85)'; g.beginPath(); g.arc(lx, ly, 4.6, 0, 6.2832); g.fill();
      g.fillStyle = led; g.beginPath(); g.arc(lx, ly, 3, 0, 6.2832); g.fill();
      if (wa.amp > .3) { g.fillStyle = 'rgba(47,210,122,.3)'; g.beginPath(); g.arc(lx, ly, 7, 0, 6.2832); g.fill(); }
      return;
    }
    const [cx, cy] = cc(b.x, b.y), working = b.status === 'producing' || b.status === 'limited';
    const ks = b.kind === 'large' ? 1.38 : b.kind === 'medium' ? 1.28 : 1.2;
    g.save(); g.translate(cx, cy + 2); g.scale(ks, ks); g.translate(-cx, -(cy + 2));
    shade(g, cx + 4, cy + 4, 36, 15, .2);
    // slab
    g.fillStyle = '#4f545c'; g.beginPath(); g.moveTo(cx - 30, cy + 2); g.lineTo(cx, cy + 16); g.lineTo(cx, cy + 22); g.lineTo(cx - 30, cy + 8); g.closePath(); g.fill();
    g.fillStyle = '#3f434a'; g.beginPath(); g.moveTo(cx, cy + 16); g.lineTo(cx + 30, cy + 2); g.lineTo(cx + 30, cy + 8); g.lineTo(cx, cy + 22); g.closePath(); g.fill();
    diamond(g, cx, cy + 2, 30, 14); g.fillStyle = '#8b9099'; g.fill();
    diamond(g, cx, cy + 2, 22, 10); g.fillStyle = '#767b84'; g.fill();
    const px = cx - 6, py = cy - 46;
    const wa = wellAnim(b), th = .06 * (1 - wa.amp) + Math.sin(wa.ph) * .2 * wa.amp;
    const c = Math.cos(th), s = Math.sin(th);
    const hx = px + 33 * c, hy = py + 33 * s, tx = px - 27 * c, ty = py - 27 * s;
    // engine box
    g.fillStyle = '#35607f'; g.fillRect(cx - 40, cy - 12, 20, 14);
    g.fillStyle = '#4b7ea3'; g.fillRect(cx - 40, cy - 12, 20, 4);
    g.fillStyle = '#ffb41f'; g.fillRect(cx - 40, cy - 3, 20, 2.5);
    // wellhead + polished rod
    const wx = cx + 26, wy = cy + 1;
    g.fillStyle = '#2f343a'; g.fillRect(wx - 5, wy - 14, 10, 14);
    g.fillStyle = '#566069'; g.beginPath(); g.ellipse(wx, wy - 14, 5, 2.4, 0, 0, 6.2832); g.fill();
    g.strokeStyle = '#c9d2db'; g.lineWidth = 2; g.beginPath(); g.moveTo(hx - 2, hy + 14); g.lineTo(wx, wy - 15); g.stroke();
    // pitman arm + samson post
    g.strokeStyle = '#55606a'; g.lineWidth = 3; g.beginPath(); g.moveTo(tx + 3, ty + 12); g.lineTo(cx - 32, cy - 10); g.stroke();
    g.strokeStyle = '#2a2e34'; g.lineWidth = 5.5; g.lineCap = 'round';
    g.beginPath(); g.moveTo(cx - 20, cy + 3); g.lineTo(px, py); g.lineTo(cx + 8, cy + 5); g.stroke();
    g.lineWidth = 3; g.beginPath(); g.moveTo(cx - 12, cy - 17); g.lineTo(cx + 1, cy - 17); g.stroke();
    // walking beam
    g.strokeStyle = '#1f2327'; g.lineWidth = 8; g.beginPath(); g.moveTo(tx, ty); g.lineTo(hx, hy); g.stroke();
    g.strokeStyle = '#4a525b'; g.lineWidth = 2.4; g.beginPath(); g.moveTo(tx, ty - 2); g.lineTo(hx, hy - 2); g.stroke();
    // counterweight
    g.save(); g.translate(tx, ty); g.rotate(th); g.fillStyle = '#c4322a'; g.fillRect(-9, -2, 13, 19); g.fillStyle = '#e24b3f'; g.fillRect(-9, -2, 13, 4); g.restore();
    // horsehead
    g.save(); g.translate(hx, hy); g.rotate(th);
    g.fillStyle = '#d93a2b'; g.beginPath(); g.moveTo(-7, -9); g.quadraticCurveTo(13, -10, 15, 15); g.lineTo(5, 15); g.quadraticCurveTo(4, 0, -7, -3); g.closePath(); g.fill();
    g.strokeStyle = '#8f1f17'; g.lineWidth = 1.2; g.stroke(); g.restore();
    g.fillStyle = '#2a2e34'; g.beginPath(); g.arc(px, py, 4.4, 0, 6.2832); g.fill();
    g.fillStyle = '#9aa4ae'; g.beginPath(); g.arc(px, py, 1.8, 0, 6.2832); g.fill();
    // pumping effect: wellhead glow on the down-stroke and little oil drops that follow the stroke speed
    if (wa.amp > .05) {
      const gl = Math.max(0, Math.sin(wa.ph + 1.2)) * wa.amp, u = ((wa.ph / 6.2832) % 1 + 1) % 1;
      g.fillStyle = 'rgba(255,180,31,' + (.4 * gl).toFixed(3) + ')'; g.beginPath(); g.arc(wx, wy - 15, 4 + 4 * gl, 0, 6.2832); g.fill();
      for (let j = 0; j < 2; j++) {
        const f = (u + j * .5) % 1;
        g.fillStyle = 'rgba(255,196,60,' + (Math.sin(f * 3.1416) * .9 * wa.amp).toFixed(3) + ')';
        g.beginPath(); g.arc(wx + (f - .5) * 13, wy - 17 - 10 * Math.sin(f * 3.1416), 1.8, 0, 6.2832); g.fill();
      }
    }
    // level pips + status light
    for (let i = 0; i < b.level; i++) { g.fillStyle = '#ffb41f'; g.fillRect(cx - 12 + i * 6, cy + 12, 4, 4); }
    const led = wa.amp > .3 ? '#2fd27a' : b.status === 'full' ? '#ff5a4f' : '#ffb41f';
    g.fillStyle = led; g.beginPath(); g.arc(px, py - 9, 3.2, 0, 6.2832); g.fill();
    if (wa.amp > .3) { g.fillStyle = 'rgba(47,210,122,.3)'; g.beginPath(); g.arc(px, py - 9, 6, 0, 6.2832); g.fill(); }
    g.restore();
  }

  const TANK_SPR = [['tank1', 138], ['tank2', 154], ['tank3', 166]];
  const TANK_TOP = 1;
  function tankTopY(b) { const sp = TANK_SPR[clamp((b.level || 1) - 1, 0, 2)], im = sprImg(sp[0]); return im ? -(sp[1] * im.naturalHeight / im.naturalWidth) + sp[1] * .22 + 6 : -46 * 1.1 - 28; }   // roof height above the footprint centre
  function drawTank(g, b) {
    const sp = TANK_SPR[clamp((b.level || 1) - 1, 0, 2)], im = sprImg(sp[0]);
    if (im) {
      const cx = (b.x - b.y) * 32, cy = (b.x + b.y + 2) * 16, dw = sp[1], dh = dw * im.naturalHeight / im.naturalWidth, ta = tankAnim(b), frac = ta.f;
      const gy = cy + 5;
      shade(g, cx + 4, gy, dw * .42, dw * .19, .1);
      g.drawImage(im, cx - dw / 2, gy - dh + dw * .22, dw, dh);
      // sight glass on the tank wall: the oil level eases to the real inventory and the surface moves gently
      const gx = cx - dw * .2, gh = Math.min(64, dh * .34), gw = 11, gy0 = gy - dh * .62, ly = gy0 + gh - 1 - (gh - 2) * frac;
      g.fillStyle = 'rgba(20,28,40,.92)'; g.fillRect(gx, gy0, gw, gh);
      if (frac > .004) {
        g.save(); g.beginPath(); g.rect(gx + 1, gy0 + 1, gw - 2, gh - 2); g.clip();
        const calm = frac > .98 ? .35 : 1, col = frac > .95 ? '#ff5a4f' : frac > .75 ? '#ffb41f' : '#2fd27a';
        g.fillStyle = col; g.globalAlpha = .55; g.beginPath(); g.moveTo(gx + 1, gy0 + gh);
        for (let xx = 0; xx <= gw - 2; xx += 2) g.lineTo(gx + 1 + xx, ly - 1 + Math.sin(ta.w * .8 + xx * .7 + 2) * 1.1 * calm);
        g.lineTo(gx + gw - 1, gy0 + gh); g.closePath(); g.fill();
        g.globalAlpha = 1; g.beginPath(); g.moveTo(gx + 1, gy0 + gh);
        for (let xx = 0; xx <= gw - 2; xx += 2) g.lineTo(gx + 1 + xx, ly + Math.sin(ta.w + xx * .9) * 1.3 * calm);
        g.lineTo(gx + gw - 1, gy0 + gh); g.closePath(); g.fill();
        g.fillStyle = 'rgba(255,255,255,.28)'; g.fillRect(gx + 2, ly + 2, 2, Math.max(0, gy0 + gh - ly - 4));
        g.restore();
      }
      const blink = ta.full > .01 ? .5 + .5 * Math.sin(ta.t * 6) : 0;
      g.strokeStyle = ta.full > .01 ? 'rgba(255,90,79,' + (.5 + .5 * blink * ta.full).toFixed(3) + ')' : 'rgba(255,255,255,.55)'; g.lineWidth = 1; g.strokeRect(gx + .5, gy0 + .5, gw - 1, gh - 1);
      if (ta.full > .01) {                                              // tank full: pulsing red beacon on the roof
        const by = gy - dh + dw * .22 + 14;
        g.fillStyle = 'rgba(255,90,79,' + (.25 * blink * ta.full).toFixed(3) + ')'; g.beginPath(); g.arc(cx, by, 16, 0, 6.2832); g.fill();
        g.fillStyle = blink > .45 ? '#ff5a4f' : '#7a2620'; g.beginPath(); g.arc(cx, by, 4.2, 0, 6.2832); g.fill();
      }
      for (let i = 0; i < b.level; i++) { g.fillStyle = '#ffb41f'; g.fillRect(cx - 14 + i * 7, gy + dw * .22 + 1, 5, 4); g.strokeStyle = 'rgba(20,30,40,.7)'; g.lineWidth = .8; g.strokeRect(cx - 14 + i * 7, gy + dw * .22 + 1, 5, 4); }
      return;
    }
    const cx = (b.x - b.y) * 32, cy = (b.x + b.y + 2) * 16;   // centre of the 2x2 footprint
    const rx = 47, ry = 23.5, h = 46;
    const ta = tankAnim(b), frac = ta.f;
    g.save(); g.translate(cx, cy + 3); g.scale(1.1, 1.1); g.translate(-cx, -(cy + 3));
    shade(g, cx + 6, cy + 4, rx + 12, ry + 4, .2);
    // base ring
    g.fillStyle = '#6d727a'; g.beginPath(); g.ellipse(cx, cy + 3, rx + 5, ry + 2.5, 0, 0, 6.2832); g.fill();
    // body
    const gr = g.createLinearGradient(cx - rx, 0, cx + rx, 0);
    gr.addColorStop(0, '#f1eee4'); gr.addColorStop(.45, '#e0ddd2'); gr.addColorStop(1, '#9b9a90');
    g.beginPath(); g.moveTo(cx - rx, cy - h); g.lineTo(cx - rx, cy); g.ellipse(cx, cy, rx, ry, 0, Math.PI, 0, true); g.lineTo(cx + rx, cy - h); g.ellipse(cx, cy - h, rx, ry, 0, 0, Math.PI, false); g.closePath();
    g.fillStyle = gr; g.fill();
    g.strokeStyle = 'rgba(80,80,70,.35)'; g.lineWidth = 1; g.beginPath(); g.ellipse(cx, cy - h * .5, rx, ry, 0, 0.05, Math.PI - .05); g.stroke();
    // top
    g.fillStyle = '#f5f2e8'; g.beginPath(); g.ellipse(cx, cy - h, rx, ry, 0, 0, 6.2832); g.fill();
    g.fillStyle = '#d9d6ca'; g.beginPath(); g.ellipse(cx, cy - h - 2, rx * .78, ry * .78, 0, 0, 6.2832); g.fill();
    g.fillStyle = '#c4c1b5'; g.beginPath(); g.ellipse(cx, cy - h - 5, rx * .42, ry * .42, 0, 0, 6.2832); g.fill();
    g.strokeStyle = '#f2b705'; g.lineWidth = 3.2; g.beginPath(); g.ellipse(cx, cy - h, rx, ry, 0, 0, 6.2832); g.stroke();
    g.strokeStyle = 'rgba(242,183,5,.75)'; g.lineWidth = 1.4; g.beginPath(); g.ellipse(cx, cy - h + 6, rx, ry, 0, 0.1, Math.PI - .1); g.stroke();
    // ladder
    g.strokeStyle = '#4b5057'; g.lineWidth = 1.6;
    g.beginPath(); g.moveTo(cx + 30, cy + 15); g.lineTo(cx + 30, cy - h + 19); g.moveTo(cx + 36, cy + 12); g.lineTo(cx + 36, cy - h + 16); g.stroke();
    g.lineWidth = 1; g.beginPath(); for (let y = cy + 12; y > cy - h + 22; y -= 7) { g.moveTo(cx + 30, y + 2); g.lineTo(cx + 36, y - 1); } g.stroke();
    // emblem
    const ex = cx - 12, ey = cy - h * .45;
    g.fillStyle = '#1d2733'; g.beginPath(); g.moveTo(ex, ey - 11); g.bezierCurveTo(ex + 10, ey + 2, ex + 8, ey + 11, ex, ey + 11); g.bezierCurveTo(ex - 8, ey + 11, ex - 10, ey + 2, ex, ey - 11); g.fill();
    g.fillStyle = 'rgba(255,255,255,.35)'; g.beginPath(); g.ellipse(ex - 3, ey + 2, 1.6, 3.4, .3, 0, 6.2832); g.fill();
    // sight glass: the oil level eases to the real inventory and the surface moves gently
    const gx = cx + 14, gy0 = cy - h + 14, gh = 52, gw = 12, ly = gy0 + gh - 1 - (gh - 2) * frac;
    g.fillStyle = '#1b2430'; g.fillRect(gx, gy0, gw, gh);
    if (frac > .004) {
      g.save(); g.beginPath(); g.rect(gx + 1, gy0 + 1, gw - 2, gh - 2); g.clip();
      const calm = frac > .98 ? .35 : 1, col = frac > .95 ? '#ff5a4f' : frac > .75 ? '#ffb41f' : '#2fd27a';
      g.fillStyle = col; g.globalAlpha = .55; g.beginPath(); g.moveTo(gx + 1, gy0 + gh);
      for (let xx = 0; xx <= gw - 2; xx += 2) g.lineTo(gx + 1 + xx, ly - 1 + Math.sin(ta.w * .8 + xx * .7 + 2) * 1.1 * calm);
      g.lineTo(gx + gw - 1, gy0 + gh); g.closePath(); g.fill();
      g.globalAlpha = 1; g.beginPath(); g.moveTo(gx + 1, gy0 + gh);
      for (let xx = 0; xx <= gw - 2; xx += 2) g.lineTo(gx + 1 + xx, ly + Math.sin(ta.w + xx * .9) * 1.3 * calm);
      g.lineTo(gx + gw - 1, gy0 + gh); g.closePath(); g.fill();
      g.fillStyle = 'rgba(255,255,255,.28)'; g.fillRect(gx + 2, ly + 2, 2, Math.max(0, gy0 + gh - ly - 4));
      g.restore();
    }
    const blink = ta.full > .01 ? .5 + .5 * Math.sin(ta.t * 6) : 0;
    g.strokeStyle = ta.full > .01 ? 'rgba(255,90,79,' + (.5 + .5 * blink * ta.full).toFixed(3) + ')' : 'rgba(255,255,255,.4)'; g.lineWidth = 1; g.strokeRect(gx + .5, gy0 + .5, gw - 1, gh - 1);
    // tank full: pulsing red rim and a beacon on the roof
    if (ta.full > .01) {
      g.strokeStyle = 'rgba(255,90,79,' + (.25 + .5 * blink).toFixed(3) * ta.full + ')'; g.lineWidth = 4.5; g.beginPath(); g.ellipse(cx, cy - h, rx, ry, 0, 0, 6.2832); g.stroke();
      g.fillStyle = 'rgba(255,90,79,' + (.25 * blink * ta.full).toFixed(3) + ')'; g.beginPath(); g.arc(cx, cy - h - 12, 14, 0, 6.2832); g.fill();
      g.fillStyle = blink > .45 ? '#ff5a4f' : '#7a2620'; g.beginPath(); g.arc(cx, cy - h - 12, 4.2, 0, 6.2832); g.fill();
    }
    // pipe stubs
    g.fillStyle = '#c4322a'; g.fillRect(cx - rx + 4, cy - 6, 9, 7);
    for (let i = 0; i < b.level; i++) { g.fillStyle = '#ffb41f'; g.fillRect(cx - 14 + i * 7, cy + 16, 5, 4); }
    g.restore();
  }

  /* ================= Scene ================= */
  let tNow = 0;
  function render() {
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.fillStyle = bgGrad; ctx.fillRect(0, 0, cv.width, cv.height);
    const z = cam.z * dpr;
    ctx.setTransform(z, 0, 0, z, cv.width / 2 - cam.x * z, cv.height / 2 - cam.y * z);
    ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';
    drawGround(cam.x - vw / 2 / cam.z - 40, cam.y - vh / 2 / cam.z - 40, cam.x + vw / 2 / cam.z + 40, cam.y + vh / 2 / cam.z + 40, cam.z < .6 ? 1 : 0, 2);

    const buildMode = ui.tool === 'well' || ui.tool === 'pipe' || ui.tool === 'tank' || ui.tool === 'pump' || ui.tool === 'explore';
    if (buildMode) drawGrid();
    if (ui.tool === 'explore' || ui.tool === 'well') drawAreas();

    const x0 = cam.x - vw / 2 / cam.z - 110, x1 = cam.x + vw / 2 / cam.z + 110, y0 = cam.y - vh / 2 / cam.z - 140, y1 = cam.y + vh / 2 / cam.z + 90;
    const items = [], t = tNow;
    const vis = (wx, wy) => wx > x0 && wx < x1 && wy > y0 && wy < y1;
    for (const d of game.map.decos) {
      const [cx, cy] = cc(d.x, d.y);
      if (!vis(cx, cy)) continue;
      if (d.type === 'shrub' && (game.occ[idx(d.x, d.y)] || game.pipe[idx(d.x, d.y)])) continue;
      items.push({ d: d.x + d.y, o: 1, f: g => d.type === 'palm' ? drawPalm(g, cx, cy, d.v, t) : d.type === 'shrub' ? drawShrub(g, cx, cy, d.v) : drawRock(g, cx, cy, d.type === 'bigrock' ? 30 + d.v * 14 : 14 + d.v * 6, d.v) });
    }
    leakList.length = 0;
    for (let k = 0; k < game.pipe.length; k++) {
      if (!game.pipe[k]) continue;
      if (game.pipeSt[k]) leakList.push(k);
      const x = k % W, y = (k / W) | 0, [cx, cy] = cc(x, y);
      if (!vis(cx, cy)) continue;
      items.push({ d: x + y, o: 2, f: game.net.live[k] === 0 ? g => { g.save(); g.globalAlpha = .45 + .25 * Math.sin(tNow * 9 + k); drawPipe(g, x, y, k, t); g.restore(); } : anim.born.has('p' + k) ? popped('p' + k, cx, cy, g => drawPipe(g, x, y, k, t)) : g => drawPipe(g, x, y, k, t) });
    }
    for (const b of game.buildings) {
      if (b.type === 'well') { const [cx, cy] = cc(b.x, b.y); if (vis(cx, cy)) items.push({ d: b.x + b.y, o: 1, f: b.ready > game.s.time ? underConstruction(b, cx, cy + 14, g => drawWell(g, b, t)) : anim.born.has('b' + b.id) ? popped('b' + b.id, cx, cy + 14, g => drawWell(g, b, t)) : g => drawWell(g, b, t) }); }
      else if (b.type === 'pump') { const [cx, cy] = cc(b.x, b.y); if (vis(cx, cy)) items.push({ d: b.x + b.y, o: 1, f: b.ready > game.s.time ? underConstruction(b, cx, cy + 10, g => drawPump(g, b, t)) : anim.born.has('b' + b.id) ? popped('b' + b.id, cx, cy + 10, g => drawPump(g, b, t)) : g => drawPump(g, b, t) }); }
      else { const cx = (b.x - b.y) * 32, cy = (b.x + b.y + 2) * 16; if (vis(cx, cy)) items.push({ d: b.x + b.y + 2, o: 0, f: b.ready > game.s.time ? underConstruction(b, cx, cy + 6, g => drawTank(g, b)) : anim.born.has('b' + b.id) ? popped('b' + b.id, cx, cy + 6, g => drawTank(g, b)) : g => drawTank(g, b) }); }
    }
    items.sort((a, b) => a.d - b.d || a.o - b.o);
    for (const it of items) it.f(ctx);
    drawFx();
    drawLeaks();

    drawOverlays();
    drawPills();
    drawTankLabels();
  }

  const leakList = [];
  // Leaks: a pulsing red badge (repairing: amber with a progress ring) so the problem is easy to find, plus a few drops.
  function drawLeaks() {
    for (const k of leakList) {
      const x = k % W, y = (k / W) | 0, [cx, cy] = cc(x, y), st = game.pipeSt[k], p = .5 + .5 * Math.sin(tNow * (st === 1 ? 6 : 3));
      const by = cy - 34 - 3 * p;
      ctx.fillStyle = 'rgba(0,0,0,.3)'; ctx.beginPath(); ctx.ellipse(cx, cy - 4, 10, 4, 0, 0, 6.2832); ctx.fill();
      if (st === 1) {
        ctx.fillStyle = '#16110c';
        for (let i = 0; i < 3; i++) { const f = (tNow * 1.3 + i / 3) % 1; ctx.globalAlpha = 1 - f; ctx.beginPath(); ctx.ellipse(cx + (i - 1) * 6, cy - 2 + f * 14, 2, 3, 0, 0, 6.2832); ctx.fill(); }
        ctx.globalAlpha = 1;
      }
      ctx.fillStyle = st === 1 ? 'rgba(255,90,79,' + (.82 + .18 * p) + ')' : 'rgba(255,180,31,.95)';
      ctx.beginPath(); ctx.arc(cx, by, 11 + (st === 1 ? 2 * p : 0), 0, 6.2832); ctx.fill();
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.stroke();
      if (st === 1) { ctx.fillStyle = '#fff'; ctx.fillRect(cx - 1.5, by - 6, 3, 8); ctx.fillRect(cx - 1.5, by + 4, 3, 3); }
      else { const f = 1 - game.pipeT[k] / CFG.PIPE.REPAIR_TIME; ctx.strokeStyle = '#2a1000'; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(cx, by, 6, -1.5708, -1.5708 + 6.2832 * clamp(f, 0, 1)); ctx.stroke(); }
    }
  }

  // Exploration layer (explore / well tools): each AREA x AREA block is hidden until it has been explored.
  const KIND_COL = { empty: '120,130,140', small: '90,200,120', medium: '255,190,40', large: '255,120,50' };
  function drawAreas() {
    const A = CFG.EXPLORE.AREA, x0 = cam.x - vw / 2 / cam.z - 160, x1 = cam.x + vw / 2 / cam.z + 160, y0 = cam.y - vh / 2 / cam.z - 160, y1 = cam.y + vh / 2 / cam.z + 160;
    const sel = ui.sel && ui.sel.kind === 'area' ? ui.sel.id : -1;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.direction = 'ltr';
    for (const a of game.areas) {
      if (!a.land) continue;
      const gx = a.ax * A, gy = a.ay * A, ex = Math.min(W, gx + A), ey = Math.min(H, gy + A);
      const cxw = ((gx - gy) + (ex - ey)) * 16, cyw = ((gx + gy) + (ex + ey)) * 8;
      if (cxw < x0 || cxw > x1 || cyw < y0 || cyw > y1) continue;
      const P = (X, Y) => [(X - Y) * 32, (X + Y) * 16];
      const pts = [P(gx, gy), P(ex, gy), P(ex, ey), P(gx, ey)];
      const info = a.st === 2 ? KIND_COL[a.kind] : a.st === 1 ? '255,180,31' : '20,30,50';
      ctx.beginPath(); pts.forEach((p, i) => i ? ctx.lineTo(p[0], p[1]) : ctx.moveTo(p[0], p[1])); ctx.closePath();
      ctx.fillStyle = 'rgba(' + info + ',' + (a.st === 2 ? (a.kind === 'empty' ? .22 : .26) : a.st === 1 ? .3 : .42) + ')'; ctx.fill();
      ctx.strokeStyle = a.id === sel ? '#fff' : 'rgba(' + (a.st === 0 ? '200,215,235' : info) + ',.85)'; ctx.lineWidth = (a.id === sel ? 3.5 : 1.8) / cam.z; ctx.setLineDash(a.st === 0 ? [10 / cam.z, 7 / cam.z] : []); ctx.stroke(); ctx.setLineDash([]);
      const locked = !game.regionOpen(a.region);
      let label = '?', sub = '';
      if (a.st === 1) { label = Math.round(game.areaInfo(a).progress * 100) + '%'; }
      else if (a.st === 2) { label = a.kind === 'empty' ? '∅' : '●'.repeat(a.kind === 'small' ? 1 : a.kind === 'medium' ? 2 : 3); sub = a.kind === 'empty' ? '' : a.quality[0]; }
      if (locked) {                                                  // padlock: the region has not been unlocked yet
        ctx.fillStyle = 'rgba(8,14,24,.45)'; ctx.fill();
        ctx.fillStyle = 'rgba(235,242,250,.9)'; ctx.fillRect(cxw - 9, cyw - 4, 18, 14); ctx.strokeStyle = 'rgba(235,242,250,.9)'; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(cxw, cyw - 4, 6, Math.PI, 0); ctx.stroke(); continue;
      }
      ctx.font = '700 ' + (a.st === 0 ? 30 : 22) + 'px "Chakra Petch", sans-serif';
      ctx.fillStyle = a.st === 0 ? 'rgba(235,242,250,.85)' : '#fff'; ctx.fillText(label, cxw, cyw);
      if (sub) { ctx.font = '600 13px "Chakra Petch", sans-serif'; ctx.fillStyle = 'rgba(255,255,255,.9)'; ctx.fillText(sub, cxw, cyw + 20); }
    }
    ctx.textAlign = 'left';
  }

  // Capacity label above every tank: current oil / capacity.
  function drawTankLabels() {
    if (cam.z < .65) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.font = '600 12px "Chakra Petch", Cairo, sans-serif'; ctx.textBaseline = 'middle'; ctx.textAlign = 'center'; ctx.direction = 'ltr';
    for (const b of game.buildings) {
      if (b.type !== 'tank') continue;
      const p = w2s((b.x - b.y) * 32, (b.x + b.y + 2) * 16 + 5 + tankTopY(b) - 14);
      if (p.x < -60 || p.x > vw + 60 || p.y < -20 || p.y > vh + 20) continue;
      const cap = game.tankCap(b), ta = tankAnim(b), f = ta.f, text = num(b.amt) + ' / ' + num(cap), w = ctx.measureText(text).width + 18;
      ctx.fillStyle = ta.full > .01 ? 'rgba(' + (10 + 110 * ta.full * (.6 + .4 * Math.sin(ta.t * 6))) + ',20,26,.92)' : 'rgba(10,20,32,.88)'; ctx.beginPath(); ctx.roundRect(p.x - w / 2, p.y - 12, w, 24, 12); ctx.fill();
      ctx.fillStyle = f > .95 ? '#ff5a4f' : f > .75 ? '#ffb41f' : '#2fd27a'; ctx.fillRect(p.x - w / 2 + 9, p.y + 7, (w - 18) * f, 2);
      ctx.fillStyle = '#fff'; ctx.fillText(text, p.x, p.y - 1);
    }
    ctx.textAlign = 'left';
  }

  function drawGrid() {          // only the lines that are on screen
    const cs = [[0, 0], [vw, 0], [0, vh], [vw, vh]].map(p => { const w = s2w(p[0], p[1]); return [(w.x / 32 + w.y / 16) / 2, (w.y / 16 - w.x / 32) / 2]; });
    const u0 = clamp(Math.floor(Math.min(...cs.map(c => c[0]))) - 1, 0, W), u1 = clamp(Math.ceil(Math.max(...cs.map(c => c[0]))) + 1, 0, W);
    const v0 = clamp(Math.floor(Math.min(...cs.map(c => c[1]))) - 1, 0, H), v1 = clamp(Math.ceil(Math.max(...cs.map(c => c[1]))) + 1, 0, H);
    ctx.strokeStyle = 'rgba(255,255,255,.16)'; ctx.lineWidth = 1 / cam.z; ctx.beginPath();
    for (let i = u0; i <= u1; i++) { ctx.moveTo((i - v0) * 32, (i + v0) * 16); ctx.lineTo((i - v1) * 32, (i + v1) * 16); }
    for (let j = v0; j <= v1; j++) { ctx.moveTo((u0 - j) * 32, (u0 + j) * 16); ctx.lineTo((u1 - j) * 32, (u1 + j) * 16); }
    ctx.stroke();
  }

  function tileFill(x, y, col, w) {
    const cx = (x - y) * 32, top = (x + y) * 16;
    ctx.beginPath(); ctx.moveTo(cx, top); ctx.lineTo(cx + 32, top + 16); ctx.lineTo(cx, top + 32); ctx.lineTo(cx - 32, top + 16); ctx.closePath();
    ctx.fillStyle = col; ctx.fill();
    if (w) { ctx.strokeStyle = w; ctx.lineWidth = 2 / cam.z; ctx.stroke(); }
  }
  function footprint(type, x, y, col, edge) {
    const [fw, fh] = game.footprintOf(type), p0 = gridToWorld(x, y), p1 = gridToWorld(x + fw, y), p2 = gridToWorld(x + fw, y + fh), p3 = gridToWorld(x, y + fh);
    ctx.beginPath(); ctx.moveTo(p0[0], p0[1]); ctx.lineTo(p1[0], p1[1]); ctx.lineTo(p2[0], p2[1]); ctx.lineTo(p3[0], p3[1]); ctx.closePath();
    ctx.fillStyle = col; ctx.fill(); ctx.strokeStyle = edge; ctx.lineWidth = 2 / cam.z; ctx.stroke();
  }

  // direction of a pump about to be built: the side that is closer to a tank is the output (auto); the flip button reverses it
  function pumpDirFor(cell) { const c = game.canPlacePump(cell.x, cell.y); if (!c.ok) return 0; return game.pumpAutoDir(cell.x, cell.y, c.axis) ^ (ui.pumpFlip ? 1 : 0); }
  function drawInOut(cell, dir) {            // "IN -> PUMP -> OUT" marks on the two neighbouring tiles
    const d = DIRS[dir], tag = (x, y, txt, col) => { const [cx, cy] = cc(x, y); ctx.save(); ctx.font = '700 ' + Math.round(13 / Math.max(.6, cam.z)) + 'px "Chakra Petch", sans-serif'; ctx.textAlign = 'center'; ctx.fillStyle = 'rgba(10,20,32,.9)'; const w = ctx.measureText(txt).width + 12, h = 16 / Math.max(.6, cam.z); ctx.beginPath(); ctx.roundRect(cx - w / 2, cy - 30 - h / 2, w, h + 4, 6); ctx.fill(); ctx.fillStyle = col; ctx.fillText(txt, cx, cy - 30 + h / 2 - 3 / Math.max(.6, cam.z)); ctx.restore(); };
    ctx.globalAlpha = 1; tag(cell.x - d[0], cell.y - d[1], 'IN', '#6fc3ff'); tag(cell.x + d[0], cell.y + d[1], 'OUT', '#ffb41f');
  }
  const hl = { key: '', tiles: [], blds: [] };
  let pill = null;           // { text, wx, wy, ok }
  function drawOverlays() {
    pill = null;
    const tm = tNow;
    // selection
    if (ui.sel) {
      const pulse = .55 + .25 * Math.sin(tm * 5);
      if (ui.sel.kind === 'b') {
        const b = game.buildings.find(q => q.id === ui.sel.id);
        if (b) footprint(b.type, b.x, b.y, 'rgba(255,180,31,' + (pulse * .25) + ')', 'rgba(255,180,31,' + pulse + ')');
      } else if (ui.sel.kind === 'pipe') {
        const x = ui.sel.k % W, y = (ui.sel.k / W) | 0;
        tileFill(x, y, 'rgba(255,180,31,' + (pulse * .3) + ')', 'rgba(255,180,31,' + pulse + ')');
      }
      // network highlight: only recomputed when the selection or the network changes (netVersion), never per frame
      const hk = ui.sel.kind + ':' + (ui.sel.id != null ? ui.sel.id : ui.sel.k) + ':' + game.netVersion;
      if (hl.key !== hk) {
        hl.key = hk; hl.tiles = []; hl.blds = [];
        const net = game.net;
        if (ui.sel.kind === 'b') {
          const b = game.buildings.find(q => q.id === ui.sel.id);
          if (b && b.type === 'well' && b.target != null) { const r = (net.routes.get(b.id) || []).find(q => q.tank.id === b.target); if (r) { hl.tiles = r.path.slice(); hl.blds = [r.tank]; } }
          else if (b && b.type === 'tank') { hl.blds = game.tankNet(b).feeding; for (const w of hl.blds) { const r = (net.routes.get(w.id) || []).find(q => q.tank === b); if (r) hl.tiles.push(...r.path); } }
        } else if (ui.sel.kind === 'pipe') { const c = net.comps[net.compOf[ui.sel.k]]; if (c) { hl.tiles = c.pipes.slice(); hl.blds = c.wells.concat(c.tanks); } }
      }
      const ha = .16 + .1 * Math.sin(tm * 4);
      for (const k of hl.tiles) if (!(ui.sel.kind === 'pipe' && k === ui.sel.k)) tileFill(k % W, (k / W) | 0, 'rgba(255,214,102,' + ha + ')', 'rgba(255,214,102,' + (ha + .2) + ')');
      for (const q of hl.blds) if (!(ui.sel.kind === 'b' && q.id === ui.sel.id)) footprint(q.type, q.x, q.y, 'rgba(47,210,122,' + ha + ')', 'rgba(47,210,122,.75)');
    }
    const tool = ui.tool;
    const cell = ui.pending || (tool === 'well' || tool === 'tank' || tool === 'pump' ? snapBuild(tool, ui.hover) : ui.hover);
    if (tool === 'well' || tool === 'tank' || tool === 'pump') {
      drawSpots(tool);
      if (cell && inb(cell.x, cell.y)) {
        ctx.save(); if (ui.pending) ctx.translate(gOff.x, gOff.y);
        const pl = game.placement(tool, cell.x, cell.y, ui.wellKind), ok = pl.ok, poor = pl.state === 'UNAFFORDABLE';
        const col = ok ? '#2fd27a' : poor ? '#ffb41f' : '#ff5a4f';                                 // green = valid, amber = valid spot but not enough money, red = invalid
        footprint(tool, cell.x, cell.y, ok ? 'rgba(47,210,122,.35)' : poor ? 'rgba(255,180,31,.38)' : 'rgba(255,90,79,.4)', col);
        ctx.globalAlpha = pl.state === 'INVALID' ? .4 : .62;                                         // the real asset stays identifiable in every state (it is only drawn translucent, never recoloured)
        if (tool === 'well') drawWell(ctx, { id: 0, x: cell.x, y: cell.y, level: 1, status: 'idle', kind: ui.wellKind }, tm);
        else if (tool === 'pump') { const pd = pumpDirFor(cell); drawPump(ctx, { x: cell.x, y: cell.y, dir: pd, spin: 0 }, tm, true); if (pl.state !== 'INVALID') drawInOut(cell, pd); }
        else drawTank(ctx, { x: cell.x, y: cell.y, level: 1, amt: 0 });
        ctx.globalAlpha = 1;
        ctx.restore();
        const fc = footprintCenter(tool, cell.x, cell.y), fh2 = game.footprintOf(tool)[1];
        pill = { text: ok ? t('cost', { cost: money(pl.cost) }) + ' · ' + t('tr.' + CFG.TERRAIN.NAMES[game.terrainAt(cell.x, cell.y)]) : poor ? t('noCash') : help(pl.reason), wx: fc[0] + (ui.pending ? gOff.x : 0), wy: gridToWorld(cell.x, cell.y + fh2)[1] + 34 + (ui.pending ? gOff.y : 0), ok, dot: col };
      }
    } else if (tool === 'pipe') {
      if (ui.pipeStart) tileFill(ui.pipeStart.x, ui.pipeStart.y, 'rgba(255,180,31,.4)', '#ffb41f');
      const end = ui.pending || ui.hover;
      if (ui.pipeStart && end && inb(end.x, end.y)) {
        const r = game.routePipe(ui.pipeStart.x, ui.pipeStart.y, end.x, end.y, ui.flip);
        const afford = game.s.cash >= r.cost, ok = r.ok && afford;
        const fresh = new Set(r.fresh);
        for (const c of r.cells) {
          const k = idx(c[0], c[1]);
          tileFill(c[0], c[1], r.ok ? (fresh.has(k) ? 'rgba(80,170,255,.5)' : 'rgba(160,160,160,.25)') : 'rgba(255,90,79,.4)', r.ok ? 'rgba(130,200,255,.9)' : '#ff5a4f');
        }
        for (let i = 1; i + 1 < r.cells.length; i++) {                                       // the corners of the route, so the shape is readable before it is built
          const a0 = r.cells[i - 1], b0 = r.cells[i], c0 = r.cells[i + 1];
          if (b0[0] - a0[0] !== c0[0] - b0[0] || b0[1] - a0[1] !== c0[1] - b0[1]) { const [qx, qy] = cc(b0[0], b0[1]); ctx.fillStyle = '#ffffff'; ctx.strokeStyle = r.ok ? '#2a7fc0' : '#ff5a4f'; ctx.lineWidth = 2 / cam.z; ctx.beginPath(); ctx.arc(qx, qy - 3, 5 / cam.z * 1.1, 0, 6.2832); ctx.fill(); ctx.stroke(); }
        }
        const [ex, ey] = cc(end.x, end.y);
        const dot = !ok ? '#ff5a4f' : r.connects ? '#2fd27a' : '#ffb41f';                       // red = invalid, green = joins a well to a tank, amber = valid but not joined yet
        const info = r.ok ? game.routeInfo(r) : null, jn = info && info.junctions.length ? info.junctions[0] : null;
        const jlabel = jn ? (jn.to >= 4 ? t('pv.x') : jn.isNew ? t('pv.t') : t('pv.more')) : '';
        const stat = !afford ? t('noCash') : r.connects ? t('connects') : t('noTankYet');
        pill = { text: r.ok ? t('cost', { cost: money(r.cost) }) + ' · ' + t('pv.tiles', { n: info.fresh }) + (info.corners ? ' · ' + t('pv.turns', { n: info.corners }) : '') : err(r.reason),
          text2: r.ok ? [jlabel, stat, r.auto ? t('pv.detour') : ''].filter(Boolean).join(' · ') : '', wx: ex, wy: ey + 26, ok, dot };
        if (!pill.text2) delete pill.text2;
        ringAt(end.x, end.y, dot, 1, true);
        if (info) for (const j of info.junctions) {                                        // where the junction will be made: a ring + the new branch count
          const [jx, jy] = cc(j.x, j.y); ctx.save(); ctx.strokeStyle = '#7cd7ff'; ctx.lineWidth = 3 / cam.z; ctx.setLineDash([6 / cam.z, 4 / cam.z]);
          ctx.beginPath(); ctx.ellipse(jx, jy + 2, 26 + 2 * Math.sin(tNow * 6), 13 + Math.sin(tNow * 6), 0, 0, 6.2832); ctx.stroke(); ctx.setLineDash([]);
          ctx.fillStyle = '#7cd7ff'; ctx.beginPath(); ctx.arc(jx, jy - 4, 4.2, 0, 6.2832); ctx.fill(); ctx.restore();
        }
        const eb = game.occ[idx(end.x, end.y)]; if (eb) footprint(eb.type, eb.x, eb.y, 'rgba(47,210,122,.18)', dot);
        ui.route = r;
      } else ui.route = null;
      if (!ui.pipeStart) {                                                                        // show where a pipe can start
        const gl = .35 + .25 * Math.sin(tm * 4);
        for (const b of game.buildings) footprint(b.type, b.x, b.y, 'rgba(255,180,31,' + (gl * .22).toFixed(3) + ')', 'rgba(255,180,31,' + gl.toFixed(3) + ')');
        for (const b of game.buildings) if (b.type === 'pump') { const d = (b.dir || 0) < 2 ? [[1, 0], [-1, 0]] : [[0, 1], [0, -1]]; for (const q of d) { const px = b.x + q[0], py = b.y + q[1]; if (inb(px, py) && !game.occ[idx(px, py)]) tileFill(px, py, 'rgba(255,180,31,' + (gl * .35).toFixed(3) + ')', 'rgba(255,180,31,' + gl.toFixed(3) + ')'); } }     // a pump connects only at its two ends
      }
      if (!ui.pipeStart && ui.hover && inb(ui.hover.x, ui.hover.y)) tileFill(ui.hover.x, ui.hover.y, 'rgba(255,255,255,.22)', 'rgba(255,255,255,.7)');
    } else if (tool === 'erase') {
      if (ui.hover && inb(ui.hover.x, ui.hover.y)) {
        const k = idx(ui.hover.x, ui.hover.y), b = (ui.mouse && pickBuilding(ui.mouse.x, ui.mouse.y)) || game.occ[k];
        if (b) footprint(b.type, b.x, b.y, 'rgba(255,90,79,.35)', '#ff5a4f');
        else if (game.pipe[k]) tileFill(ui.hover.x, ui.hover.y, 'rgba(255,90,79,.35)', '#ff5a4f');
      }
    } else if (tool === 'select' && ui.hover && ui.ptype === 'mouse' && inb(ui.hover.x, ui.hover.y)) {
      const k = idx(ui.hover.x, ui.hover.y), b = (ui.mouse && pickBuilding(ui.mouse.x, ui.mouse.y)) || game.occ[k];
      if (b) footprint(b.type, b.x, b.y, 'rgba(255,255,255,.12)', 'rgba(255,255,255,.55)');
      else if (game.pipe[k]) tileFill(ui.hover.x, ui.hover.y, 'rgba(255,255,255,.18)', 'rgba(255,255,255,.55)');
    }
    drawCoachMarks();
    if (dbg.on && game.net.graph) {                                                   // debug: graph nodes (junctions and pipe ends) with their ids and branch counts
      ctx.save(); ctx.font = '700 ' + (11 / cam.z).toFixed(2) + 'px sans-serif'; ctx.textAlign = 'center'; ctx.lineWidth = 3 / cam.z; let n = 0;
      for (const nd of game.net.graph.nodes) {
        if (nd.kind !== 'junction' && nd.kind !== 'end') continue; if (++n > 150) break;
        const [nx, ny] = cc(nd.x, nd.y), col = nd.kind === 'junction' ? '#7cd7ff' : '#ffd166', txt = nd.id + (nd.kind === 'junction' ? ' x' + nd.edges.length : '');
        ctx.strokeStyle = col; ctx.beginPath(); ctx.arc(nx, ny - 5, 5 / cam.z * 1.4, 0, 6.2832); ctx.stroke();
        ctx.strokeStyle = 'rgba(0,0,0,.8)'; ctx.fillStyle = col; ctx.strokeText(txt, nx, ny - 22 / cam.z * 1.1); ctx.fillText(txt, nx, ny - 22 / cam.z * 1.1);
      }
      ctx.restore();
    }
  }
  function drawPills() {
    if (!pill) return;
    const p = w2s(pill.wx, pill.wy), F1 = '600 14px "Chakra Petch", Cairo, Barlow, sans-serif', F2 = '500 12px "Chakra Petch", Cairo, Barlow, sans-serif', ar = prefs.lang === 'ar';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.font = F1; ctx.direction = ar ? 'rtl' : 'ltr'; ctx.textAlign = ar ? 'right' : 'left';
    let tw = ctx.measureText(pill.text).width; if (pill.text2) { ctx.font = F2; tw = Math.max(tw, ctx.measureText(pill.text2).width); ctx.font = F1; }
    const dotW = pill.dot ? 16 : 0, w = Math.min(vw - 16, tw + 24 + dotW), h = pill.text2 ? 46 : 28, x = clamp(p.x - w / 2, 8, vw - w - 8), y = clamp(p.y, 8, vh - h - 8);
    ctx.fillStyle = 'rgba(10,20,32,.92)'; ctx.strokeStyle = pill.ok ? '#2fd27a' : '#ff5a4f'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.roundRect(x, y, w, h, 14); ctx.fill(); ctx.stroke();
    if (pill.dot) { ctx.fillStyle = pill.dot; ctx.beginPath(); ctx.arc(ar ? x + 14 : x + w - 14, y + (pill.text2 ? 14 : h / 2), 5.5, 0, 6.2832); ctx.fill(); }
    ctx.fillStyle = '#fff'; ctx.textBaseline = 'middle'; ctx.fillText(pill.text, ar ? x + w - 12 : x + 12 + dotW, y + (pill.text2 ? 14 : h / 2) + 1);
    if (pill.text2) { ctx.font = F2; ctx.fillStyle = 'rgba(210,225,240,.85)'; ctx.fillText(pill.text2, ar ? x + w - 12 : x + 12, y + 33); }
    ctx.direction = 'ltr'; ctx.textAlign = 'left';
  }

  /* ---------- minimap ---------- */
  function drawMini() {
    const w = mini.width, h = mini.height;
    mctx.setTransform(1, 0, 0, 1, 0, 0);
    mctx.fillStyle = '#0b4766'; mctx.fillRect(0, 0, w, h);
    const tw = TERR.w, th = TERR.h;
    const sc = Math.min(w / tw, h / th), ox = (w - tw * sc) / 2, oy = (h - th * sc) / 2;
    mctx.drawImage(TERR.mini, ox, oy, tw * sc, th * sc);
    const m = (wx, wy) => [ox + (wx - TERR.minX) * sc, oy + (wy - TERR.minY) * sc];
    for (const b of game.buildings) {
      const p = b.type === 'tank' ? m((b.x - b.y) * 32, (b.x + b.y + 2) * 16) : m(...cc(b.x, b.y));
      mctx.fillStyle = b.type === 'tank' ? '#ffffff' : '#ff5a4f';
      mctx.beginPath(); mctx.arc(p[0], p[1], (b.type === 'tank' ? 3.2 : 2.4) * dpr, 0, 6.2832); mctx.fill();
    }
    mctx.fillStyle = '#4aa8ff';
    for (let k = 0; k < game.pipe.length; k++) if (game.pipe[k]) { const p = m(...cc(k % W, (k / W) | 0)); mctx.fillRect(p[0] - dpr, p[1] - dpr, 2 * dpr, 2 * dpr); }
    const a = m(cam.x - vw / 2 / cam.z, cam.y - vh / 2 / cam.z), b2 = m(cam.x + vw / 2 / cam.z, cam.y + vh / 2 / cam.z);
    mctx.strokeStyle = '#fff'; mctx.lineWidth = 1.5 * dpr; mctx.strokeRect(a[0], a[1], b2[0] - a[0], b2[1] - a[1]);
  }
  function miniNav(e) {
    const r = mini.getBoundingClientRect(), tw = TERR.w, th = TERR.h;
    const sc = Math.min(r.width / tw, r.height / th), ox = (r.width - tw * sc) / 2, oy = (r.height - th * sc) / 2;
    cam.x = (e.clientX - r.left - ox) / sc + TERR.minX; cam.y = (e.clientY - r.top - oy) / sc + TERR.minY; clampCam();
  }
  let miniDown = false;
  mini.addEventListener('pointerdown', e => { camGoal.on = false; miniDown = true; mini.setPointerCapture(e.pointerId); miniNav(e); });
  mini.addEventListener('pointermove', e => { if (miniDown) miniNav(e); });
  mini.addEventListener('pointerup', () => { miniDown = false; });
  mini.addEventListener('pointercancel', () => { miniDown = false; });

  // Tall buildings are picked by their drawn shape, not just their ground tile.
  function pickBuilding(sx, sy) {
    const w = s2w(sx, sy), list = game.buildings.slice().sort((a, b) => (b.x + b.y + (b.type === 'tank' ? 2 : 0)) - (a.x + a.y + (a.type === 'tank' ? 2 : 0)));
    for (const b of list) {
      if (b.type === 'well') { const [cx, cy] = cc(b.x, b.y); if (w.x > cx - 52 && w.x < cx + 48 && w.y > cy - 84 && w.y < cy + 28) return b; }
      else if (b.type === 'pump') { const [cx, cy] = cc(b.x, b.y); if (w.x > cx - 48 && w.x < cx + 48 && w.y > cy - 52 && w.y < cy + 24) return b; }
      else { const cx = (b.x - b.y) * 32, cy = (b.x + b.y + 2) * 16; if (w.x > cx - 56 && w.x < cx + 56 && w.y > cy - 80 && w.y < cy + 34) return b; }
    }
    return null;
  }

  /* ================= Input =================
     Touch priority: 1 modal / UI (separate DOM layers, never reach the canvas) -> 2 building placement -> 3 pipe drawing -> 4 camera pan -> tap.
     One finger in a build tool moves the preview, in the pipe tool it draws; it never pans the camera there (two fingers always pan + zoom).
     A touch becomes a drag after DRAG_PX px and is then never a tap; a long press is not a tap either. */
  const ptrs = new Map();
  let pinch = null, gesture = false;
  const local = e => { const r = cv.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
  const DRAG_PX = type => type === 'mouse' ? 5 : 10;            // px of movement before a touch is a drag
  const TAP_MAX = 700, TAP_GAP = 140, CONFIRM_GAP = 450;   // ms: longest tap, shortest gap between taps, shortest gap before a second tap confirms
  const PLACE_TOOLS = ['well', 'tank', 'pump'];
  const placeTool = () => PLACE_TOOLS.includes(ui.tool);
  /* One input mode owns a gesture at a time. It is derived from the real UI state (never stored twice), in priority order:
     UI_INTERACTION (a modal is open) > PINCH_ZOOM (two fingers) > PIPE_DRAWING (pipe tool) > BUILDING_PLACEMENT (build tool)
     > SELECTING (an object is selected) > DEFAULT (camera pan / tap). */
  const IM = { DEFAULT: 'DEFAULT', SELECTING: 'SELECTING', BUILDING_PLACEMENT: 'BUILDING_PLACEMENT', PIPE_DRAWING: 'PIPE_DRAWING', PINCH_ZOOM: 'PINCH_ZOOM', UI_INTERACTION: 'UI_INTERACTION' };
  function inputMode() {
    if (!mk.hidden || !stm.hidden || !$('#regions').hidden) return IM.UI_INTERACTION;
    if (pinch || ptrs.size >= 2) return IM.PINCH_ZOOM;
    if (ui.tool === 'pipe') return IM.PIPE_DRAWING;
    if (placeTool()) return IM.BUILDING_PLACEMENT;
    return ui.sel ? IM.SELECTING : IM.DEFAULT;
  }
  const uvOf = worldToGrid;
  const gOff = { x: 0, y: 0 };                             // the preview glides: when it snaps to another cell this offset eases back to 0 (no jumps)
  const pd = { on: false, gu: 0, gv: 0, fx: 0, fy: 0 };    // placement drag state (grid units, finger)
  function setPending(c) { ui.pending = c; ui.pendT = performance.now(); }
  function placeSet(x, y) {
    const t0 = ui.pending;
    if (!inb(x, y)) return;
    if (t0 && t0.x === x && t0.y === y) return;
    if (t0) { gOff.x += ((t0.x - t0.y) - (x - y)) * 32; gOff.y += ((t0.x + t0.y) - (x + y)) * 16; }
    setPending({ x, y }); updateConfirm();
  }
  function placeMoveWorld(dxw, dyw) {                      // move the preview by a world-space delta, with hysteresis so it never flickers between cells
    const [du, dv] = uvOf(dxw, dyw); pd.gu += du; pd.gv += dv;
    const cur = ui.pending || { x: Math.floor(pd.gu), y: Math.floor(pd.gv) };
    const nx = Math.abs(pd.gu - (cur.x + .5)) < .62 ? cur.x : Math.floor(pd.gu), ny = Math.abs(pd.gv - (cur.y + .5)) < .62 ? cur.y : Math.floor(pd.gv);
    placeSet(clamp(nx, 0, W - 1), clamp(ny, 0, H - 1));
  }
  function stepPlacing(real) {
    const k = Math.exp(-Math.min(real, .05) * 14); gOff.x *= k; gOff.y *= k;
    if (Math.abs(gOff.x) < .05) gOff.x = 0; if (Math.abs(gOff.y) < .05) gOff.y = 0;
    if (!pd.on) return;                                    // dragging a preview near the screen edge scrolls the map so it can be carried further
    const mx = 46, top = 130, bot = vh - 190; let sx = 0, sy = 0;
    if (pd.fx < mx) sx = -(1 - pd.fx / mx); else if (pd.fx > vw - mx) sx = 1 - (vw - pd.fx) / mx;
    if (pd.fy < top) sy = -(1 - pd.fy / top) * .6; else if (pd.fy > bot) sy = (pd.fy - bot) / 150 * .6;
    if (!sx && !sy) return;
    const px = clamp(sx, -1, 1) * 300 * Math.min(real, .05) / cam.z, py = clamp(sy, -1, 1) * 300 * Math.min(real, .05) / cam.z;
    const x0 = cam.x, y0 = cam.y; cam.x += px; cam.y += py; clampCam(); placeMoveWorld(cam.x - x0, cam.y - y0);
  }
  function startPlaceDrag(q) {
    pd.on = true; pd.fx = q.x; pd.fy = q.y; ui.placeDrag = true;
    if (!ui.pending) { const c = cellAt(q.sx, q.sy - 48); if (inb(c.x, c.y)) { setPending(c); gOff.x = gOff.y = 0; updateConfirm(); } }   // starts above the finger so the hand does not hide it
    const c = ui.pending; if (c) { pd.gu = c.x + .5; pd.gv = c.y + .5; }
  }
  function finishPlaceDrag() {
    pd.on = false; ui.placeDrag = false;
    const c = ui.pending; if (!c) return;
    if (!game.canPlace(ui.tool, c.x, c.y).ok) {            // dropped on a bad spot: glide to the nearest good one (if any), otherwise stay and say why
      const sn = snapBuild(ui.tool, c);
      if (sn && (sn.x !== c.x || sn.y !== c.y)) { gOff.x += ((c.x - c.y) - (sn.x - sn.y)) * 32; gOff.y += ((c.x + c.y) - (sn.x + sn.y)) * 16; setPending({ x: sn.x, y: sn.y }); }
    }
    updateConfirm();
  }

  cv.addEventListener('pointerdown', e => {
    if (inputMode() === IM.UI_INTERACTION) return;                // a modal owns every touch
    try { cv.setPointerCapture(e.pointerId); } catch (err) { /* pointer already gone */ }
    const p = local(e), touch = e.pointerType !== 'mouse';
    ptrs.set(e.pointerId, { x: p.x, y: p.y, sx: p.x, sy: p.y, moved: false, type: e.pointerType, button: e.button, drag: null, t0: performance.now(), place: false, noPan: false, sink: false });
    const q = ptrs.get(e.pointerId);
    ui.ptype = touch ? 'touch' : 'mouse';
    camGoal.on = false;                                           // the player takes the camera back at once
    if (ptrs.size === 1 && ui.tool === 'pipe' && (!touch || true) && (e.pointerType !== 'mouse' || e.button === 0)) { q.drag = dragStart(p.x, p.y, touch); if (!q.drag && touch) q.noPan = true; }
    else if (ptrs.size === 1 && touch && placeTool()) q.place = true;
    else if (ptrs.size === 1 && touch && pickBuilding(p.x, p.y)) q.onBld = true;   // a finger that starts ON a building never pans the camera (a tap selects it)
    if (ptrs.size === 2) {
      for (const v of ptrs.values()) { v.drag = null; v.place = false; v.noPan = false; v.onBld = false; }
      if (ui.pipeDragging) { ui.pipeDragging = false; cancelAction(); }
      if (pd.on) { pd.on = false; ui.placeDrag = false; }
      const [a, b] = [...ptrs.values()];
      pinch = { d: Math.max(8, Math.hypot(a.x - b.x, a.y - b.y)), z: cam.z };
