      'v.0': 'None', 'v.1': 'OPEN', 'v.2': 'PARTIAL', 'v.3': 'CLOSED', 'nw.pressure': '{n} bar', 'nw.pressLim': 'Pressure too low: needs {n} bar', 'p.transient': 'Pressure surge',
      't.pumpOn': 'Pump turned on', 't.pumpOff': 'Pump turned off', 't.valve': 'Valve: {a}'
    }
  };
  Object.assign(STR.ar, STR7.ar); Object.assign(STR.en, STR7.en);
  // Phase 6: branches, junctions, graph
  Object.assign(STR.ar, {
    'e.crossPipe': 'تقاطع الأنابيب ليس وصلة', 'x.crossPipe': 'تقاطع الأنابيب ليس وصلة: انهِ الأنبوب على الأنبوب القائم لعمل وصلة T، أو غيّر مساره',
