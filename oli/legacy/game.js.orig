      const [a, b] = [...ptrs.values()], d = Math.hypot(a.x - b.x, a.y - b.y), mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
      const before = s2w(mx, my); cam.z = clamp(pinch.z * d / pinch.d, cam.minZoom, cam.maxZoom);
      const after = s2w(mx, my); cam.x += before.x - after.x; cam.y += before.y - after.y; clampCam();
      return;
    }
    if (q.sink) { q.x = p.x; q.y = p.y; return; }                  // the finger left over after a pinch does nothing until it is lifted
    const th = DRAG_PX(q.type);
    if (q.drag && ptrs.size === 1) {                               // drag a pipe: well -> tank, the path is built on the grid
      if (!q.moved && Math.hypot(p.x - q.sx, p.y - q.sy) > th) { q.moved = true; ui.pipeStart = q.drag; ui.pipeDragging = true; setPending(null); }
      if (q.moved) { const e2 = snapPipeEnd(cellAt(p.x, p.y), p.x, p.y), c = ui.pending; if (!c || c.x !== e2.x || c.y !== e2.y) { setPending(e2); updateConfirm(); } }
      q.x = p.x; q.y = p.y; return;
    }
    if (q.place && ptrs.size === 1) {                              // drag a building preview: relative movement, snapped to the grid
      if (!q.moved && Math.hypot(p.x - q.sx, p.y - q.sy) > th) { q.moved = true; q.x = q.sx; q.y = q.sy; startPlaceDrag(q); }   // the preview follows from the touch-down point: the first few pixels are not lost
      if (q.moved) { pd.fx = p.x; pd.fy = p.y; placeMoveWorld((p.x - q.x) / cam.z, (p.y - q.y) / cam.z); }
      q.x = p.x; q.y = p.y; return;
    }
    if (q.noPan) {                                                 // pipe tool, finger started away from anything a pipe can start at: no camera pan, say what to do
      if (!q.moved && Math.hypot(p.x - q.sx, p.y - q.sy) > th) { q.moved = true; const n = performance.now(); if (n - (ui.hintT || 0) > 2500) { ui.hintT = n; toast(help('floating'), 'info'); } }
      q.x = p.x; q.y = p.y; return;
    }
    if (q.onBld) { if (Math.hypot(p.x - q.sx, p.y - q.sy) > th) q.moved = true; q.x = p.x; q.y = p.y; return; }   // buildings cannot be moved: the drag does nothing (no pan, no select)
    const dx = p.x - q.x, dy = p.y - q.y;
    if (!q.moved && Math.hypot(p.x - q.sx, p.y - q.sy) > th) { q.moved = true; cv.classList.add('dragging'); }
    if (q.moved) { cam.x -= dx / cam.z; cam.y -= dy / cam.z; clampCam(); }
