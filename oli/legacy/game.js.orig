  cv.addEventListener('touchend', e => { const c = e.changedTouches[0]; lastMapTouch = { t: performance.now(), x: c ? c.clientX : -99, y: c ? c.clientY : -99 }; if (e.cancelable) e.preventDefault(); }, { passive: false });
  document.addEventListener('click', e => {      // a ghost click lands where the finger just lifted; a real tap on a button elsewhere is never blocked
