  });
  cv.addEventListener('pointermove', e => {
    const p = local(e), q = ptrs.get(e.pointerId);
    if (!q) { if (e.pointerType === 'mouse') { ui.hover = cellAt(p.x, p.y); ui.mouse = p; } return; }
    if (e.pointerType === 'mouse') { ui.hover = cellAt(p.x, p.y); ui.mouse = p; }
    if (ptrs.size === 2 && pinch) {                                // two fingers: zoom around their midpoint, and pan with it
