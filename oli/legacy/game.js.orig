    'pv.tiles': '{n} قطعة', 'pv.t': 'وصلة T جديدة', 'pv.x': 'وصلة رباعية', 'pv.more': 'فرع إضافي', 'pv.toTank': 'إلى خزان', 'pv.toWell': 'من بئر', 'pv.toPump': 'إلى مضخة', 'pv.toPipe': 'يتصل بأنبوب', 'pv.free': 'نهاية حرة',
    'p.removeBranch': 'إزالة الفرع', 'p.removeBranchN': 'إزالة الفرع ({n} قطعة)', 'p.node': 'العقدة', 'nd.junction': 'وصلة · {n} فروع', 'nd.end': 'نهاية الخط', 'nd.seg': 'قسم أنبوب · {n} قطعة', 'nd.seg0': 'قسم أنبوب',
    'e.noRoute': 'لا يوجد مسار صالح', 'x.noRoute': 'لا يوجد مسار صالح: غيّر الوجهة أو أزل ما يسدّ الطريق', 'e.pumpSide': 'لا يمكن التوصيل من هذا الجانب', 'x.pumpSide': 'المضخة تتصل من مقدمتها ومؤخرتها فقط (النقطتان المضيئتان)',
