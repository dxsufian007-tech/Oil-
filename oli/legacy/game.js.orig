      const isTap = !q.moved && !q.sink && !gesture && up && (q.button === 0 || q.type !== 'mouse') && now - q.t0 <= TAP_MAX;
      if (isTap && !(now - lastTap.t < TAP_GAP && Math.hypot(q.x - lastTap.x, q.y - lastTap.y) < 14)) { lastTap = { t: now, x: q.x, y: q.y }; onTap(cellAt(q.x, q.y), q.x, q.y); }
