    const after = s2w(p.x, p.y); cam.x += before.x - after.x; cam.y += before.y - after.y; clampCam();
  }, { passive: false });

  const keys = new Set();
  addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT') return;
    const k = e.key.toLowerCase();
    if (k === 'escape') { backStep(); return; }
    if (k === 'enter') { confirmPending(); return; }
    if (k === 'r') { if (ui.tool === 'pump') ui.pumpFlip = !ui.pumpFlip; else if (selBuilding() && selBuilding().type === 'pump') { game.flipPump(selBuilding()); updatePanel(); } else ui.flip = !ui.flip; return; }
    if (k === 'd' && e.shiftKey) { setDebug(!dbg.on); return; }
    const map = { 1: 'select', 2: 'well', 3: 'pipe', 4: 'tank', 5: 'pump', 6: 'explore', 7: 'erase' };
    if (map[k]) { setTool(map[k]); return; }
    if (k === 'm') { openMarket(); return; }
    if (k === '+' || k === '=') cam.z = clamp(cam.z * 1.15, cam.minZoom, cam.maxZoom);
    if (k === '-') cam.z = clamp(cam.z / 1.15, cam.minZoom, cam.maxZoom);
    keys.add(k);
  });
  addEventListener('keyup', e => keys.delete(e.key.toLowerCase()));

  /* ================= Phase 5 polish: easy building, drag-to-pipe, smooth camera, first-game guide ================= */
  // Valid spots for wells / tanks, recomputed only when something that matters changes (not every frame).
  const spotCache = {};
  function getSpots(tool) {
    const key = game.buildings.length + '|' + game.pipeCount() + '|' + game.areas.reduce((n, a) => n + a.st, 0) + '|' + game.s.regions.map(r => +r.unlocked).join('');
    const c = spotCache[tool];
    if (c && c.key === key) return c.list;
    const list = game.validSpots(tool); spotCache[tool] = { key, list }; return list;
  }
  // Tapping near a valid spot moves the building to it, so nobody has to hit the exact tile.
  function snapBuild(tool, cell) {
    if (!cell || !inb(cell.x, cell.y) || game.canPlace(tool, cell.x, cell.y).ok) return cell;
    const p = game.nearestValid(tool, cell.x, cell.y, 3, getSpots(tool));
    return p ? { x: p[0], y: p[1], snapped: true } : cell;
  }
  function cellOrBuilding(cell, sx, sy) {
    if (sx != null) { const pb = pickBuilding(sx, sy); if (pb) return { x: pb.x, y: pb.y }; }
    return cell;
  }
  // Pipe start: a well, tank or pipe (or the tile beside one); pipe end: snaps onto a nearby well, tank or pipe.
  function snapPipeStart(cell, sx, sy) {
    cell = cellOrBuilding(cell, sx, sy);
    if (!inb(cell.x, cell.y)) return null;
    if (game.isAnchor(cell.x, cell.y)) return cell;
    const a = game.nearestAnchor(cell.x, cell.y, 2); return a ? { x: a[0], y: a[1], snapped: true } : null;
  }
  function snapPipeEnd(cell, sx, sy) {
    cell = cellOrBuilding(cell, sx, sy);
    if (!inb(cell.x, cell.y) || game.isAnchor(cell.x, cell.y) || !ui.pipeStart) return cell;
    const a = game.nearestAnchor(cell.x, cell.y, 2);
    if (!a) return cell;
    const st = ui.pipeStart, sb = game.occ[idx(st.x, st.y)];
    if ((sb && game.occ[idx(a[0], a[1])] === sb) || Math.hypot(a[0] - st.x, a[1] - st.y) < 2) return cell;   // never snap back onto where the pipe started
    return { x: a[0], y: a[1], snapped: true };
  }
  function dragStart(sx, sy, touch) {
    const cell = cellOrBuilding(cellAt(sx, sy), sx, sy);
    if (!inb(cell.x, cell.y)) return null;
    const k = idx(cell.x, cell.y);
    if (game.occ[k] || game.pipe[k] || game.isAnchor(cell.x, cell.y)) return cell;
    if (touch) { const a = game.nearestAnchor(cell.x, cell.y, 2); if (a) return { x: a[0], y: a[1], snapped: true }; }      // fingers are fat: the start snaps to the nearest well, tank or pipe
    return null;
  }
  function finishPipeDrag(ok) {
    ui.pipeDragging = false;
    if (!ok || !ui.pending || !ui.pipeStart || (ui.pending.x === ui.pipeStart.x && ui.pending.y === ui.pipeStart.y)) { cancelAction(); return; }
    if (!needConfirm()) placePipe(ui.pending); else updateConfirm();
  }

  /* smooth camera: glide to an object instead of jumping */
  const camGoal = { on: false, x: 0, y: 0, z: 0, t: 0 };
  function focusOn(wx, wy, opt) {                                  // glide the camera to a world point; opt: { minZoom, force, instant }
    opt = opt || {};
    const narrow = vw < 700, z = Math.max(cam.z, opt.minZoom || .75);
    const p = w2s(wx, wy);
    const inside = p.x > vw * .14 && p.x < vw * .86 && p.y > vh * .16 && p.y < vh * (narrow ? .5 : .78);
    if (inside && !opt.force && cam.z >= (opt.minZoom || .75) - 1e-6) return;
    const g = fitView(wx, wy + (narrow ? vh * .17 : vh * .05) / z, z);   // the goal is always a legal camera, so the glide really ends
    if (opt.instant) { cam.x = g.x; cam.y = g.y; cam.z = g.z; camGoal.on = false; return; }
    camGoal.on = true; camGoal.x = g.x; camGoal.y = g.y; camGoal.z = g.z; camGoal.t = 0;
  }
  function stepCamera(real) {
    if (!camGoal.on) return;
    const k = 1 - Math.exp(-Math.min(real, .034) * 5.5);   // capped step: a slow frame never turns the glide into a jump
    const px = cam.x, py = cam.y;
    cam.x += (camGoal.x - cam.x) * k; cam.y += (camGoal.y - cam.y) * k; cam.z += (camGoal.z - cam.z) * k; clampCam();
    camGoal.t += real;
    if ((Math.abs(camGoal.x - cam.x) < .6 && Math.abs(camGoal.y - cam.y) < .6 && Math.abs(camGoal.z - cam.z) < .004) || camGoal.t > 2.5 || (Math.abs(px - cam.x) + Math.abs(py - cam.y) < .01 && camGoal.t > .3)) camGoal.on = false;
  }
  function focusSel(s) {
    if (!s) return;
    if (s.kind === 'b') { const b = game.buildings.find(q => q.id === s.id); if (b) { const c = b.type === 'tank' ? [(b.x - b.y) * 32, (b.x + b.y + 2) * 16 - 20] : cc(b.x, b.y); focusOn(c[0], c[1] - (b.type === 'tank' ? 0 : 30)); } }
    else if (s.kind === 'pipe') { const c = cc(s.k % W, (s.k / W) | 0); focusOn(c[0], c[1]); }
    else if (s.kind === 'area') { const a = game.areas.find(q => q.id === s.id); if (a) { const c = cc(a.ax * 4 + 2, a.ay * 4 + 2); focusOn(c[0], c[1]); } }
  }

  /* overlays: valid spots, pipe anchors, coach markers */
  function drawSpots(tool) {
    const list = getSpots(tool), pul = .22 + .1 * Math.sin(tNow * 4), n = game.footprintOf(tool)[1];
    const hw = vw / 2 / cam.z + 70, hh = vh / 2 / cam.z + 70;
    ctx.fillStyle = 'rgba(47,210,122,' + pul.toFixed(3) + ')'; ctx.beginPath();
    for (const p of list) {
      const cx = (p[0] - p[1]) * 32, cy = (p[0] + p[1]) * 16 + 16 * n;
      if (Math.abs(cx - cam.x) > hw || Math.abs(cy - cam.y) > hh) continue;
      const r = tool === 'tank' ? 9 : 22;
      ctx.moveTo(cx, cy - r / 2); ctx.lineTo(cx + r, cy); ctx.lineTo(cx, cy + r / 2); ctx.lineTo(cx - r, cy); ctx.closePath();
    }
    ctx.fill();
  }
  function ringAt(x, y, col, n, pulse) {
    const cx = (x - y) * 32, cy = (x + y) * 16 + 16 * (n || 1), r = (n === 2 ? 66 : 36) * (1 + (pulse ? .1 * Math.sin(tNow * 5) : 0));
    ctx.strokeStyle = col; ctx.lineWidth = 3 / cam.z; ctx.beginPath(); ctx.ellipse(cx, cy, r, r / 2, 0, 0, 6.2832); ctx.stroke();
  }
  function arrowAt(x, y, n) {
    const cx = (x - y) * 32, cy = (x + y) * 16 + 16 * (n || 1) - (n === 2 ? 70 : 60), b = Math.sin(tNow * 5) * 7;
    ctx.fillStyle = '#ffb41f'; ctx.strokeStyle = '#2a1a00'; ctx.lineWidth = 2 / cam.z;
    ctx.beginPath(); ctx.moveTo(cx, cy + b + 20); ctx.lineTo(cx - 13, cy + b); ctx.lineTo(cx - 5, cy + b); ctx.lineTo(cx - 5, cy + b - 16); ctx.lineTo(cx + 5, cy + b - 16); ctx.lineTo(cx + 5, cy + b); ctx.lineTo(cx + 13, cy + b); ctx.closePath(); ctx.fill(); ctx.stroke();
  }
  function drawCoachMarks() {
    if (!coach.step || !coach.marks.length) return;
    for (const m of coach.marks) {
      const pulse = .5 + .3 * Math.sin(tNow * 5);
      footprint(m.n === 2 ? 'tank' : 'well', m.x, m.y, 'rgba(255,180,31,' + (pulse * .3).toFixed(3) + ')', 'rgba(255,180,31,' + (pulse + .3).toFixed(3) + ')');
      ringAt(m.x, m.y, 'rgba(255,200,80,.9)', m.n, true); if (!m.noArrow) arrowAt(m.x, m.y, m.n);
    }
  }

  /* first-game guide: the current step comes from the real game state; finishing the first sale saves tutorialCompleted */
  const coach = { step: null, marks: [], plan: null, spot: null, focused: '' };
  function coachStep() {
    const s = game.s; if (s.tutorialDone) return null;
    const wells = game.buildings.filter(b => b.type === 'well'), tanks = game.buildings.filter(b => b.type === 'tank');
    if (!wells.length) return 'well';
    if (!game.pipeCount()) return 'pipe';
    if (!tanks.length) return 'tank';
    if (game.underConstruction() && !wells.some(w => game.isWellConnected(w))) return 'build';
    if (!wells.some(w => game.isWellConnected(w))) return 'link';
    if (game.oilTotal() < 8) return 'wait';
    return 'sell';
  }
  function coachPlan(well) {   // a tank spot with a free pipe end on the side facing the well, so "drag the pipe" has a real target
    const spots = getSpots('tank').map(p => [p, Math.hypot(p[0] - well.x, p[1] - well.y)]).filter(q => q[1] >= 5 && q[1] <= 11).sort((a, b) => a[1] - b[1]).slice(0, 40);
    for (const [T] of spots) {
      const E = well.x < T[0] ? [T[0] - 1, T[1]] : well.x > T[0] + 1 ? [T[0] + 2, T[1]] : well.y < T[1] ? [T[0], T[1] - 1] : [T[0], T[1] + 2];
      if (!inb(E[0], E[1]) || Math.hypot(E[0] - well.x, E[1] - well.y) < 3) continue;   // far enough that the drag is a real gesture
      const r = game.routePipe(well.x, well.y, E[0], E[1], false);
      if (r.ok && !r.cells.some(c => c[0] >= T[0] && c[0] <= T[0] + 1 && c[1] >= T[1] && c[1] <= T[1] + 1)) return { T, E };
    }
    return null;
  }
  function tankSpotNearPipe(well) {
    let best = null, bd = 1e9;
    for (const p of getSpots('tank')) {
      let adj = false;
      for (let dy = -1; dy <= 2 && !adj; dy++) for (let dx = -1; dx <= 2; dx++) { const inside = dx >= 0 && dx <= 1 && dy >= 0 && dy <= 1; if (!inside && inb(p[0] + dx, p[1] + dy) && game.pipe[idx(p[0] + dx, p[1] + dy)]) { adj = true; break; } }
      const d = Math.hypot(p[0] - well.x, p[1] - well.y);
      if (adj && d < bd) { bd = d; best = p; }
    }
    return best;
  }
  function updateCoach() {
    const el = $('#coach'), step = coachStep();
    $$('.coach-pulse').forEach(b => b.classList.remove('coach-pulse'));
    if (!step) { if (coach.step) { coach.step = null; coach.marks = []; } el.hidden = true; return; }
    const changed = step !== coach.step; coach.step = step; coach.marks = [];
    const wells = game.buildings.filter(b => b.type === 'well'), tanks = game.buildings.filter(b => b.type === 'tank');
    const pulse = sel => { const b = $(sel); if (b) b.classList.add('coach-pulse'); };
    const tool = ui.tool, needTool = n => { if (!ui.menu) pulse('#btn-build'); else if (tool !== n) pulse('[data-tool=' + n + ']'); return tool === n; };
    let num = 1;
    if (step === 'well') {
      num = 1; needTool('well');
      if (!coach.spot || !game.canPlace('well', coach.spot[0], coach.spot[1]).ok) { const c = cellAt(vw / 2, vh / 2); coach.spot = game.nearestValid('well', c.x, c.y, 99, getSpots('well')); }
      if (coach.spot) coach.marks.push({ x: coach.spot[0], y: coach.spot[1], n: 1 });
    } else if (step === 'pipe') {
      num = 2; needTool('pipe');
      const w = wells[0]; coach.plan = coachPlan(w);
      coach.marks.push({ x: w.x, y: w.y, n: 1 });
      if (coach.plan) coach.marks.push({ x: coach.plan.E[0], y: coach.plan.E[1], n: 1, noArrow: true });
    } else if (step === 'tank') {
      num = 3; needTool('tank');
      const T = (coach.plan && game.canPlace('tank', coach.plan.T[0], coach.plan.T[1]).ok && coach.plan.T) || tankSpotNearPipe(wells[0]) || (getSpots('tank')[0]);
      if (T) coach.marks.push({ x: T[0], y: T[1], n: 2 });
    } else if (step === 'link') {
      num = 3; needTool('pipe'); const tk = tanks[0]; coach.marks.push({ x: tk.x, y: tk.y, n: 2 });
    } else if (step === 'build') {
      num = 3; const tk = tanks[0]; coach.marks.push({ x: tk.x, y: tk.y, n: 2, noArrow: true });
    } else if (step === 'wait') {
      num = 4; const tk = tanks[0]; coach.marks.push({ x: tk.x, y: tk.y, n: 2, noArrow: true });
    } else if (step === 'sell') {
      num = 5; if (mk.hidden) pulse('#btn-market'); else pulse('#sp-go');
    }
    el.hidden = !!ui.pending;                         // while a build is waiting for confirmation the bar below says everything needed
    $('#coach .cn').textContent = num + '/5';
    $('#coach .ct').innerHTML = t('co.' + step);
    if (changed || (coach.focused !== step + (coach.marks[0] ? coach.marks[0].x + ',' + coach.marks[0].y : ''))) {
      coach.focused = step + (coach.marks[0] ? coach.marks[0].x + ',' + coach.marks[0].y : '');
      if (coach.marks[0] && ui.ptype) { const m = coach.marks[0], c = cc(m.x, m.y); focusOn(c[0], c[1] - (m.n === 2 ? 10 : 20)); }
    }
  }
  $('#coach .cskip').addEventListener('click', () => { game.s.tutorialDone = true; updateCoach(); updateHint(); toast(t('co.skipped'), 'info'); save(); });

  /* ================= Actions ================= */
  const BUILD_TOOLS = ['well', 'pipe', 'tank', 'pump', 'explore', 'erase'];
  const costOf = (tool, cell) => cell ? game.buildCost(tool, ui.wellKind, cell.x, cell.y) : tool === 'well' ? CFG.WELL_KINDS[ui.wellKind].cost : CFG.COST[tool];
  function toast(msg, kind) {
    const el = document.createElement('div'); el.className = 'toast ' + (kind || 'info'); el.textContent = msg;
    const box = $('#toasts'); box.appendChild(el);
    while (box.children.length > 3) box.removeChild(box.firstChild);
    setTimeout(() => el.remove(), 3100);
  }
  function applyMenu() {
    $('#buildmenu').hidden = !ui.menu;
    $('#btn-build').classList.toggle('open', ui.menu);
    $('#app').classList.toggle('build-open', ui.menu);
    $$('.tool[data-tool]').forEach(b => b.classList.toggle('active', b.dataset.tool === ui.tool));
    $('#kinds').hidden = ui.tool !== 'well';
    $$('#kinds button').forEach(b => b.classList.toggle('on', b.dataset.k === ui.wellKind));
    if (typeof updateCoach === 'function' && coach) updateCoach();
  }
  function setTool(tool) {
    if (tool !== 'select' && ui.tool === 'select' && ui.sel) ui.prevSel = ui.sel;            // remember what was selected before building, so leaving the build tool can give it back
    ui.tool = tool; ui.pipeStart = null; ui.pending = null; ui.erase = null; ui.route = null;
    if (BUILD_TOOLS.includes(tool)) ui.menu = true; else ui.menu = false;
    if (tool !== 'select' && !(tool === 'explore' && ui.sel && ui.sel.kind === 'area')) { ui.sel = null; renderPanel(); }
    cv.className = 'tool-' + tool;
    applyMenu(); updateConfirm(); updateHint();
  }
  function leaveBuild() {                                        // back to normal play: the previous selection (if it still exists) comes back
    const ps = ui.prevSel; ui.prevSel = null; setTool('select');
    if (ps && ps.kind === 'b' && game.buildings.some(b => b.id === ps.id)) { ui.sel = ps; renderPanel(); updateHint(); }   // restored quietly: no camera move
  }
  function toggleBuild() {
    if (ui.menu) return leaveBuild();
    if (ui.sel) ui.prevSel = ui.sel;
    ui.menu = true; ui.sel = null; renderPanel(); applyMenu(); updateHint();
  }
  // Back / Escape: exactly ONE step per press, in a fixed order: a window -> the preview or pipe being drawn -> the build tool -> the selection.
  // In plain play it does nothing (and never closes the game by accident).
  function anyModal() { return !mk.hidden || !$('#settings').hidden || !$('#regions').hidden; }
  function backStep() {
    if (anyModal()) { closeModals(); return 'modal'; }
    if (ui.pending || ui.pipeStart) { cancelAction(); return 'cancel'; }
    if (ui.tool !== 'select' || ui.menu) { leaveBuild(); return 'tool'; }
    if (ui.sel) { select(null); return 'selection'; }
    return 'none';
  }
  try {                                                         // Android hardware Back button / browser back: one sentinel history entry that is re-armed after each press
    history.replaceState({ oli: 0 }, ''); history.pushState({ oli: 1 }, '');
    addEventListener('popstate', () => { backStep(); try { history.pushState({ oli: 1 }, ''); } catch (e) { /* ignore */ } });
  } catch (e) { /* history may be unavailable */ }
  function cancelAction() { pd.on = false; ui.placeDrag = false; ui.pipeStart = null; ui.pending = null; ui.route = null; updateConfirm(); updateHint(); }
  const needConfirm = () => ui.ptype === 'touch' || prefs.confirm;

  function onTap(cell, sx, sy) {
    if (ui.tapGuard && performance.now() < ui.tapGuard) return;           // the touch that confirmed a build must not also select / place something
    const tool = ui.tool;
    if ((tool === 'select' || tool === 'erase') && sx != null) {
      const pb = pickBuilding(sx, sy);
      if (pb) cell = { x: pb.x, y: pb.y };
    }
    if (!inb(cell.x, cell.y)) { if (tool === 'select') select(null); return; }
    if (tool === 'select') {
      const k = idx(cell.x, cell.y), b = game.occ[k];
      if (b) select({ kind: 'b', id: b.id }); else if (game.pipe[k]) select({ kind: 'pipe', k }); else select(null);
    } else if (tool === 'well' || tool === 'tank' || tool === 'pump') {
      cell = snapBuild(tool, cell);
      if (!needConfirm()) return placeBuilding(tool, cell);
      if (ui.pending && ui.pending.x === cell.x && ui.pending.y === cell.y) { if (performance.now() - ui.pendT > CONFIRM_GAP) confirmPending(); return; }   // a fast second tap is a double tap, not a confirm
      if (ui.pending) { gOff.x += ((ui.pending.x - ui.pending.y) - (cell.x - cell.y)) * 32; gOff.y += ((ui.pending.x + ui.pending.y) - (cell.x + cell.y)) * 16; }
      setPending(cell); updateConfirm();
    } else if (tool === 'pipe') {
      if (!ui.pipeStart) { cell = snapPipeStart(cell, sx, sy) || cell; ui.pipeStart = cell; ui.pending = null; toast(game.isAnchor(cell.x, cell.y) ? t('t.pipeEnd') : help('floating'), game.isAnchor(cell.x, cell.y) ? 'info' : 'bad'); updateHint(); updateConfirm(); return; }
      cell = snapPipeEnd(cell, sx, sy);
      if (ui.pipeStart.x === cell.x && ui.pipeStart.y === cell.y && !ui.pending) { cancelAction(); return; }
      if (!needConfirm()) return placePipe(cell);
      if (ui.pending && ui.pending.x === cell.x && ui.pending.y === cell.y) { if (performance.now() - ui.pendT > CONFIRM_GAP) confirmPending(); return; }
      setPending(cell); updateConfirm();
    } else if (tool === 'explore') {
      const a = game.areaAt(cell.x, cell.y);
      if (!a || !a.land) { toast(help('nothing'), 'bad'); return; }
      select({ kind: 'area', id: a.id });
    } else if (tool === 'erase') eraseAt(cell);
  }

  function placeBuilding(type, cell) {
    const r = game.place(type, cell.x, cell.y, ui.wellKind, type === 'pump' ? pumpDirFor(cell) : undefined);
    if (!r.ok) { toast(help(r.reason), 'bad'); updateConfirm(); return; }
    toast(t('t.built', { what: type === 'well' ? t('n.well.' + ui.wellKind) : t('n.' + type), cost: money(r.cost) }), 'good');
    ui.pending = null; refreshHud(true);
    // Phase 21: building finished -> leave Build mode, go to Selection mode and select the new building (its panel + actions open at once)
    ui.prevSel = null; ui.tapGuard = performance.now() + 450; setTool('select');
    if (r.building && r.building.id != null) select({ kind: 'b', id: r.building.id }); else { updateConfirm(); updateHint(); }
  }
  function placePipe(cell) {
    const r = game.buildRoute(game.routePipe(ui.pipeStart.x, ui.pipeStart.y, cell.x, cell.y, ui.flip));
    if (!r.ok) { toast(help(r.reason), 'bad'); return; }
    toast(t('t.pipe', { n: r.segments, cost: money(r.cost) }), 'good');
    ui.pipeStart = null; ui.pending = null; ui.route = null; updateConfirm(); updateHint(); refreshHud(true);
  }
  function confirmPending() {
    if (!ui.pending) return;
    if (ui.tool === 'pipe') placePipe(ui.pending); else placeBuilding(ui.tool, ui.pending);
  }
  function eraseAt(cell) {
    const k = idx(cell.x, cell.y), b = game.occ[k];
    if (!b && !game.pipe[k]) return;
    if (b && b.type === 'tank' && b.amt >= 50) {
      if (!ui.erase || ui.erase !== b.id) { ui.erase = b.id; toast(t('t.tankHolds', { n: num(b.amt) }), 'info'); return; }
    }
    ui.erase = null;
    const r = game.removeAt(cell.x, cell.y);
    if (r.ok) { toast(t('t.removed', { n: money(r.refund) }), 'info'); refreshHud(true); }
  }

  /* ================= Selection panel ================= */
  const panel = $('#panel');
  const DOT = { building: 'warn', producing: '', limited: 'warn', full: 'bad', nopipe: 'bad', nostorage: 'bad', idle: 'warn', broken: 'bad', depleted: 'bad' };
  function select(s) { ui.sel = s; ui.removeArm = 0; renderPanel(); updateHint(); focusSel(s); }
  const tankNo = t2 => game.buildings.filter(q => q.type === 'tank').indexOf(t2) + 1;
  function selBuilding() { return ui.sel && ui.sel.kind === 'b' ? game.buildings.find(b => b.id === ui.sel.id) : null; }
  const pct = v => Math.round(v * 100) + '%';
  function setBar(id, f, cls) { const el = $('#' + id + '-bar'); if (!el) return; el.style.width = clamp(f, 0, 1) * 100 + '%'; if (el.className !== cls) el.className = cls; }
  const good = (f, lo, bad) => f > lo ? '' : f > bad ? 'warn' : 'bad';
  const leaksOf = c => c ? c.pipes.filter(p => game.pipeSt[p] === 1) : [];

  function renderPanel() {
    const s = ui.sel;
    if (!s) { panel.hidden = true; panel.innerHTML = ''; return; }
    const b = selBuilding();
    if (s.kind === 'b' && !b) { panel.hidden = true; ui.sel = null; return; }
    const head = (title, lv) => '<div class="ph"><h3>' + title + (lv ? '<small>' + t('level', { n: lv }) + '</small>' : '') + '</h3><button class="x" data-act="close" type="button" aria-label="' + t('close') + '"><svg class="ic"><use href="#i-close"/></svg></button></div>';
    const row = (icon, label, id) => '<li><svg class="ic"><use href="#i-' + icon + '"/></svg><div><small>' + label + '</small><b id="' + id + '"></b></div></li>';
    const mrow = (label, id) => '<li><div style="flex:1"><small>' + label + '</small><div class="mini-meter"><div class="meter"><i id="' + id + '-bar"></i></div><b id="' + id + '"></b></div></div></li>';
    const btn = (cls, act, id) => '<button class="btn ' + cls + '" data-act="' + act + '" id="' + id + '" type="button"></button>';
    const moreBtn = '<li class="morebtn"><button type="button" data-act="more">' + t(ui.more ? 'p.less' : 'p.more') + '</button></li>', sec = x => x.replace(/<li>/g, '<li class="sec">');
    let html = '';
    if (s.kind === 'b' && b.type === 'well') {
      html = head(t('n.well.' + b.kind), b.level) +
        '<ul class="rows' + (ui.more ? ' more' : '') + '">' + row('drop', t('p.prod'), 'p-rate') +
        '<li><span class="dot" id="p-dot"></span><div><small>' + t('p.status') + '</small><b id="p-status"></b></div></li>' +
        '<li class="wide"><svg class="ic"><use href="#i-pipe"/></svg><div><small>' + t('p.net') + '</small><b id="p-net"></b></div></li>' +
        mrow(t('p.pressure'), 'p-pres') + mrow(t('p.cond'), 'p-cond') + moreBtn + sec(row('drop', t('p.quality'), 'p-qual') + row('market', t('p.reserve'), 'p-res') + row('gear', t('p.resP'), 'p-rp') + row('gear', t('p.whP'), 'p-wp') + row('gear', t('p.pumpHelp'), 'p-ph') + row('pipe', t('p.limit'), 'p-lim')) + '</ul>' +
        '<div class="pbtns">' + btn('blue', 'upgrade', 'p-up') + btn('orange', 'maint', 'p-mt') + btn('ghost wide', 'remove', 'p-rm') + '</div>';
    } else if (s.kind === 'b' && b.type === 'pump') {
      html = head(t('p.pump'), b.level) +
        '<ul class="rows' + (ui.more ? ' more' : '') + '">' +
        '<li><span class="dot" id="p-dot"></span><div><small>' + t('p.status') + '</small><b id="p-status"></b></div></li>' + row('gear', t('p.boost'), 'p-boost') +
        row('drop', t('p.pflow'), 'p-pflow') + row('pipe', t('p.dir'), 'p-pdir') + moreBtn +
        sec(row('gear', t('p.pin'), 'p-pin') + row('gear', t('p.pout'), 'p-pout') + row('cash', t('p.power'), 'p-power') + row('market', t('p.eff'), 'p-eff')) + '</ul>' +
        '<div class="pbtns">' + btn('green', 'pumpToggle', 'p-pt') + btn('ghost', 'pumpFlip', 'p-pf') + btn('blue', 'upgrade', 'p-up') + btn('ghost wide', 'remove', 'p-rm') + '</div>';
    } else if (s.kind === 'b') {
      html = head(t('p.tank'), b.level) +
        '<ul class="rows">' + row('drop', t('p.amount'), 'p-amt') + row('tank', t('p.cap'), 'p-cap') + row('drop', t('p.quality'), 'p-qual') +
        '<li><div style="flex:1"><small>' + t('p.fill') + ' · ' + t('p.back') + '</small><div style="display:flex;align-items:center;gap:10px;margin-top:4px"><div class="meter"><i id="p-bar"></i></div><b id="p-pct"></b></div></div></li>' +
        row('pipe', t('p.inflow'), 'p-in') + '<li class="wide"><svg class="ic"><use href="#i-well"/></svg><div><small>' + t('p.srcs') + '</small><b id="p-src"></b></div></li></ul>' +
        '<div class="pbtns">' + btn('blue', 'upgrade', 'p-up') + btn('ghost', 'remove', 'p-rm') +
        '<button class="btn green wide" data-act="market" type="button">' + t('p.openMarket') + '</button></div>';
    } else if (s.kind === 'pipe') {
      const c = game.pipeNet(s.k);
      html = head(t('p.pipe'), c ? c.level : 1) +
        '<ul class="rows' + (ui.more ? ' more' : '') + '">' + '<li class="wide"><span class="dot" id="p-dot2"></span><div><small>' + t('p.net') + '</small><b id="p-net"></b></div></li>' + row('drop', t('p.flow'), 'p-flow') + row('pipe', t('p.segs'), 'p-seg') + row('pipe', t('p.node'), 'p-node') +
        mrow(t('p.pipeCond'), 'p-cond') + moreBtn + sec(row('market', t('p.tcap'), 'p-tcap') + row('drop', t('p.lost'), 'p-lost') + row('gear', t('p.prs'), 'p-prs') + row('drop', t('p.vel'), 'p-vel') + row('gear', t('p.loss'), 'p-loss')) +
        '<li><span class="dot" id="p-dot"></span><div><small>' + t('p.leakState') + '</small><b id="p-leak"></b></div></li></ul>' +
        '<div class="pbtns">' + btn('blue', 'upgrade', 'p-up') + btn('orange', 'repair', 'p-rp') + btn('ghost', 'valve', 'p-vl') + btn('ghost', 'remove', 'p-rm') + btn('ghost wide', 'removeBranch', 'p-rb') + '</div>';
    } else {
      const a = game.areas[s.id]; s.last = a.st;
      const lk = !game.regionOpen(a.region);
      html = head(t('a.title')) +
        '<ul class="rows"><li><span class="dot" id="p-dot"></span><div><small>' + t('a.region') + '</small><b>' + t('r.' + a.region) + '</b></div></li><li><div><small>' + t('a.status') + '</small><b id="a-st"></b></div></li>' +
        (a.st === 2 ? row('drop', t('a.res'), 'a-kind') + row('market', t('a.size'), 'a-size') + row('market', t('a.left'), 'a-left') + row('drop', t('p.quality'), 'a-q') + row('drop', t('a.pot'), 'a-pot') + row('well', t('a.wells'), 'a-wells') : '') + '</ul>' +
        (lk ? '<p class="note">' + t('a.locked') + '</p>' : a.st === 0 ? '<p class="note">' + t('a.hidden') + '</p>' : a.kind === 'empty' && a.st === 2 ? '<p class="note">' + t('a.emptyNote') + '</p>' : '') +
        '<div class="pbtns">' + (lk ? btn('orange wide', 'regions', 'a-rg') : a.st === 0 ? btn('orange wide', 'explore', 'a-ex') : a.st === 2 && a.kind !== 'empty' && a.remaining > 0 ? btn('green wide', 'abuild', 'a-bd') : '') + '</div>';
    }
    panel.innerHTML = html; panel.hidden = false;
    updatePanel();
  }
  function setText(id, v) { const el = $('#' + id); if (el && el.textContent !== v) el.textContent = v; }
  function setBtn(el, txt, off) { if (!el) return; if (el.textContent !== txt) el.textContent = txt; if (el.disabled !== !!off) el.disabled = !!off; }
  function updatePanel() {
    const s = ui.sel; if (!s || panel.hidden) return;
    const b = selBuilding(), rm = $('#p-rm'), cash = game.s.cash;
    if (s.kind === 'b' && !b) { select(null); return; }
    if (s.kind === 'area') {
      const a = game.areas[s.id];
      if (s.last !== a.st) return renderPanel();
      const inf = game.areaInfo(a);
      setText('a-st', inf.state === 'exploring' ? t('a.s.exploring', { n: Math.round(inf.progress * 100) }) : t('a.s.' + inf.state));
      const dot = $('#p-dot'); if (dot) dot.className = 'dot ' + (a.st === 2 ? '' : 'warn');
      if (a.st === 2) {
        setText('a-kind', t('a.k.' + a.kind)); setText('a-size', num(inf.reserveSize) + ' ' + t('bbl')); setText('a-left', num(inf.remaining) + ' ' + t('bbl'));
        setText('a-q', t('q.' + a.quality)); setText('a-pot', num(inf.productionPotential) + ' ' + t('perMin')); setText('a-wells', String(inf.wells));
      }
      setBtn($('#a-ex'), a.st === 1 ? t('a.s.exploring', { n: Math.round(inf.progress * 100) }) : t('a.explore', { cost: money(game.exploreCost(a)) }), a.st !== 0 || cash < game.exploreCost(a));
      setBtn($('#a-rg'), t('a.openRegions'), false);
      setBtn($('#a-bd'), t('a.build'), false);
      return;
    }
    let maxed, cost;
    if (s.kind === 'b' && b.type === 'well') {
      const nom = game.wellNominal(b), out = b.out || 0, ar = game.areas[b.area];
      setText('p-rate', out.toFixed(1) + ' ' + t('perMin') + ' · ' + t('p.nominal', { n: nom.toFixed(1) }));
      setText('p-status', t('st.' + (b.status || 'idle'))); $('#p-dot').className = 'dot ' + (DOT[b.status] || 'warn');
      setText('p-pres', pct(b.pressure)); setBar('p-pres', b.pressure, good(b.pressure, .5, .25));
      setText('p-cond', pct(b.condition)); setBar('p-cond', b.condition, good(b.condition, .6, .3));
      setText('p-qual', t('q.' + b.quality)); setText('p-res', ar ? num(ar.remaining) + ' ' + t('bbl') : '—');
      const wn = game.wellNet(b);
      setText('p-net', wn.why === 'building' ? t('nw.building', { n: Math.round(wn.progress * 100) }) : wn.connected && wn.target ? t('nw.to', { n: tankNo(wn.target), len: wn.pathTiles }) + (wn.why === 'limited' ? ' · ' + t('nw.limited', { cap: num(CFG.PIPE.CAP[Math.max(1, ...game.net.comps[game.net.compOf[idx(b.x, b.y)]].pipes.map(k => game.pipeLvl[k])) - 1]) }) : '') : t('nw.' + (wn.why === 'full' ? 'full' : wn.connected ? 'full' : b.status === 'nopipe' ? 'nopipe' : b.status === 'broken' || b.status === 'depleted' ? b.status : 'nostorage')));
      const wh = game.wellHyd(b);
      setText('p-rp', wh.reservoirPressure.toFixed(1) + ' ' + t('u.bar')); setText('p-wp', wh.wellHeadPressure.toFixed(1) + ' ' + t('u.bar') + (wh.transient > .05 ? ' · ' + t('p.transient') + ' +' + wh.transient.toFixed(1) : ''));
      setText('p-ph', wh.pumpContribution > .05 ? '+' + wh.pumpContribution.toFixed(1) + ' ' + t('u.bar') : '—'); setText('p-lim', wh.limit && out < nom * .995 ? t('lim.' + wh.limit) : t('lim.none'));
      const mc = game.maintenanceCost(b), mgood = b.condition >= .999;
      setBtn($('#p-mt'), mgood ? t('p.maintGood') : t('p.maintBtn', { cost: money(mc) }), mgood || cash < mc);
      maxed = b.level >= CFG.MAX_LEVEL; cost = game.upgradeCost(b);
    } else if (s.kind === 'b' && b.type === 'pump') {
      const pn = game.pumpNet(b);
      setText('p-status', t('ps.' + pn.status)); $('#p-dot').className = 'dot ' + (pn.status === 'running' ? '' : pn.status === 'noInput' || pn.status === 'noOutput' ? 'bad' : 'warn');
      setText('p-boost', pn.boost.toFixed(1) + ' ' + t('u.bar') + ' / ' + pn.boostMax.toFixed(0));
      setText('p-pflow', pn.flow.toFixed(1) + ' / ' + num(pn.maxFlow) + ' ' + t('perMin'));
      setText('p-pdir', t('p.inout'));
      setText('p-pin', pn.pIn.toFixed(1) + ' ' + t('u.bar')); setText('p-pout', pn.pOut.toFixed(1) + ' ' + t('u.bar'));
      setText('p-power', t('p.powerV', { kw: pn.kw.toFixed(1), cost: money(pn.costMin) })); setText('p-eff', pct(pn.efficiency));
      setBtn($('#p-pt'), pn.enabled ? t('p.pumpOff') : t('p.pumpOn'), !pn.ready);
      setBtn($('#p-pf'), t('p.flipPump'), false);
      maxed = b.level >= game.maxLevel(b); cost = game.upgradeCost(b);
    } else if (s.kind === 'b') {
      const cap = game.tankCap(b), f = clamp(b.amt / cap, 0, 1);
      setText('p-amt', num(b.amt) + ' ' + t('bbl')); setText('p-cap', num(cap) + ' ' + t('bbl')); setText('p-pct', Math.round(f * 100) + '% · ' + game.tankHyd(b).backPressure.toFixed(1) + ' ' + t('u.bar'));
      setText('p-qual', b.amt > 0 ? '×' + (b.qm || 1).toFixed(2) : '—');
      const tn = game.tankNet(b);
      setText('p-in', tn.ready ? tn.inflow.toFixed(1) + ' ' + t('perMin') : t('nw.building', { n: Math.round(tn.progress * 100) }));
      
      setText('p-src', tn.linked.length ? t('nw.srcs', { a: tn.feeding.length, b: tn.linked.length }) : t('nw.nosrc'));
      const bar = $('#p-bar'); bar.style.width = f * 100 + '%'; bar.className = f > .95 ? 'full' : f > .75 ? 'warn' : '';
      maxed = b.level >= CFG.MAX_LEVEL; cost = game.upgradeCost(b);
    } else {
      const c = game.pipeNet(s.k);
      if (!c || !game.pipe[s.k]) { select(null); return; }
      const dt = Math.max(game.lastDt || 1, .001), st = game.pipeSt[s.k], nl = leaksOf(c).length;
      const ps = game.pipeStat(s.k);
      setText('p-seg', num(c.pipes.length)); setText('p-tcap', num(c.cap) + ' ' + t('perMin'));
      { const nd = game.graphNode(s.k), sg = game.graphSegment(s.k), br = game.branchOf(s.k), rb = $('#p-rb');           // what this tile is in the network graph
        setText('p-node', nd ? (nd.kind === 'junction' ? t('nd.junction', { n: nd.edges.length }) : t('nd.end')) : sg ? t('nd.seg', { n: sg.len }) : t('nd.seg0'));
        if (rb) { setBtn(rb, br ? t('p.removeBranchN', { n: br.tiles.length }) : t('p.removeBranch'), !br); rb.hidden = !br; } }
      setText('p-flow', ps.flow.toFixed(1) + ' / ' + num(ps.cap) + ' ' + t('perMin'));
      setText('p-net', ps.issue ? t('pi.' + ps.issue) : ps.from && ps.to ? t('pi.ok', { n: tankNo(ps.to) }) : t('pi.ok2'));
      const d2 = $('#p-dot2'); if (d2) d2.className = 'dot ' + (ps.issue === 'noTank' || ps.issue === 'noWell' || ps.issue === 'leak' ? 'bad' : ps.issue ? 'warn' : '');
      setText('p-lost', ((c.ext - c.flow) / dt * 60).toFixed(1) + ' ' + t('perMin'));
      const pe = game.pipeEdge(s.k);
      setText('p-prs', pe.pressure.toFixed(1) + ' ' + t('u.bar')); setText('p-vel', pe.velocity.toFixed(2) + ' ' + t('u.ms')); setText('p-loss', pe.drop.toFixed(2) + ' ' + t('u.bar'));
      { const vs = game.valve[s.k], nx = vs === 0 ? 1 : vs === 1 ? 2 : vs === 2 ? 3 : 0; setBtn($('#p-vl'), vs ? t('p.valveNext', { a: t('v.' + vs), b: t('v.' + nx) }) : t('p.valveNext', { a: t('v.0'), b: t('v.1') }) + ' ' + money(CFG.COST.valve), false); }
      setText('p-cond', pct(game.pipeCond[s.k])); setBar('p-cond', game.pipeCond[s.k], good(game.pipeCond[s.k], .6, .3));
      setText('p-leak', t('ls.' + st) + (st === 0 && nl ? ' · ' + t('p.leaks') + ' ' + nl : ''));
      $('#p-dot').className = 'dot ' + (st === 1 ? 'bad' : st === 2 ? 'warn' : nl ? 'warn' : '');
      const target = st === 1 ? s.k : leaksOf(c)[0], rcost = target != null ? game.repairCost(target) : 0;
      setBtn($('#p-rp'), st === 2 ? t('p.repairing') : target == null ? t('p.noLeak') : t('p.repair', { cost: money(rcost) }), st === 2 || target == null || cash < rcost);
      const info = game.pipeUpgradeInfo(s.k); maxed = !info || info.maxed; cost = info ? info.cost : 0;
    }
    const up = $('#p-up');
    setBtn(up, maxed ? t('p.max') : (s.kind === 'pipe' ? t('p.upgradePipes') : t('p.upgrade')) + ' ' + money(cost), maxed || cash < cost);
    if (rm) {
      const warn = s.kind === 'b' && b.type === 'tank' && b.amt >= 50 && ui.removeArm;
      const t2 = warn ? t('p.sure', { n: num(b.amt) }) : (s.kind === 'pipe' ? t('p.removeSeg') : t('p.remove'));
      if (rm.textContent !== t2) rm.textContent = t2;
    }
  }
  panel.addEventListener('click', e => {
    const btn = e.target.closest('[data-act]'); if (!btn) return;
    const a = btn.dataset.act, s = ui.sel, b = selBuilding();
    if (a === 'close') select(null);
    else if (a === 'more') { ui.more = !ui.more; renderPanel(); }
    else if (a === 'market') openMarket();
    else if (a === 'upgrade') {
      const r = s.kind === 'b' ? game.upgrade(b) : game.upgradePipes(s.k);
      if (!r.ok) toast(help(r.reason), 'bad'); else toast(t('t.upgradedTo', { n: r.level, cost: money(r.cost) }), 'good');
      renderPanel(); refreshHud(true);
    } else if (a === 'pumpToggle') {
      const r = game.setPumpEnabled(b, !b.enabled); toast(t(r.enabled ? 't.pumpOn' : 't.pumpOff'), 'info'); updatePanel();
    } else if (a === 'pumpFlip') {
      game.flipPump(b); updatePanel();
    } else if (a === 'valve') {
      const vs = game.valve[s.k], nx = vs === 0 ? 1 : vs === 1 ? 2 : vs === 2 ? 3 : 0, r = game.setValve(s.k, nx);
      if (!r.ok) toast(help(r.reason), 'bad'); else toast(t('t.valve', { a: t('v.' + nx) }), 'info');
      updatePanel(); refreshHud(true);
    } else if (a === 'maint') {
      const r = game.maintain(b);
      if (!r.ok) toast(help(r.reason), 'bad'); else toast(t('t.maint', { cost: money(r.cost) }), 'good');
      updatePanel(); refreshHud(true);
    } else if (a === 'repair') {
      const c = game.pipeNet(s.k), k = game.pipeSt[s.k] === 1 ? s.k : leaksOf(c)[0];
      if (k == null) { toast(help('noleak'), 'bad'); return; }
      const r = game.repairPipe(k);
      if (!r.ok) toast(help(r.reason), 'bad'); else { toast(t('t.repairStart', { cost: money(r.cost) }), 'good'); ui.sel = { kind: 'pipe', k }; }
      updatePanel(); refreshHud(true);
    } else if (a === 'regions') { openRegions();
    } else if (a === 'explore') {
      const r = game.explore(s.id);
      if (!r.ok) toast(help(r.reason), 'bad'); else toast(t('t.exploreStart', { cost: money(r.cost) }), 'info');
      renderPanel(); refreshHud(true);
    } else if (a === 'abuild') {
      select(null); setTool('well');
    } else if (a === 'removeBranch') {
      if (s.kind !== 'pipe') return;
      const r = game.removeBranch(s.k % W, (s.k / W) | 0);
      if (!r.ok) { toast(help(r.reason || 'nothing'), 'bad'); return; }
      toast(t('t.removedBranch', { n: r.tiles, refund: money(r.refund) }) + (r.simplified.length ? ' · ' + t('t.simplified') : ''), 'info'); select(null); refreshHud(true);
    } else if (a === 'remove') {
      if (s.kind === 'b') {
        if (b.type === 'tank' && b.amt >= 50 && !ui.removeArm) { ui.removeArm = 1; updatePanel(); return; }
        const r = game.removeAt(b.x, b.y); toast(t('t.removed', { n: money(r.refund) }), 'info');
      } else { const r = game.removeAt(s.k % W, (s.k / W) | 0); toast(t('t.removed', { n: money(r.refund) }), 'info'); }
      select(null); refreshHud(true);
    }
  });

  /* ================= Confirm bar + hint ================= */
  function updateConfirm() {
    const box = $('#confirm'), p = ui.pending;
    if (!p) { if (!box.hidden) box.hidden = true; return; }
    if (box.hidden) box.hidden = false;
    let txt, ok, state = 'VALID';
    if (ui.tool === 'pipe') {
      const r = game.routePipe(ui.pipeStart.x, ui.pipeStart.y, p.x, p.y, ui.flip);
      ok = r.ok && game.s.cash >= r.cost; state = !r.ok ? 'INVALID' : ok ? 'VALID' : 'UNAFFORDABLE';
      txt = !r.ok ? help(r.reason) : game.s.cash < r.cost ? t('noCash') : t('c.pipe', { cost: money(r.cost) });
    } else {
      const pl = game.placement(ui.tool, p.x, p.y, ui.wellKind); state = pl.state;
      ok = pl.ok;
      txt = pl.state === 'INVALID' ? help(pl.reason) : pl.state === 'UNAFFORDABLE' ? t('noCash') : t('c.' + ui.tool, { cost: money(pl.cost) }) + ' · ' + t('tr.' + CFG.TERRAIN.NAMES[game.terrainAt(p.x, p.y)]);
    }
    const okB = $('#confirm-ok'), tx = $('#confirm-text'), fl = $('#confirm-flip'), hint = $('#hint'), showFlip = ui.tool === 'pipe' || ui.tool === 'pump';   // write the DOM only when something changed
    if (okB.disabled !== !ok) okB.disabled = !ok;
    if (box.dataset.state !== state) box.dataset.state = state;              // valid / invalid / unaffordable: the bar says it with colour too
    if (tx.textContent !== txt) tx.textContent = txt;
    if (fl.hidden === showFlip) fl.hidden = !showFlip;
    if (!hint.hidden) hint.hidden = true;
  }
  let lastConfirm = 0;
  $('#confirm-ok').addEventListener('click', () => { const n = performance.now(); if (n - lastConfirm < 350) return; lastConfirm = n; confirmPending(); });   // one press = one build, however fast the second press comes
  $('#confirm-no').addEventListener('click', cancelAction);
  $('#confirm-flip').addEventListener('click', () => { if (ui.tool === 'pump') ui.pumpFlip = !ui.pumpFlip; else ui.flip = !ui.flip; updateConfirm(); });

  function nextStep() {
    const wells = game.buildings.filter(b => b.type === 'well'), tanks = game.buildings.filter(b => b.type === 'tank');
    if (!wells.length) return t('h.n1');
    if (!tanks.length) return t('h.n2');
    if (!wells.some(w => game.isWellConnected(w))) return t('h.n3');
    if (game.oilTotal() >= 100) return t('h.n4', { n: num(game.oilTotal()) });
    return t('h.n5');
  }
  function updateHint() {
    const h = $('#hint');
    h.hidden = !!ui.pending || !panel.hidden || !!coach.step;
    const tool = ui.tool;
    let s;
    if (tool === 'well') s = t('h.well', { cost: t('k.' + ui.wellKind) + ' ' + money(CFG.WELL_KINDS[ui.wellKind].cost) });
    else if (tool === 'explore') s = t('h.explore', { cost: money(CFG.REGIONS[0].explore) + '+' });
    else if (tool === 'tank') s = t('h.tank', { cost: money(CFG.COST.tank) });
    else if (tool === 'pump') s = t('h.pump', { cost: money(CFG.COST.pump) });
    else if (tool === 'pipe') s = ui.pipeStart ? t('h.pipe2') : t('h.pipe1');
    else if (tool === 'erase') s = t('h.erase');
    else s = ui.menu ? t('h.build') : nextStep();
    if (h.dataset.s !== s) { h.innerHTML = s; h.dataset.s = s; }
  }


  /* ---- Development debug mode (open the page with #debug, or press Shift+D): node pressure, losses, flow, capacity, bottleneck, pumps ---- */
  const dbg = { on: false, el: null };
  function setDebug(on) {
    dbg.on = on; try { localStorage.setItem('oli.debug', on ? '1' : '0'); } catch (e) {}
    if (on && !dbg.el) { const d = document.createElement('pre'); d.id = 'dbg'; document.body.appendChild(d); dbg.el = d; }
    if (dbg.el) dbg.el.hidden = !on;
    if (on) updateDebug();
  }
  function updateDebug() {
    if (!dbg.on || !dbg.el) return;
    const d = game.debugSnapshot(), L = ['HYDRAULICS  solves ' + d.solves + '  iter ' + d.iterations + '  ' + (d.converged ? 'converged' : 'NOT converged') + '  err ' + (d.maxError || 0).toExponential(1) + '  warn ' + d.warnings];
    L.push('NETWORK  ' + (d.problems.length ? d.problems.length + ' PROBLEM(S): ' + d.problems.slice(0, 3).join(' | ') : 'graph valid'));
    if (d.graph) L.push('GRAPH  nodes ' + d.graph.nodes + '  segments ' + d.graph.segments + '  junctions ' + d.graph.junctions + (d.graph.list.length ? ' [' + d.graph.list.slice(0, 6).map(j => j.id + ':' + j.branches).join(' ') + ']' : '') + '  ends ' + d.graph.ends + '  orphans ' + d.graph.orphans);
    for (const p of d.plans) L.push('well ' + p.well + ' -> tank ' + p.tank + '  ' + p.tiles + ' tiles  Pres ' + p.reservoir.toFixed(1) + '  need ' + (p.preq || 0).toFixed(1) + '  head ' + (p.wellHead || 0).toFixed(1) + ' bar  Qt ' + p.qt.toFixed(1) + '  Q ' + p.q.toFixed(1) + (p.lim ? '  limit:' + p.lim : '') + (p.bottleneck >= 0 ? '  bottleneck@' + (p.bottleneck % W) + ',' + ((p.bottleneck / W) | 0) : ''));
    for (const p of d.pumps) L.push('pump ' + p.id + '  head ' + (p.head || 0).toFixed(1) + ' bar  flow ' + p.flow.toFixed(1) + '  ' + p.kw.toFixed(1) + ' kW  spin ' + p.spin.toFixed(2));
    for (const t2 of game.buildings) if (t2.type === 'tank') L.push('tank ' + t2.id + '  fill ' + Math.round(t2.amt / game.tankCap(t2) * 100) + '%  back-pressure ' + game.tankHyd(t2).backPressure.toFixed(1) + ' bar');
    if (ui.hover && inb(ui.hover.x, ui.hover.y)) { const k = idx(ui.hover.x, ui.hover.y); if (game.pipe[k]) { const td = game.tileDebug(k); if (td) L.push('node ' + (td.node || '-') + ' (' + td.nodeKind + ')  branches ' + td.branches + '  edges ' + (td.edges.join(',') || '-') + '  segment ' + (td.segment || '-') + (td.segment ? ' ' + td.from + '->' + td.to + ' ' + td.segTiles + ' tiles' : '') + '  net ' + td.comp + '  links ' + td.links + '  ' + (td.live ? (td.connected ? 'connected' : 'NOT connected') : 'under construction')); const e = game.pipeEdge(k); L.push('tile ' + ui.hover.x + ',' + ui.hover.y + '  P ' + e.pressure.toFixed(2) + ' bar  loss ' + e.drop.toFixed(3) + '  Q ' + e.flow.toFixed(1) + '/' + e.capacity + '  v ' + e.velocity.toFixed(2) + ' m/s  Re ' + e.reynolds.toFixed(0) + '  f ' + e.friction.toFixed(4) + (e.valve ? '  valve ' + e.valve + ' @' + e.valvePos.toFixed(2) : '')); } }
    const txt = L.join('\n'); if (dbg.el.textContent !== txt) dbg.el.textContent = txt;
  }
  try { if (/debug/.test(location.hash) || localStorage.getItem('oli.debug') === '1') setDebug(true); } catch (e) { if (/debug/.test(location.hash)) setDebug(true); }

  /* ================= HUD ================= */
  let lastPrice = 0, priceDir = 0, lastTgt = null;
  const hud = { cash: game.s.cash, oil: game.oilTotal(), lastCash: game.s.cash, lastOil: game.oilTotal(), pend: 0, pendT: 0, oilPend: 0, oilT: 0, txt: {} };
  const flash = (el, cls) => { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); };
  function floater(el, text, kind) {
    const host = $('#app'); if (host.querySelectorAll('.floater').length > 4) return;
    const r = el.getBoundingClientRect(), f = document.createElement('div');
    f.className = 'floater ' + kind; f.textContent = text;
    f.style.left = (r.left + r.width / 2) + 'px'; f.style.top = (r.bottom + 2) + 'px';
    const rm = () => f.remove(); f.addEventListener('animationend', rm, { once: true }); setTimeout(rm, 1800);
    host.appendChild(f);
  }
  // Per-frame HUD: numbers count smoothly toward the real values, and changes get a short flash.
  function hudFrame(real) {
    const s = game.s, oilNow = game.oilTotal();
    if (s.cash !== hud.lastCash) { hud.pend += s.cash - hud.lastCash; hud.pendT = .12; hud.lastCash = s.cash; }
    if (hud.pend !== 0 && (hud.pendT -= real) <= 0) {
      const d = hud.pend; hud.pend = 0;
      if (Math.abs(d) >= 1) { const el = $('#st-cash'); flash(el, d > 0 ? 'gain' : 'loss'); floater(el, (d > 0 ? '+' : '−') + money(Math.abs(d)), d > 0 ? 'good' : 'bad'); }
    }
    if (oilNow < hud.lastOil - 1) { hud.oilPend += hud.lastOil - oilNow; hud.oilT = .12; }
    hud.lastOil = oilNow;
    if (hud.oilPend > 0 && (hud.oilT -= real) <= 0) {
      const d = hud.oilPend; hud.oilPend = 0;
      if (d >= 2) { const el = $('#st-oil'); flash(el, 'loss'); floater(el, '−' + num(d) + ' ' + t('bbl'), 'oil'); }
    }
    const k = Math.min(1, real * 7);
    hud.cash += (s.cash - hud.cash) * k; if (Math.abs(s.cash - hud.cash) < .5) hud.cash = s.cash;
    hud.oil += (oilNow - hud.oil) * k; if (Math.abs(oilNow - hud.oil) < .05) hud.oil = oilNow;
    setText('v-cash', money(hud.cash));
    const oilEl = $('#v-oil'), ot = num(hud.oil) + ' '; if (oilEl.firstChild.textContent !== ot) oilEl.firstChild.textContent = ot;
    const so = $('#st-oil'), rising = oilNow > hud.oil + .5 || (game.net.comps.some(c => c.spd > .05) && oilNow < game.storageCap() - 1);
    if (so.classList.contains('rising') !== rising) so.classList.toggle('rising', rising);
  }
  function refreshHud(snap) {
    const s = game.s, oil = game.oilTotal(), cap = game.storageCap(), pct = cap > 0 ? oil / cap : 0;
    if (snap === 'reset') { hud.cash = hud.lastCash = s.cash; hud.oil = hud.lastOil = oil; hud.pend = hud.oilPend = 0; }
    setText('v-store', Math.round(pct * 100) + '%');
    const st = $('#st-store'); st.classList.toggle('warn', pct > .75 && pct <= .98); st.classList.toggle('full', pct > .98);
    if (s.price !== lastPrice) { priceDir = s.price > lastPrice ? 1 : -1; lastPrice = s.price; }
    const pe = $('#v-price'); const pt = money1(s.price) + ' ' + (priceDir > 0 ? '▲' : priceDir < 0 ? '▼' : '') + ' '; if (pe.firstChild.textContent !== pt) pe.firstChild.textContent = pt;
    const sp = $('#st-price'); sp.classList.toggle('up', priceDir > 0); sp.classList.toggle('down', priceDir < 0);
  }

  /* ================= Market ================= */
  const mk = $('#market');
  let futIdx = 0;
  let spInit = true;                                  // smart default: when the market opens, the sell amount starts at what is free to sell
  function openMarket() { closeModals(); mk.hidden = false; spInit = true; applyTab(); layoutMarket(); if (ui.tab === 'trade') drawChart(); }
  function closeModals() { mk.hidden = true; $('#settings').hidden = true; $('#regions').hidden = true; }
  function layoutMarket() {
    const box = $('#fu-dur');
    if (!box.children.length) {
      CFG.FUT.forEach((o, i) => { const b = document.createElement('button'); b.type = 'button'; b.dataset.i = i; b.textContent = t('m.min', { n: o.sec / 60 }); box.appendChild(b); });
    }
    updateMarket();
  }
  const fmtTime = s => { s = Math.max(0, Math.ceil(s)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
  const ago = at => { const d = Math.max(0, game.s.time - at); return d < 8 ? t('ago.now') : d < 90 ? t('ago.s', { n: Math.floor(d) }) : t('ago.m', { n: Math.floor(d / 60) }); };
  function logText(l) {
    const v = Object.assign({}, l.v);
    if (v.what) v.what = t('n.' + v.what);
    if (v.type) v.type = t('ev.' + v.type);
    if (v.p != null) v.p = money1(v.p);
    return t(l.k, v);
  }

  let spAll = false;                                  // "Sell all" was chosen: sell exactly what is stored when the button is pressed
  const signed = (n, f) => (n >= 0 ? '+' : '−') + f(Math.abs(n));
  function updateMarket() {
    if (mk.hidden) return;
    updateEventStrip();
    if (ui.tab === 'orders') { updateOrders(); return; }
    if (ui.tab === 'comp') { updateComp(); return; }
    // everything below only READS the game state (market / economy / storage views); nothing here is a source of truth
    const s = game.s, M = game.market(), E = game.economy(), S = game.storage();
    const oil = Math.floor(S.inventory), h = s.hist, first = h[0], hi = Math.max(...h), lo = Math.min(...h);
    const chg = (s.price - first) / first * 100, tr = game.priceTrend();
    setText('mk-price', money1(M.currentOilPrice)); $('#mk-price').className = priceDir < 0 ? 'down' : '';
    setText('mk-prev', money1(M.previousOilPrice));
    const iso = s => '⁦' + s + '⁩';   // keeps signs and % next to their digits in right-to-left text
    const de = $('#mk-delta'); setText('mk-delta', iso(signed(M.priceChange, v => '$' + v.toFixed(2)))); de.className = M.priceChange > 0.004 ? 'up' : M.priceChange < -0.004 ? 'dn' : '';
    const te = $('#mk-trend'); setText('mk-trend', t(tr.dir > 0 ? 'm.up' : tr.dir < 0 ? 'm.down' : 'm.flat') + ' ' + iso((tr.pct >= 0 ? '+' : '') + tr.pct.toFixed(1) + '%'));
    te.className = 'badge ' + (tr.dir > 0 ? 'up' : tr.dir < 0 ? 'down' : 'flat');
    const ce = $('#mk-chg'); setText('mk-chg', iso((chg >= 0 ? '+' : '') + chg.toFixed(1) + '%')); ce.className = chg >= 0 ? 'up' : 'dn';
    setText('mk-hi', money1(hi)); setText('mk-lo', money1(lo));
    // economy: stored oil, cash, revenue, operating cost, profit
    setText('ec-oil', iso(num(S.inventory) + ' / ' + num(S.capacity))); setText('ec-cash', money(E.money));
    const pe = $('#ec-profit'); setText('ec-profit', iso(signed(E.profit, money))); pe.className = E.profit >= 0 ? 'up' : 'dn';
    setText('ec-q', '×' + S.quality.toFixed(2)); setText('ec-extra', money(E.maintenance + E.repairs)); setText('ec-capex', money(E.upgrades + E.exploration)); setText('ec-rev', money(E.revenue)); setText('ec-cost', money(E.operatingCosts)); setText('ec-rate', iso(t('m.perMin', { n: money1(E.opexPerMin) })));
    const ow = $('#ec-owed'); ow.hidden = E.owed < 0.5; if (!ow.hidden) setText('ec-owed', t('m.owed', { n: money(E.owed) }));
    // spot sale
    const sr = $('#sp-range'); if (+sr.max !== oil) { sr.max = oil; if (+sr.value > oil) sr.value = oil; }
    if (spAll) sr.value = oil;
    else if (spInit && oil > 0) { sr.value = Math.floor(S.free > 0 ? S.free : oil); spInit = false; }
    const sa = spAll ? S.inventory : +sr.value;
    setText('sp-amt', num(sa) + ' ' + t('bbl')); setText('sp-rev', money(sa * s.price * S.quality)); $('#sp-go').disabled = sa < 0.01;
    $$('#sp-chips button').forEach(b => { const n = b.dataset.n; b.disabled = n !== 'all' && +n > oil; b.classList.toggle('on', n === 'all' ? spAll : !spAll && +sr.value === +n); });
    const sw = $('#sp-warn'), after = S.inventory - sa, bad = S.committed > 0 && sa >= 0.01 && after < S.committed - 1e-9;
    sw.hidden = !bad; if (bad) setText('sp-warn', t('m.warnSell', { n: num(S.committed) }));
    // futures
    const avail = Math.floor(S.free), fr = $('#fu-range'); if (+fr.max !== avail) { const wasZero = +fr.max === 0 && +fr.value === 0; fr.max = avail; if (+fr.value > avail) fr.value = avail; else if (wasZero && avail > 0) fr.value = Math.round(avail / 2); }
    const fa = +fr.value, q = game.contractQuote(fa, futIdx);
    setText('fu-amt', num(fa) + ' ' + t('bbl')); setText('fu-price', money1(q.price)); setText('fu-rev', money(q.revenue));
    const fe = $('#fu-edge'); setText('fu-edge', iso(signed(q.vsSpot, v => v.toFixed(1) + '%'))); fe.className = q.vsSpot >= 0 ? 'up' : 'dn';
    setText('fu-avail', num(avail) + (S.committed > 0 ? ' (' + num(S.committed) + ' ' + t('c.active') + ')' : ''));
    $$('#fu-dur button').forEach(b => {                                     // every duration shows its locked price vs the price today
      const i = +b.dataset.i, qq = game.contractQuote(0, i), txt = t('m.min', { n: CFG.FUT[i].sec / 60 }) + ' · ' + iso(signed(qq.vsSpot, v => v.toFixed(1) + '%'));
      if (b.textContent !== txt) b.textContent = txt;
      b.classList.toggle('on', i === futIdx);
    });
    $('#fu-go').disabled = fa < 1 || s.contracts.length >= CFG.MAX_CONTRACTS;
    // wait: waiting is not free
    setText('wt-val', money(S.inventory * s.price)); setText('wt-cost', iso(t('m.perMin', { n: money1(E.opexPerMin) })));
    setText('al-val', s.alert ? money(s.alert.target) : t('m.off'));
    // contracts (active, then finished)
    const cl = $('#contracts'); let ch = '';
    for (const k of s.contracts) {
      const left = k.end - s.time, pct = clamp((s.time - k.start) / (k.end - k.start), 0, 1) * 100, short = S.inventory < k.amount - 1e-9;
      ch += '<li><div class="top"><span>' + t('m.line', { n: num(k.amount), p: money1(k.price) }) + '</span><span class="st active">' + t('c.active') + '</span></div>' +
        '<div class="top sub"><span>' + t('c.left') + ' <b dir="ltr">' + fmtTime(left) + '</b></span><span>' + t('m.exp', { rev: money(k.amount * k.price) }) + '</span></div>' +
        '<div class="bar"><i style="width:' + pct.toFixed(1) + '%"></i></div>' + (short ? '<div class="warn">' + t('c.short') + '</div>' : '') + '</li>';
    }
    if (!ch) ch = '<li class="none">' + t('m.noContracts') + '</li>';
    if (cl.dataset.h !== ch) { cl.innerHTML = ch; cl.dataset.h = ch; }
    const fl = $('#finished'); let fh = '';
    for (const k of s.done) {
      const ok = k.status === 'completed';
      fh += '<li><div class="top"><span>' + t('m.line', { n: num(k.amount), p: money1(k.price) }) + '</span><span class="st ' + (ok ? 'done' : 'bad') + '">' + t(ok ? 'c.completed' : 'c.expired') + '</span></div>' +
        '<div class="top sub"><span>' + (ok ? '+' + money(k.amount * k.price) : t('c.pen', { n: money(-k.result) })) + '</span>' + (ok ? '<span>' + t('c.vs', { d: iso(signed(k.result, money)) }) + '</span>' : '') + '</div></li>';
    }
    if (!fh) fh = '<li class="none">' + t('m.nothing') + '</li>';
    if (fl.dataset.h !== fh) { fl.innerHTML = fh; fl.dataset.h = fh; }
    // activity
    const al = $('#activity'); let ah = '';
    for (const l of s.log.slice(0, 6)) ah += '<li><span>' + logText(l) + '</span><b class="' + (l.amt > 0 ? 'up' : l.amt < 0 ? 'dn' : '') + '" dir="ltr">' + (l.amt ? (l.amt > 0 ? '+' : '−') + money(Math.abs(l.amt)) : '') + '</b><em>' + ago(l.t) + '</em></li>';
    if (!ah) ah = '<li class="none">' + t('m.nothing') + '</li>';
    if (al.dataset.h !== ah) { al.innerHTML = ah; al.dataset.h = ah; }
  }

  function drawChart() {
    const c = $('#mk-chart'); if (!c || mk.hidden) return;
    const r = c.getBoundingClientRect(); if (!r.width) return;
    c.width = Math.round(r.width * dpr); c.height = Math.round(r.height * dpr);
    const g = c.getContext('2d'); g.setTransform(dpr, 0, 0, dpr, 0, 0);
    const w = r.width, h = r.height, L = 34, B = 20, T = 8, R = 8, pw = w - L - R, ph = h - B - T;
    const d = game.s.hist, lo0 = Math.min(...d), hi0 = Math.max(...d), pad = Math.max(2, (hi0 - lo0) * .15);
    const step = Math.max(2, Math.ceil((hi0 - lo0 + 2 * pad) / 4 / 2) * 2);
    const lo = Math.floor((lo0 - pad) / step) * step, hi = Math.ceil((hi0 + pad) / step) * step;
    const X = i => L + pw * i / (d.length - 1), Y = v => T + ph * (1 - (v - lo) / (hi - lo));
    g.font = '11px Barlow, Cairo, sans-serif'; g.textBaseline = 'middle'; g.textAlign = 'right'; g.direction = 'ltr';
    g.strokeStyle = 'rgba(150,185,220,.16)'; g.lineWidth = 1; g.fillStyle = '#90a7bd';
    for (let v = lo; v <= hi + .01; v += step) { const y = Math.round(Y(v)) + .5; g.beginPath(); g.moveTo(L, y); g.lineTo(w - R, y); g.stroke(); g.fillText(String(v), L - 6, y); }
    g.textAlign = 'center'; g.textBaseline = 'alphabetic';
    for (let m = 0; m <= 4; m++) { const i = d.length - 1 - m * 20; if (i < 0) continue; g.fillText(m ? '−' + m + (prefs.lang === 'ar' ? 'د' : 'm') : t('m.nowShort'), Math.min(Math.max(X(i), 20), w - 18), h - 5); }
    const up = d[d.length - 1] >= d[0], col = up ? '#2fd27a' : '#ff5a4f';
    const gr = g.createLinearGradient(0, T, 0, T + ph); gr.addColorStop(0, up ? 'rgba(47,210,122,.32)' : 'rgba(255,90,79,.32)'); gr.addColorStop(1, 'rgba(0,0,0,0)');
    g.beginPath(); d.forEach((v, i) => i ? g.lineTo(X(i), Y(v)) : g.moveTo(X(i), Y(v)));
    g.lineTo(X(d.length - 1), T + ph); g.lineTo(X(0), T + ph); g.closePath(); g.fillStyle = gr; g.fill();
    g.beginPath(); d.forEach((v, i) => i ? g.lineTo(X(i), Y(v)) : g.moveTo(X(i), Y(v)));
    g.strokeStyle = col; g.lineWidth = 2; g.lineJoin = 'round'; g.stroke();
    const ex = X(d.length - 1), ey = Y(d[d.length - 1]);
    g.fillStyle = col; g.beginPath(); g.arc(ex, ey, 4, 0, 6.2832); g.fill();
    g.strokeStyle = 'rgba(255,255,255,.8)'; g.lineWidth = 1.5; g.stroke();
    const a = game.s.alert; if (a && a.target >= lo && a.target <= hi) { g.setLineDash([5, 4]); g.strokeStyle = '#ffb41f'; g.beginPath(); g.moveTo(L, Y(a.target)); g.lineTo(w - R, Y(a.target)); g.stroke(); g.setLineDash([]); }
  }

  $('#sp-range').addEventListener('input', () => { spAll = false; updateMarket(); });
  $('#fu-range').addEventListener('input', updateMarket);
  $('#sp-chips').addEventListener('click', e => {
    const b = e.target.closest('button'); if (!b || b.disabled) return;
    const r = $('#sp-range');
    if (b.dataset.n === 'all') { spAll = true; r.value = r.max; } else { spAll = false; r.value = Math.min(+b.dataset.n, +r.max); }
    updateMarket();
  });
  $('#fu-dur').addEventListener('click', e => { const b = e.target.closest('button'); if (b) { futIdx = +b.dataset.i; updateMarket(); } });
  $('#sp-go').addEventListener('click', () => {
    const r = game.sell(spAll ? game.oilTotal() : +$('#sp-range').value);
    if (!r.ok) return toast(help(r.reason), 'bad');
    toast(t('t.sold', { n: num(r.amount), rev: money(r.revenue) }), 'good');
    for (const b of game.buildings) if (b.type === 'tank') spawnFx(b.x, b.y, 'sale');
    spAll = false; $('#sp-range').value = 0; spInit = true; updateMarket(); refreshHud(true);
  });
  $('#fu-go').addEventListener('click', () => {
    const r = game.createContract(+$('#fu-range').value, futIdx);
    if (!r.ok) return toast(help(r.reason), 'bad');
    toast(t('t.contract', { rev: money(r.quote.revenue), time: fmtTime(r.quote.sec) }), 'info');
    $('#fu-range').value = 0; updateMarket(); refreshHud(true);
  });
  const alertStep = d => {
    const s = game.s; const cur = s.alert ? s.alert.target : Math.round(s.price);
    game.setAlert(clamp(cur + d, CFG.PRICE.MIN + 1, CFG.PRICE.MAX - 1)); updateMarket(); drawChart();
  };
  $('#al-up').addEventListener('click', () => alertStep(1));
  $('#al-dn').addEventListener('click', () => alertStep(-1));
  $('#al-val').addEventListener('click', () => { game.setAlert(null); updateMarket(); drawChart(); });
  $('#wt-go').addEventListener('click', () => { closeModals(); toast(game.s.alert ? t('t.waiting', { p: money(game.s.alert.target) }) : t('t.waiting0'), 'info'); });

  /* ================= Phase 4: events, supply contracts, companies, regions ================= */
  const biso = s => '⁦' + s + '⁩';
  const evDir = ev => ev.peak > 1.001 ? 'up' : ev.peak < 0.999 ? 'down' : '';
  function showEvent(ev) {                                // a small banner (no pause, no blocking popup)
    const b = $('#evbanner'); if (!ev) return;
    b.className = evDir(ev); b.hidden = false;
    b.innerHTML = '<small>' + t('ev.title') + '</small><b>' + t('evh.' + ev.type) + '</b><span>' + t('ev.price') + ': ' + biso(money1(ev.priceFrom) + ' → ' + money1(ev.priceTo)) + '</span>';
    clearTimeout(showEvent.t); showEvent.t = setTimeout(() => { b.hidden = true; }, 7500);
  }
  $('#evbanner').addEventListener('click', () => { $('#evbanner').hidden = true; ui.tab = 'trade'; openMarket(); });

  function updateEventStrip() {
    const el = $('#mk-event'), ev = game.eventView();
    if (!ev) { if (!el.hidden) { el.hidden = true; el.dataset.h = ''; } return; }
    const h = ev.type + '|' + ev.phase + '|' + Math.ceil(ev.phase === 'active' ? ev.remaining : ev.endsIn) + '|' + prefs.lang + '|' + ev.priceTo;
    el.hidden = false; if (el.dataset.h === h) return; el.dataset.h = h;
    el.className = 'evstrip ' + evDir(ev);
    el.innerHTML = '<span><b>' + t('ev.' + ev.type) + '</b> · ' + t('evh.' + ev.type) + '</span><span>' + t('ev.price') + ' ' + biso(money1(ev.priceFrom) + ' → ' + money1(ev.priceTo)) + ' · ' + (ev.phase === 'active' ? fmtTime(ev.remaining) + ' ' + t('ev.left') : t('ev.fading')) + '</span>';
  }

  function orderCard(o, kind) {
    const s = game.s;
    const head = '<div class="top"><span>' + t('m.line', { n: num(o.requiredOil), p: money1(o.price) }) + '</span><span class="st ' + (kind === 'active' ? 'active' : kind) + '">' + t('os.' + o.status) + '</span></div>';
    const vsHtml = '<span class="vs" data-vs="' + o.price + '"></span>';
    if (o.status === 'AVAILABLE') {
      return '<div class="ocard">' + head + '<dl><dt>' + t('o.reward') + '</dt><dd>' + money(o.reward) + '</dd><dt>' + t('o.time') + '</dt><dd>' + t('o.min', { n: o.duration / 60 }) + '</dd><dt>' + t('o.price') + '</dt><dd>' + vsHtml + '</dd><dt>' + t('o.expires') + '</dt><dd dir="ltr" data-end="' + o.offerEnd + '"></dd></dl>' +
        '<div class="row"><button class="btn green" type="button" data-oact="accept" data-id="' + o.id + '">' + t('o.accept') + '</button></div></div>';
    }
    if (o.status === 'ACTIVE') {
      const p = clamp(o.deliveredOil / o.requiredOil, 0, 1) * 100, free = Math.max(0, game.oilTotal() - game.committed());
      return '<div class="ocard active">' + head + '<div class="bar"><i style="width:' + p.toFixed(1) + '%"></i></div><dl><dt>' + t('o.required') + '</dt><dd>' + num(o.requiredOil) + '</dd><dt>' + t('o.delivered') + '</dt><dd>' + num(o.deliveredOil) + '</dd><dt>' + t('o.remaining') + '</dt><dd>' + num(o.remainingOil) + '</dd><dt>' + t('o.reward') + '</dt><dd>' + money(o.reward) + '</dd><dt>' + t('o.left') + '</dt><dd dir="ltr" data-end="' + o.deadline + '"></dd><dt>' + t('o.price') + '</dt><dd>' + vsHtml + '</dd></dl>' +
        '<div class="row"><button class="btn orange" type="button" data-oact="deliver" data-id="' + o.id + '"' + (free < 1 ? ' disabled' : '') + '>' + t('o.deliver') + '</button><button class="btn ghost" type="button" data-oact="deliver100" data-id="' + o.id + '"' + (free < 100 || o.remainingOil < 1 ? ' disabled' : '') + '>' + t('o.deliver100') + '</button></div></div>';
    }
    const good = o.status === 'COMPLETED';
    return '<div class="ocard ' + (good ? 'done' : 'bad') + '">' + head + '<dl><dt>' + t('o.delivered') + '</dt><dd>' + num(o.deliveredOil) + ' / ' + num(o.requiredOil) + '</dd><dt>' + t('o.reward') + '</dt><dd>' + (good ? '+' + money(o.reward) : o.paid ? '+' + money(o.paid) : '$0') + (o.penalty ? ' · −' + money(o.penalty) : '') + '</dd></dl></div>';
  }
  function updateOrders() {
    const box = $('#od-box'), s = game.s;
    const offers = s.orders.filter(o => o.status === 'AVAILABLE'), active = s.orders.filter(o => o.status === 'ACTIVE');
    const h = '<p class="rgnote">' + t('o.risk') + '</p><div class="sec">' + t('o.active') + '</div><div class="ocards">' + (active.map(o => orderCard(o, 'active')).join('') || '<p class="rgnote">' + t('o.noActive') + '</p>') + '</div>' +
      '<div class="sec">' + t('o.offers') + '</div><div class="ocards">' + (offers.map(o => orderCard(o, 'avail')).join('') || '<p class="rgnote">' + t('o.none') + '</p>') + '</div>' +
      '<div class="sec">' + t('o.history') + '</div><div class="ocards">' + (s.ordersDone.slice(0, 4).map(o => orderCard(o, o.status === 'COMPLETED' ? 'done' : 'bad')).join('') || '<p class="rgnote">' + t('o.noHistory') + '</p>') + '</div>';
    if (box.dataset.h !== h) { box.innerHTML = h; box.dataset.h = h; }
    // live numbers are refreshed in place so the buttons are never rebuilt under a finger
    box.querySelectorAll('[data-end]').forEach(el => { const v = fmtTime(+el.dataset.end - s.time); if (el.textContent !== v) el.textContent = v; });
    box.querySelectorAll('[data-vs]').forEach(el => { const d = (+el.dataset.vs / s.price - 1) * 100, v = t('o.vsSpot', { d: biso((d >= 0 ? '+' : '−') + Math.abs(d).toFixed(1) + '%') }); if (el.textContent !== v) el.textContent = v; el.className = 'vs ' + (d >= 0 ? 'up' : 'dn'); });
  }
  $('#od-box').addEventListener('click', e => {
    const b = e.target.closest('[data-oact]'); if (!b) return;
    const id = +b.dataset.id, a = b.dataset.oact;
    if (a === 'accept') { const r = game.acceptOrder(id); toast(r.ok ? t('t.accepted') : err(r.reason), r.ok ? 'good' : 'bad'); }
    else {
      const r = game.deliverOrder(id, a === 'deliver100' ? 100 : null);
      if (!r.ok) toast(help(r.reason), 'bad'); else toast(r.completed ? t('t.orderDone', { rev: money(r.reward) }) : t('t.delivered2', { n: num(r.amount) }), 'good');
    }
    $('#od-box').dataset.h = ''; updateOrders(); refreshHud(true);
  });

  function updateComp() {
    const box = $('#cp-box'), rows = game.ranking(), eff = game.s.aiMult;
    let h = '<table class="ctable"><thead><tr><th>' + t('c.rank') + '</th><th>' + t('c.company') + '</th><th>' + t('c.share') + '</th><th>' + t('c.prod') + '</th><th>' + t('c.rev') + '</th></tr></thead><tbody>';
    for (const r of rows) {
      const name = r.player ? t('c.me') : t('co.' + r.id) + ' <small class="muted">' + t('sg.' + r.strategy) + '</small>';
      h += '<tr class="' + (r.player ? 'me' : '') + '"><td>' + r.rank + '</td><td>' + name + '</td><td>' + Math.round(r.share * 100) + '%<span class="shbar"><i style="width:' + (r.share * 100).toFixed(1) + '%"></i></span></td><td>' + (r.production).toFixed(1) + '</td><td>' + money(r.revenue) + '</td></tr>';
    }
    h += '</tbody></table><p class="rgnote">' + t('c.metric') + '</p><p class="rgnote">' + t('c.effect') + ': <b dir="ltr">×' + eff.toFixed(3) + '</b></p>';
    if (box.dataset.h !== h) { box.innerHTML = h; box.dataset.h = h; }
  }
  function applyTab() {
    $$('#mtabs button').forEach(b => b.classList.toggle('on', b.dataset.tab === ui.tab));
    $$('[data-pane]').forEach(p => { p.hidden = p.dataset.pane !== ui.tab; });
  }
  $('#mtabs').addEventListener('click', e => { const b = e.target.closest('[data-tab]'); if (!b) return; ui.tab = b.dataset.tab; applyTab(); updateMarket(); if (ui.tab === 'trade') drawChart(); });

  // ----- regions -----
  const rg = $('#regions');
  function openRegions() { closeModals(); rg.hidden = false; $('#rg-list').dataset.h = ''; updateRegions(); }
  function regionCenter(id) { let sx = 0, sy = 0, n = 0; for (const a of game.areas) if (a.region === id && a.land) { sx += a.ax * 4 + 2; sy += a.ay * 4 + 2; n++; } return n ? [sx / n, sy / n] : [CFG.WORLD.OX + 22, CFG.WORLD.OY + 14]; }
  function updateRegions() {
    if (rg.hidden) return;
    let h = '';
    for (let id = 1; id <= CFG.REGIONS.length; id++) {
      const r = game.regionInfo(id), risk = r.riskLevel <= 1.1 ? 'low' : r.riskLevel <= 1.3 ? 'mid' : 'high', cash = game.s.cash;
      h += '<li class="rg ' + r.state + '"><div class="top"><span>' + t('r.' + id) + '</span><span class="st">' + t('rs.' + r.state) + '</span></div><dl>' +
        '<dt>' + t('r.terrain') + '</dt><dd>' + t('tr.' + r.terrain) + '</dd><dt>' + t('r.build') + '</dt><dd dir="ltr">×' + r.constructionMult.toFixed(2) + '</dd>' +
        '<dt>' + t('r.explore') + '</dt><dd>' + money(r.explorationCost) + '</dd><dt>' + t('r.risk') + '</dt><dd>' + t('risk.' + risk) + ' <span dir="ltr">×' + r.riskLevel.toFixed(2) + '</span></dd>' +
        '<dt>' + t('r.potential') + '</dt><dd>' + Math.round(r.oilChance * 100) + '% · ' + r.reservePotential + t('perMinShort') + '</dd><dt>' + t('r.progress') + '</dt><dd>' + r.explored + ' / ' + r.areas + '</dd>' +
        (r.state === 'LOCKED' ? '' : '<dt>' + t('r.wells') + '</dt><dd>' + r.wells + '</dd>') + '</dl>';
      if (r.state === 'LOCKED') h += '<div class="row"><button class="btn orange" type="button" data-ract="unlock" data-id="' + id + '"' + (cash < r.unlockNeed ? ' disabled' : '') + '>' + t('r.unlock', { cost: money(r.unlockCost) }) + '</button></div>' + (cash < r.unlockNeed ? '<div class="need">' + t('r.need', { need: money(r.unlockNeed) }) + '</div>' : '');
      else h += '<div class="row"><button class="btn ghost" type="button" data-ract="go" data-id="' + id + '">' + t('r.go') + '</button></div>';
      h += '</li>';
    }
    const box = $('#rg-list'); if (box.dataset.h !== h) { box.innerHTML = h; box.dataset.h = h; }
  }
  $('#rg-list').addEventListener('click', e => {
    const b = e.target.closest('[data-ract]'); if (!b) return;
    const id = +b.dataset.id;
    if (b.dataset.ract === 'unlock') { const r = game.unlockRegion(id); if (!r.ok) toast(r.reason === 'needCash' ? err('needCash') : err(r.reason), 'bad'); refreshHud(true); updateRegions(); }
    else { const [x, y] = regionCenter(id); cam.x = (x - y) * 32; cam.y = (x + y) * 16; clampCam(); closeModals(); setTool('explore'); }
  });
  const afford = k => k === 'well' ? CFG.WELL_KINDS.small.cost : k === 'explore' ? CFG.REGIONS[0].explore : CFG.COST[k];
  function updateMenuAfford() {                                   // build menu: a tool you cannot pay for is dimmed (DOM touched only when the state flips)
    for (const el of $$('#buildmenu .tool[data-tool]')) {
      const c = afford(el.dataset.tool); if (c == null) continue;
      const poor = game.s.cash < c; if (el.classList.contains('poor') !== poor) { el.classList.toggle('poor', poor); el.title = poor ? t('noCash') : ''; }
    }
  }
  function updateBadges() {
    updateMenuAfford();
    const has = game.s.orders.some(o => o.status === 'AVAILABLE') || !!game.s.event;
    const m = $('#btn-market'); if (m.classList.contains('alerting') !== has) m.classList.toggle('alerting', has);
  }

  $('#mk-close').addEventListener('click', closeModals);
  mk.addEventListener('pointerdown', e => { if (e.target === mk) closeModals(); });
  $('#btn-market').addEventListener('click', openMarket);
  $('#btn-regions').addEventListener('click', openRegions);
  $('#rg-close').addEventListener('click', closeModals);
  $('#st-price').addEventListener('click', openMarket);

  /* ================= Menu ================= */
  const stm = $('#settings');
  const SPEEDS = [1, 2, 0];
  function syncSpeed() { const b = $('#btn-speed'); b.firstElementChild.textContent = ui.speed === 0 ? '❚❚' : ui.speed + '×'; b.classList.toggle('paused', ui.speed === 0); b.classList.toggle('fast', ui.speed === 2); }
  $('#btn-speed').addEventListener('click', () => { ui.speed = SPEEDS[(SPEEDS.indexOf(ui.speed) + 1) % 3]; syncSettings(); toast(ui.speed === 0 ? t('s.paused') : t('s.speedTo', { n: ui.speed }), 'info'); });
  function syncSettings() {
    syncSpeed();
    $$('#speed button').forEach(b => b.classList.toggle('on', +b.dataset.s === ui.speed));
    $$('#langs button').forEach(b => b.classList.toggle('on', b.dataset.l === prefs.lang));
    $$('#confirmopt button').forEach(b => b.classList.toggle('on', (+b.dataset.c === 1) === !!prefs.confirm));
  }
  $('#btn-settings').addEventListener('click', () => { closeModals(); stm.hidden = false; syncSettings(); });
  $('#st-close').addEventListener('click', closeModals);
  stm.addEventListener('pointerdown', e => { if (e.target === stm) closeModals(); });
  $('#speed').addEventListener('click', e => { const b = e.target.closest('button'); if (b) { ui.speed = +b.dataset.s; syncSettings(); } });
  $('#confirmopt').addEventListener('click', e => { const b = e.target.closest('button'); if (b) { prefs.confirm = +b.dataset.c === 1; savePrefs(); syncSettings(); } });
  function setLang(l) {
    prefs.lang = l; savePrefs(); applyI18n();
    $('#fu-dur').innerHTML = ''; if (!mk.hidden) layoutMarket();
    $('#contracts').dataset.h = ''; $('#activity').dataset.h = '';
    renderPanel(); $('#hint').dataset.s = ''; updateHint(); updateConfirm(); syncSettings(); refreshHud(true);
    const r = $('#st-reset'); r.textContent = t('s.reset');
  }
  $('#langs').addEventListener('click', e => { const b = e.target.closest('button'); if (b) setLang(b.dataset.l); });
  $('#st-save').addEventListener('click', () => { save(); toast(t('t.saved'), 'good'); });
  $('#st-reset').addEventListener('click', e => {
    if (!ui.reset) { ui.reset = 1; e.target.textContent = t('s.sure'); setTimeout(() => { ui.reset = 0; e.target.textContent = t('s.reset'); }, 3000); return; }
    try { localStorage.removeItem(SAVE_KEY); } catch (err2) { /* ignore */ }
    game.reset(); ui.sel = null; renderPanel(); setTool('select'); initCamera(); closeModals(); refreshHud('reset'); toast(t('t.new'), 'info');
  });
  const menuT = new Map();                                        // one physical press = one menu action: a repeat on the SAME button within 250 ms is a duplicate; a different button is never blocked
  const menuOk = el => { const n = performance.now(); if (n - (menuT.get(el) || -1e9) < 250) return false; menuT.set(el, n); return true; };
  $('#btn-build').addEventListener('click', e => { if (menuOk(e.currentTarget)) toggleBuild(); });
  $$('.tool[data-tool]').forEach(b => b.addEventListener('click', () => {
    if (!menuOk(b)) return;
    const k = b.dataset.tool; if (k === ui.tool && k !== 'select') return;               // choosing the tool you are already in changes nothing (the preview is kept)
    setTool(k);
  }));
  $$('#kinds button').forEach(b => b.addEventListener('click', () => { ui.wellKind = b.dataset.k; ui.pending = null; applyMenu(); updateConfirm(); updateHint(); }));

  /* ================= Main loop ================= */
  function initCamera() {
    cam.x = (OXY.OX - OXY.OY) * 32; cam.y = 16 * (OXY.OLD_COLS + OXY.OLD_ROWS) / 2 - 30 + (OXY.OX + OXY.OY) * 16;     // the middle of the original map
    cam.z = clamp(vw / 1150, CAM.START_Z[0], CAM.START_Z[1]);
    clampCam();
  }

  let last = performance.now(), uiClock = 0, saveClock = 0, lastTick = -1, ema = 16.7, emaClock = 0;
  let frameErr = 0, coachWas = false;
  function frame(now) {
    try { tick(now); } catch (e) { if (frameErr++ < 3) console.error(e); }   // one bad frame must never stop the game loop
    requestAnimationFrame(frame);
  }
  function tick(now) {
    const raw = (now - last) / 1000, real = Math.min(.25, raw); last = now;
    tNow = now / 1000;
    const ad = ui.speed > 0 ? real * Math.min(ui.speed, 2) : 0;   // animation clock: frozen when paused, capped when fast-forwarding
    if (raw < .2) { ema += (raw * 1000 - ema) * .05; emaClock += raw; if (emaClock > 3) { emaClock = 0; if (ema > 30 && dprCap > 1) { dprCap = Math.max(1, dprCap - .5); resize(); clampCam(); } } }
    if (ui.speed > 0) {
      let left = real * ui.speed;      // sub-step so big speed-ups stay accurate
      while (left > 0) { const d = Math.min(left, 1); game.step(d); left -= d; }
    }
    for (const ev of game.drainEvents()) {
      if (ev.type === 'alert') { toast(t('t.alert', { p: money1(ev.price) }), 'info'); const sp = $('#st-price'); sp.classList.remove('alert'); void sp.offsetWidth; sp.classList.add('alert'); }
      if (ev.type === 'marketEvent') { if (ev.phase === 'start') showEvent(ev.event); else toast(t('ev.over'), 'info'); }
      if (ev.type === 'order' && ev.status === 'AVAILABLE') { const o = game.s.orders.find(q => q.id === ev.id); if (o) toast(t('t.offer', { n: num(o.requiredOil), p: money1(o.price) }), 'info'); }
      if (ev.type === 'order' && ev.status === 'FAILED') toast(t('t.orderFailed'), 'bad');
      if (ev.type === 'region') toast(t('r.opened', { cost: money(CFG.REGIONS[ev.id - 1].unlock) }), 'good');
      if (ev.type === 'leak') { toast(t('t.leak'), 'bad'); spawnFx(ev.k % W, (ev.k / W) | 0, 'pipe'); }
      if (ev.type === 'repaired') { toast(t('t.repaired'), 'good'); spawnFx(ev.k % W, (ev.k / W) | 0, 'repair'); }
      if (ev.type === 'explored') { const ea = game.areas.find(q => q.id === ev.id); if (ea) spawnFx(ea.ax * 4 + 2, ea.ay * 4 + 2, ev.kind === 'empty' ? 'dust' : 'discover'); }
      if (ev.type === 'explored') toast(t('t.explored', { what: ev.kind === 'empty' ? t('a.k.empty') : t('a.k.' + ev.kind) + ' · ' + t('q.' + ev.quality) }), ev.kind === 'empty' ? 'info' : 'good');
      if (ev.type === 'upgrade') {                                            // short, cheap feedback: a pop on the object and a ring
        if (ev.kind === 'pipe') spawnFx(ev.k % W, (ev.k / W) | 0, 'pipe');
        else { const ub = game.buildings.find(q => q.id === ev.id); if (ub) { anim.born.set('b' + ub.id, tNow - .22); spawnFx(ub.x, ub.y, ub.type); } }
      }
      if (ev.type === 'contract') toast(ev.status === 'expired' ? t('t.expired', { pen: money(ev.penalty) }) : t('t.delivered', { rev: money(ev.revenue) }), ev.status === 'expired' ? 'bad' : 'good');
    }
    if (keys.size) {
      camGoal.on = false;
      const sp = 700 * real / cam.z;
      if (keys.has('arrowleft') || keys.has('a')) cam.x -= sp;
      if (keys.has('arrowright') || keys.has('d')) cam.x += sp;
      if (keys.has('arrowup') || keys.has('w')) cam.y -= sp;
      if (keys.has('arrowdown') || keys.has('s')) cam.y += sp;
      clampCam();
    }
    stepCamera(real); stepPlacing(real); updateAnim(real, ad); hudFrame(real);
    uiClock += real; saveClock += real;
    if (uiClock > .2) {
      uiClock = 0; refreshHud(); updatePanel(); updateMarket(); updateRegions(); updateBadges(); updateCoach(); updateHint();
      if (coachWas && game.s.tutorialDone) { toast(t('co.done'), 'good'); save(); }
      coachWas = !game.s.tutorialDone;
      const tick = Math.floor(game.s.time / CFG.PRICE_TICK);
      if (!mk.hidden && tick !== lastTick) { lastTick = tick; drawChart(); }
      if (ui.pending) updateConfirm();
      drawMini(); updateDebug();
    }
    if (saveClock > 5) { saveClock = 0; save(); }
    render();
  }

  /* ================= Boot ================= */
  addEventListener('resize', () => { resize(); clampCam(); });
  if (window.ResizeObserver) { let rw = 0, rh = 0; new ResizeObserver(() => { const r = cv.getBoundingClientRect(); if (Math.abs(r.width - rw) < .5 && Math.abs(r.height - rh) < .5) return; rw = r.width; rh = r.height; if (Math.abs(r.width - vw) > .5 || Math.abs(r.height - vh) > .5) { resize(); clampCam(); } }).observe(cv); }   // WebView layout changes that fire no window resize
  addEventListener('beforeunload', save);
  document.addEventListener('visibilitychange', () => { if (document.hidden) { resetGestures(); save(); } else last = performance.now(); });
  buildTerrain();
  applyArt(); applyI18n(); syncSettings();
  resize();
  if (!loaded) initCamera(); else clampCam();
  setTool('select');
  if (!game.buildings.length) { ui.menu = true; applyMenu(); updateHint(); }   // first run: show the build menu
  refreshHud('reset');
  drawMini();
  toast(loaded ? t('t.back') : t('t.welcome'), 'info');
  requestAnimationFrame(frame);

  // small hook for debugging and automated tests
  window.__oli = { select, renderPanel, updatePanel, game, ui, cam, prefs, anim, hud, onTap, setTool, cellAt, openMarket, openRegions, closeModals, setLang, t, coach, camGoal, getSpots, focusOn, backStep, leaveBuild, gridToWorld, worldToGrid, footprintCenter, cc, pickBuilding, pumpDirFor, help, updateMenuAfford, gOff, pd, inputMode, resetGestures, ptrs, clampCam, s2w, w2s, fitView, focusSel, CAM, BOX, zoomLimits, drawMini, camGoal, stepCamera, pill: () => pill, setDebug, updateDebug };
})();
