      'p.resP': 'Reservoir pressure', 'p.whP': 'Well head pressure', 'p.pumpHelp': 'Pump support', 'p.limit': 'Limiting factor', 'lim.capacity': 'Pipe capacity', 'lim.pressure': 'Not enough pressure', 'lim.none': 'None',
